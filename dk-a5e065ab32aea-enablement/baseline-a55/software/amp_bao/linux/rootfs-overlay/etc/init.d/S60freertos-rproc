#!/bin/sh
#
# S60freertos-rproc - Attach the Bao inter-VM remoteproc.
#
# The bao_rproc driver registers remoteproc0 in RPROC_DETACHED state and
# requires an explicit sysfs write to trigger the OpenAMP attach flow.
# After attach, the kernel creates /dev/rpmsg0 which carries:
#   - FreeRTOS heartbeat lines  (from main_rpmsg_console.c)
#   - ILC latency summary lines (from ilc_latency.c)

RPROC_STATE=/sys/class/remoteproc/remoteproc0/state

start() {
    printf "Attaching FreeRTOS remoteproc: "

    # Wait up to 5 s for the rproc sysfs node (driver probe is async).
    i=0
    while [ $i -lt 5 ] && [ ! -f "$RPROC_STATE" ]; do
        sleep 1
        i=$((i + 1))
    done

    if [ ! -f "$RPROC_STATE" ]; then
        echo "FAIL (rproc sysfs not found)"
        return 1
    fi

    # "start" calls rproc_boot() which internally calls rproc_attach() for
    # RPROC_DETACHED devices (kernel >= 5.10). This kernel's sysfs does not
    # expose an "attach" option — only "start", "stop", "detach".
    echo start > "$RPROC_STATE" 2>/dev/null

    # Wait up to 5 s for /dev/rpmsg0 to appear after the attach.
    i=0
    while [ $i -lt 5 ] && [ ! -c /dev/rpmsg0 ]; do
        sleep 1
        i=$((i + 1))
    done

    if [ ! -c /dev/rpmsg0 ]; then
        echo "WARN: /dev/rpmsg0 not ready after attach (FreeRTOS may still be initialising)"
    else
        echo "OK (/dev/rpmsg0 ready)"
    fi
}

stop() {
    if [ -f "$RPROC_STATE" ]; then
        echo detach > "$RPROC_STATE" 2>/dev/null || true
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    *)       echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
