diff --git a/src/platform/agilex5/platform.mk b/src/platform/agilex5/platform.mk
new file mode 100644
index 0000000..5d4965a
--- /dev/null
+++ b/src/platform/agilex5/platform.mk
@@ -0,0 +1,33 @@
+## SPDX-License-Identifier: Apache-2.0
+## Copyright (c) Bao Project and Contributors. All rights reserved.
+
+# Architecture definition
+ARCH:=armv8
+# CPU definition - use cortex-a55 as base (the little cores)
+# cortex-a76 is the big core but gcc doesn't need separate tuning here
+CPU:=cortex-a55
+
+GIC_VERSION:=GICV3
+
+# Agilex5 ships a non-secure ARM SMMUv3 in the DMA path of every HPS
+# peripheral (SDMMC stream ID 5, Ethernet stream IDs 8/9, ...).
+# Bao's SMMUv3 driver is enabled here to provide Stage-2 translation and
+# the Inner-Shareable override required for cache-coherent DMA.
+
+SMMU_VERSION:=3
+#SMMU_VERSION:=2
+
+# Board DDR capacity in GiB. Drives the mem_region table in agilex5_desc.c,
+# which stays common across all Agilex5 boards. Supported: 1, 2, 4, 8.
+# Override per board from configs/<CONFIG>/config.mk or the make command line
+# (the orchestrator forwards AGX5_MEM_GB to this sub-make).
+AGX5_MEM_GB ?= 2
+
+drivers = 8250_uart
+
+platform_description:=agilex5_desc.c
+
+platform-cppflags = -DAGX5_MEM_GB=$(AGX5_MEM_GB)
+platform-cflags = -mtune=$(CPU)
+platform-asflags =
+platform-ldflags =
