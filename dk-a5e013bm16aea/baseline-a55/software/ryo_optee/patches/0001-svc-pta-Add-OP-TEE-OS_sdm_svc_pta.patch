diff --git a/optee_os/lib/libutee/include/pta_sdm_svc.h b/optee_os/lib/libutee/include/pta_sdm_svc.h
new file mode 100644
index 000000000000..b4f781a65331
--- /dev/null
+++ b/optee_os/lib/libutee/include/pta_sdm_svc.h
@@ -0,0 +1,977 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2024, Intel Corporation
+ *
+ * OP-TEE Pseudo-TA interface for SDM (Secure Device Manager) services.
+ *
+ * Provides a secure enclave for accessing Intel SDM functions via ATF SiP
+ * SMC services.  All SDM operations pass through this PTA to enforce access
+ * control at the OP-TEE boundary.
+ */
+
+#ifndef __PTA_SDM_SVC_H
+#define __PTA_SDM_SVC_H
+
+/*
+ * UUID: b68b0d3b-5ef5-4f4e-ac23-00005ed30065
+ * (last two bytes of node encode the initial SiP function ID 0x0065)
+ */
+#define PTA_SDM_SVC_UUID \
+	{ 0xb68b0d3b, 0x5ef5, 0x4f4e, \
+	  { 0xac, 0x23, 0x00, 0x00, 0x5e, 0xd3, 0x00, 0x65 } }
+
+/* Current PTA API version — increment when commands are added or changed */
+#define PTA_SDM_SVC_API_VERSION		20
+
+/*
+ * SDM eFuse phase-2 finalization status codes (PUBKEY_PROGRAM_PHASE2).
+ *
+ * After PTA_CMD_SDM_PROG_PUBKEY and PTA_CMD_SDM_DISABLE_OWNED_ENTRY receive
+ * a successful response from the SDM, the PTA holds 1 second and then issues
+ * the ATF SiP service
+ *   ALTERA_SIP_SMC_ASYNC_SECURE_EFUSE_PUBKEY_PROGRAM_PHASE2 (0x42000178)
+ * to finalize the eFuse programming.	Whether the SDM triggers a Soft POR
+ * (physical / NON-VOLATILE fusing) or treats the call as a no-op (virtual /
+ * cache-only fusing) is reported back via a new VALUE_OUTPUT param:
+ *
+ *   SUCCESS  - Phase-2 accepted; Soft POR will be triggered by the SDM.
+ *		 This is what the host normally sees for NON-VOLATILE
+ *		 programming; the device may reset shortly after.
+ *   NOP      - Phase-2 accepted but Soft POR was suppressed because the
+ *		 previous command targeted virtual / cached fuses only.
+ *   SKIPPED  - Phase-2 was not invoked (the SDM rejected the preceding
+ *		 command, so finalization was not attempted).
+ *   FAILED   - Phase-2 was attempted but the SMC submit or poll failed;
+ *		 eFuse state is indeterminate, inspect IMSG/EMSG logs.
+ */
+#define SDM_PHASE2_STATUS_SUCCESS	0U
+#define SDM_PHASE2_STATUS_NOP		1U
+#define SDM_PHASE2_STATUS_SKIPPED	2U
+#define SDM_PHASE2_STATUS_FAILED	3U
+
+/*
+ * PTA_CMD_GET_VERSION - Query the PTA API version
+ *
+ * param[0] (out value) .a = PTA_SDM_SVC_API_VERSION
+ * param[1..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS always
+ */
+#define PTA_CMD_GET_VERSION		0x0
+
+/*
+ * PTA_CMD_SDM_GET_ID_CODE - Read the JTAG ID code
+ *
+ * Calls ATF SiP service ALTERA_SIP_SMC_ASYNC_GET_IDCODE (0x420000D3).
+ *
+ * param[0] (out value) .a = jtag_idcode
+ * param[1..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	    - chip ID read successfully
+ *   TEE_ERROR_GENERIC	    - ATF returned a non-zero status
+ */
+ #define PTA_CMD_SDM_GET_ID_CODE		0x1
+
+/*
+ * PTA_CMD_SDM_GET_CHIP_ID - Read the SDM/HPS chip ID
+ *
+ * Calls ATF SiP service INTEL_SIP_SMC_FCS_CHIP_ID (0xC2000065).
+ *
+ * param[0] (out value) .a = chip_id[31:0], .b = chip_id[63:32]
+ * param[1..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	    - chip ID read successfully
+ *   TEE_ERROR_GENERIC	    - ATF returned a non-zero status
+ */
+#define PTA_CMD_SDM_GET_CHIP_ID		0x2
+
+/*
+ * PTA_CMD_SDM_SDOS_CRYPT - SDOS encrypt or decrypt a data buffer
+ *
+ * Calls ATF SiP async services:
+ *   ALTERA_SIP_SMC_ASYNC_FCS_OPEN_CS_SESSION	(0x4200013A)
+ *   ALTERA_SIP_SMC_ASYNC_FCS_CRYPTION_EXT	(0x4200012F)
+ *   ALTERA_SIP_SMC_ASYNC_FCS_CLOSE_CS_SESSION (0x4200013B)
+ *
+ * The caller is responsible for constructing the SDOS-formatted input buffer
+ * using the sdos_hdr structure and helper macros defined below.
+ *
+ * param[0] (in value)
+ *   .a = direction: PTA_SDM_SVC_CRYPT_ENCRYPT (1) or PTA_SDM_SVC_CRYPT_DECRYPT (0)
+ *   .b = SDM_BE_ARADDR_REMAP value; smmu_addr = phys - .b:
+ *	   0x80000000 — U-Boot: SMMU disabled, remap adder active (after fpga load)
+ *	   0x00000000 — Linux:	HPS SMMU enabled, SMMU translates IOVA=phys → PA
+ * param[1] (in memref)
+ *   Encrypt: fully-constructed SDOS input buffer:
+ *	[struct sdos_hdr (40 bytes)] [plaintext] [padding (SDOS_PAD_LEN bytes)]
+ *	Total size = SDOS_HDR_SIZE + plaintext_len + SDOS_PAD_LEN(plaintext_len)
+ *   Decrypt: complete SDOS blob from a previous encryption:
+ *	[struct sdos_hdr (40 bytes)] [ciphertext + padding] [HMAC (48 bytes)]
+ * param[2] (out memref)
+ *   Output buffer, pre-allocated by caller.
+ *   Minimum size:
+ *	Encrypt: SDOS_HDR_SIZE + plaintext_len + SDOS_PAD_LEN(plaintext_len) + SDOS_HMAC_SIZE
+ *	Decrypt: same size as the encrypt input (sdos_hdr + plaintext + padding)
+ *   On return, memref.size is updated to the actual number of bytes written.
+ * param[3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	    - operation completed; param[2].memref.size = output bytes
+ *   TEE_ERROR_GENERIC	    - SDM or ATF returned an error
+ *   TEE_ERROR_BUSY	    - SDM poll timed out
+ *   TEE_ERROR_BAD_PARAMETERS - bad param types or null buffers
+ */
+#define PTA_CMD_SDM_SDOS_CRYPT		0x3
+
+/*
+ * PTA_CMD_SDM_GET_RANDOM - Retrieve random bytes from the SDM hardware RNG
+ *
+ * Calls ATF SiP async services:
+ *   ALTERA_SIP_SMC_ASYNC_FCS_OPEN_CS_SESSION	  (0x4200013A)
+ *   ALTERA_SIP_SMC_ASYNC_FCS_RANDOM_NUMBER_EXT  (0x4200012D)
+ *   ALTERA_SIP_SMC_ASYNC_FCS_CLOSE_CS_SESSION	  (0x4200013B)
+ *
+ * The SDM RNG output is captured in a TZDRAM bounce buffer inside the PTA
+ * (secure world), then copied to the caller's normal-world output buffer.
+ * The random data never touches NS DRAM until the PTA has validated the
+ * completed SDM response.
+ *
+ * param[0] (in value)
+ *   .a = requested byte count; must be 4-byte aligned, SDM_RNG_MIN_BYTES..SDM_RNG_MAX_BYTES
+ * param[1] (out memref)
+ *   Output buffer, pre-allocated by caller; must be >= param[0].value.a bytes.
+ *   On return, memref.size = actual bytes written (equals the requested count).
+ * param[2..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	       - random bytes written to param[1] buffer
+ *   TEE_ERROR_GENERIC	       - ATF or SDM returned an error
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ *   TEE_ERROR_OUT_OF_MEMORY  - TZDRAM bounce buffer allocation failed
+ *   TEE_ERROR_BAD_PARAMETERS - bad param types, zero/unaligned/out-of-range
+ *				 size, or output buffer smaller than requested
+ */
+#define PTA_CMD_SDM_GET_RANDOM		0x4
+
+/* Byte count constraints for PTA_CMD_SDM_GET_RANDOM */
+#define SDM_RNG_MIN_BYTES		4U     /* minimum: 1 word, 4-byte aligned */
+#define SDM_RNG_MAX_BYTES		4080U  /* 1020 words (FCS_RANDOM_EXT_MAX_WORD_SIZE * 4) */
+
+/*
+ * PTA_CMD_SDM_SEND_CERT - Authenticate a certificate with the SDM
+ *
+ * Calls ATF SiP async service:
+ *   ALTERA_SIP_SMC_ASYNC_FCS_SEND_CERTIFICATE (0x42000131)
+ *
+ * The certificate is copied into a TZDRAM bounce buffer by the PTA before
+ * being passed to the SDM via ATF.  A 4-byte zero-valued header word is
+ * prepended to the certificate data as required by the SDM mailbox protocol
+ * (MBOX_CMD_VAB_SRC_CERT).
+ *
+ * param[0] (in memref)
+ *   Raw certificate binary; must be 4-byte aligned in size; max SDM_CERT_MAX_SIZE.
+ * param[1] (out value)
+ *   .a = SDM mailbox error code: 0 = certificate accepted, non-zero = rejected
+ *   .b = SDM response detail word (valid when .a is non-zero; aids diagnosis)
+ * param[2..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SDM processed the certificate; check param[1].a
+ *				 for the authentication result (0=pass, else fail)
+ *   TEE_ERROR_GENERIC	       - ATF rejected the SMC call
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ *   TEE_ERROR_OUT_OF_MEMORY  - TZDRAM bounce buffer allocation failed
+ *   TEE_ERROR_BAD_PARAMETERS - null/oversized/unaligned certificate
+ */
+#define PTA_CMD_SDM_SEND_CERT		0x5
+
+/* Maximum certificate size accepted by PTA_CMD_SDM_SEND_CERT */
+#define SDM_CERT_MAX_SIZE		4096U  /* 4 KB */
+
+/*
+ * Certificate header layout (struct fcs_hps_vab_certificate_header in ATF's
+ * socfpga_vab.h), byte offsets from the start of the certificate blob:
+ *
+ *   0x00  magic (SDM_CERT_MAGIC_NUM)
+ *   0x04  cert_data_sz
+ *   0x08  cert_ver
+ *   0x0C  cert_type
+ *   0x18  counter type in bits[7:0]; for an explicit KEY-ID cancel,
+ *	   bits[15:8] select the key owner (0 = user, 1 = Intel)
+ *   0x1C  key ID, or owner root-hash slot number
+ *
+ * Only a key-cancellation certificate changes fuse state in a way that needs
+ * the phase-2 finalize, so cmd_sdm_send_cert classifies the blob before
+ * deciding whether to issue it:
+ *
+ *   cert_type 0x0B  -> cancellation (SDOS / service root key)
+ *   cert_type 0x0D  -> cancellation (user AES root key)
+ *   cert_type 0x05  -> depends on the counter type at 0x18 bits[7:0]:
+ *			  0	 = explicit KEY-ID cancel	 -> cancellation
+ *			  255	 = cancel owner root-hash slot	 -> cancellation
+ *			  1..6	 = counter update		 -> NOT a cancellation
+ *   anything else   -> NOT a cancellation
+ */
+#define SDM_CERT_MAGIC_NUM		0x25D04E7FU
+#define SDM_CERT_MIN_HDR_BYTES		0x20U
+
+#define SDM_CERT_OFF_MAGIC		0x00U
+#define SDM_CERT_OFF_TYPE		0x0CU
+#define SDM_CERT_OFF_COUNTER		0x18U
+#define SDM_CERT_OFF_ID			0x1CU
+
+#define SDM_CERT_TYPE_CANCEL_SDOS_ROOT	0x0BU	/* SDOS / service root key */
+#define SDM_CERT_TYPE_CANCEL_AES_ROOT	0x0DU	/* user AES root key */
+#define SDM_CERT_TYPE_COUNTER		0x05U	/* counter update or KEY-ID cancel */
+
+#define SDM_CERT_COUNTER_TYPE_MASK	0xFFU
+#define SDM_CERT_COUNTER_KEYID_CANCEL	0U	/* explicit KEY-ID cancel */
+#define SDM_CERT_COUNTER_ROOT_HASH_CANCEL 255U	/* cancel owner root-hash slot */
+#define SDM_CERT_KEY_OWNER_SHIFT	8U
+#define SDM_CERT_KEY_OWNER_MASK		0xFFU
+
+/*
+ * PTA_CMD_SDM_GET_PROV_DATA - Retrieve provisioning data from the SDM
+ *
+ * Calls ATF async service ALTERA_SIP_SMC_ASYNC_FCS_GET_PROVISION_DATA
+ * (0x42000132).  The SDM writes a variable-length provisioning data blob to a
+ * TZDRAM bounce buffer; the PTA copies the actual bytes to the caller's output
+ * buffer and updates param[0].memref.size with the actual byte count.
+ *
+ * The response size depends on the number of provisioned owner root hashes N,
+ * encoded in bits [15:8] of the third response word (cosign_info):
+ *   N		 = ((cosign_info >> 8) & 0xFF) + 1
+ *   actual_bytes = (3 + N * 13 + 6) * 4
+ * For secp384r1 (type 2) hashes: 88 bytes (N=1) to 452 bytes (N=8).
+ *
+ * param[0] (out memref) output buffer; must be >= SDM_PROV_DATA_MAX_SIZE.
+ *			  On success: memref.size updated to actual byte count.
+ * param[1..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	      - provisioning data retrieved; check memref.size
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types
+ *   TEE_ERROR_SHORT_BUFFER  - param[0] buffer < SDM_PROV_DATA_MAX_SIZE
+ *   TEE_ERROR_GENERIC	      - ATF or SDM returned an error, or parsed size
+ *				exceeds SDM_PROV_DATA_MAX_SIZE
+ *   TEE_ERROR_BUSY	      - SDM poll timed out
+ */
+#define PTA_CMD_SDM_GET_PROV_DATA	0x6
+
+/*
+ * SDM provisioning data buffer sizing.
+ *
+ * The response is variable-length: 3 fixed header words + N*(12 hash words +
+ * 1 cancel word) + 6 fixed tail words, where N is the number of provisioned
+ * owner root hashes (1..SDM_PROV_MAX_HASHES).
+ *
+ * Callers must allocate SDM_PROV_DATA_MAX_SIZE bytes; the PTA returns the
+ * actual byte count in param[0].memref.size after a successful call.
+ */
+#define SDM_PROV_MAX_HASHES		8U	/* max owner root hash slots */
+#define SDM_PROV_HASH_WORDS		12U	/* secp384r1: 384 bits = 12 uint32_t */
+/* (3 header + SDM_PROV_MAX_HASHES*13 + 6 tail) words * 4, rounded to 512 */
+#define SDM_PROV_DATA_MAX_SIZE		512U
+
+/* Extract number of provisioned hashes from cosign_info word (word index 2).
+ * The field encodes (count - 1); add 1 for the actual hash count.
+ */
+#define SDM_PROV_HASH_COUNT(cosign)	((((cosign) >> 8) & 0xFFU) + 1U)
+/* Extract hash algorithm type from cosign_info; 2 = secp384r1 */
+#define SDM_PROV_HASH_TYPE(cosign)	((cosign) & 0xFFU)
+
+/*
+ * PTA_CMD_SDM_READ_USER_FUSES - Read all 16 user-defined eFuse words
+ *
+ * Calls ATF SiP async service ALTERA_SIP_SMC_ASYNC_GEN_MBOX_CMD (0x420000EE)
+ * with SDM mailbox command efuse_read_user_defined_fuses (0x2D).
+ * Always reads all 16 words starting at word 0.
+ *
+ * param[0] (out memref) output buffer; must be >= SDM_USER_FUSE_SIZE (64 bytes).
+ *			  On success, filled with 16 × uint32_t user fuse values.
+ * param[1..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	      - 16 fuse words written to param[0]
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types
+ *   TEE_ERROR_SHORT_BUFFER  - param[0] buffer too small
+ *   TEE_ERROR_GENERIC	      - ATF or SDM returned an error
+ *   TEE_ERROR_BUSY	      - SDM poll timed out
+ *   TEE_ERROR_OUT_OF_MEMORY - TZDRAM bounce buffer allocation failed
+ */
+#define PTA_CMD_SDM_READ_USER_FUSES	0x7
+
+/*
+ * PTA_CMD_SDM_PROG_USER_FUSES - Program all 16 user-defined eFuse words
+ *
+ * Calls ATF SiP async service ALTERA_SIP_SMC_ASYNC_GEN_MBOX_CMD (0x420000EE)
+ * with SDM mailbox command efuse_user_defined_fuses_program (0x2C).  Always
+ * programs all 16 words starting at word 0.
+ *
+ * The host controls whether the SDM "test" flag (bit 31 of the program
+ * control word) is set, via SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE in
+ * param[1].value.a:
+ *
+ *   flag CLEAR (default)		      test=1 → virtual / cached state
+ *					       only; no physical eFuse is
+ *					       burned.	Reversible.
+ *   SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE   test=0 → SDM permanently burns
+ *					       the 16 user-fuse words into the
+ *					       physical eFuse.	*** UNRECOVERABLE.
+ *					       Once written, those fuse bits
+ *					       CANNOT be erased or changed. ***
+ *
+ * The PTA emits an EMSG audit line on every NON_VOLATILE invocation so the
+ * secure-world log records every irreversible programming attempt.
+ *
+ * SDM mailbox program payload (72 bytes), built in a TZDRAM bounce buffer:
+ *   word 0	 : SDM_EFUSE_PROG_MAGIC ("User" — 0x55736572)
+ *   word 1	 : SDM_EFUSE_PROG_CTRL_WORD	  (test=1, 16 words, start=0) or
+ *		   SDM_EFUSE_PROG_CTRL_WORD_BURN  (test=0, 16 words, start=0)
+ *   words 2..17: 16 × uint32_t caller fuse values
+ *
+ * param[0] (in memref)   caller fuse data; must be exactly SDM_USER_FUSE_SIZE
+ *			   (64 bytes) — 16 × uint32_t.
+ * param[1] (in value)	   .a = host_flags
+ *				 (SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE only)
+ *			   .b = reserved (must be 0)
+ * param[2..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	      - SDM accepted the program command
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types / size / unknown host_flags
+ *				 / reserved field non-zero
+ *   TEE_ERROR_GENERIC	      - ATF or SDM returned an error
+ *   TEE_ERROR_BUSY	      - SDM poll timed out
+ *   TEE_ERROR_OUT_OF_MEMORY - TZDRAM bounce buffer allocation failed
+ */
+#define PTA_CMD_SDM_PROG_USER_FUSES	0x8
+
+/* Number of 32-bit user eFuse words (fixed; always operate on all 16) */
+#define SDM_USER_FUSE_COUNT		16U
+/* Total byte size of all user fuse data */
+#define SDM_USER_FUSE_SIZE		(SDM_USER_FUSE_COUNT * 4U)	/* 64 bytes */
+
+/* SDM mailbox command codes for user-defined eFuse operations */
+#define SDM_EFUSE_READ_CMD		0x2DU	/* efuse_read_user_defined_fuses */
+#define SDM_EFUSE_PROG_CMD		0x2CU	/* efuse_user_defined_fuses_program */
+
+/* Command payload size for the read operation (1 word: num_words and start_word) */
+#define SDM_EFUSE_READ_PAYLOAD_SIZE	4U
+/*
+ * Command payload size for the program operation:
+ *   word 0: magic (SDM_EFUSE_PROG_MAGIC)
+ *   word 1: control word (SDM_EFUSE_PROG_CTRL_WORD)
+ *   words 2-17: 16 data words
+ *   Total: 18 × 4 = 72 = 0x48 bytes
+ */
+#define SDM_EFUSE_PROG_PAYLOAD_SIZE	72U	/* 0x48 */
+/* Response buffer size (large enough for SDM reply) */
+#define SDM_EFUSE_RESP_BUF_SIZE		0x400U	/* 1 KiB */
+
+/*
+ * Read command payload word: [15:8]=0x10 (16 words), [7:0]=0x00 (start word 0)
+ */
+#define SDM_EFUSE_READ_CMD_WORD		0x00001000U
+
+/* Magic number required in program payload word 0 ("User" in ASCII) */
+#define SDM_EFUSE_PROG_MAGIC		0x55736572U
+
+/*
+ * PTA_CMD_SDM_PROG_PUBKEY - Program an owner-root public-key hash into the SDM
+ *
+ * Calls ATF SiP async service ALTERA_SIP_SMC_ASYNC_FCS_PROGRAM_OWNER_PUBKEY
+ * (0x4200016D).  The PTA constructs a TZDRAM bounce buffer in the SDM mailbox
+ * payload format (2 reserved/header words followed by the hash data) and
+ * submits it to the SDM via ATF.
+ *
+ * The hash type is selected from the input size:
+ *
+ *   memref.size = SDM_PUBKEY_HASH_SIZE_SHA256 (32)  → SECP256R1 / SHA-256,
+ *				 single hash only.
+ *   memref.size = k * SDM_PUBKEY_HASH_SIZE_SHA384, for
+ *		   1 <= k <= SDM_PUBKEY_MAX_HASHES_PER_CALL (5)
+ *				→ SECP384R1 / SHA-384, k hashes packed
+ *				  contiguously (batch programming, one SMC
+ *				  call, one mailbox EFUSE_PUBKEY_PROGRAM
+ *				  command for all k hashes).
+ *
+ * Any other input size is rejected with TEE_ERROR_BAD_PARAMETERS.
+ *
+ * The host controls whether the SDM "test/cache-only" flag (T = bit[31] of
+ * the SMC flags word) is set, via SDM_PUBKEY_HOST_FLAG_NON_VOLATILE in
+ * param[1].value.a:
+ *
+ *   flag CLEAR (default)     T=1 → SDM updates virtual/cached state only;
+ *				     no physical eFuse is burned.  Reversible.
+ *   SDM_PUBKEY_HOST_FLAG_NON_VOLATILE	  T=0 → SDM permanently programs the
+ *				     owner-root key hash into the physical
+ *				     eFuse.  *** UNRECOVERABLE — once written
+ *				     this hash CANNOT be erased or changed. ***
+ *
+ * The PTA emits an EMSG / WMSG when the non-volatile flag is supplied so
+ * that audit logs record every irreversible programming attempt.
+ *
+ * SMC ABI (per Intel ATF SiP spec):
+ *   x0 = ALTERA_SIP_SMC_ASYNC_FCS_PROGRAM_OWNER_PUBKEY (0x4200016D)
+ *   x1 = request header / trans_id (0)
+ *   x2 = flags word:
+ *	     bit[31]   = T (test/cache-only)	    — PTA sets per host request
+ *	     bit[30]   = S (skip cancel, dev only)  — PTA forces 0
+ *	     bits[1:0] = hash_type		    — PTA picks per input size:
+ *			  1 = secp256r1 (32-byte hash, single only)
+ *			  2 = secp384r1 (48-byte hash, 1..5 batched)
+ *   x3 = phys addr of payload buffer
+ *   x4 = total payload length in 32-bit WORDS, header included
+ *	     (SDM_PUBKEY_WORD_BYTES-based; NOT bytes):
+ *	     10 for secp256r1 (2 hdr + 8 hash words)
+ *	     2 + 12*k for k secp384r1 hashes (k = 1..5)
+ *
+ * Payload buffer layout:
+ *   word[0..1]    reserved/header words (zero-filled by the PTA)
+ *   word[2..N-1]  N hash words from the caller MEMREF_INPUT, concatenated
+ *		      N = 8	  for SECP256R1 (32 bytes, single hash)
+ *		      N = 12*k  for k SECP384R1 hashes (48*k bytes)
+ *
+ * SMC poll response (after async completion):
+ *   a1 = SDM response status word
+ *   a2 = SMC response header word
+ *   These are forwarded verbatim to the caller in param[2].
+ *
+ * Phase-2 finalization
+ * --------------------
+ * When the SDM accepts the owner-root key hash (param[2].value.a == 0), the
+ * PTA waits 1 second and then issues the ATF SiP service
+ *   ALTERA_SIP_SMC_ASYNC_SECURE_EFUSE_PUBKEY_PROGRAM_PHASE2 (0x42000178)
+ * to finalize the programming.  For SDM_PUBKEY_HOST_FLAG_NON_VOLATILE the
+ * SDM triggers a Soft POR after phase-2; for the default (virtual / cache-
+ * only) it returns without resetting.	 The outcome is surfaced to the
+ * caller through the new VALUE_OUTPUT param[3] (see SDM_PHASE2_STATUS_*).
+ * If the SDM rejects the prior owner-root program (param[2].value.a != 0)
+ * the PTA leaves phase-2 unattempted and reports SDM_PHASE2_STATUS_SKIPPED.
+ *
+ * param[0] (in memref)  Either SDM_PUBKEY_HASH_SIZE_SHA256 (32) bytes
+ *			  (single SECP256R1 hash), or k *
+ *			  SDM_PUBKEY_HASH_SIZE_SHA384 bytes for
+ *			  1 <= k <= SDM_PUBKEY_MAX_HASHES_PER_CALL contiguous
+ *			  SECP384R1 hashes.  Any other size is rejected.
+ * param[1] (in value)
+ *   .a = host control flags (currently only SDM_PUBKEY_HOST_FLAG_NON_VOLATILE).
+ *	   Any unknown bit causes TEE_ERROR_BAD_PARAMETERS so we never silently
+ *	   forward a flag the PTA doesn't understand.
+ *   .b = unused (must be 0)
+ * param[2] (out value)
+ *   .a = SDM response status (0 = accepted, non-zero = SDM error)
+ *   .b = SMC response header word
+ * param[3] (out value)
+ *   .a = SDM_PHASE2_STATUS_{SUCCESS,NOP,SKIPPED,FAILED}
+ *   .b = number of hashes actually submitted to the SDM in this call
+ *	  (0 on early/param error, equal to k on success or SDM rejection)
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SMC completed; check param[2].a for SDM result
+ *				 and param[3].a for phase-2 finalization status
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types, bad input size, or unknown
+ *				 bits set in param[1].value.a
+ *   TEE_ERROR_GENERIC	       - ATF rejected the SMC submit
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ *   TEE_ERROR_OUT_OF_MEMORY  - TZDRAM bounce buffer allocation failed
+ */
+#define PTA_CMD_SDM_PROG_PUBKEY		0x9
+
+/* Input hash sizes for PTA_CMD_SDM_PROG_PUBKEY */
+#define SDM_PUBKEY_HASH_SIZE_SHA256	32U	/*  8 × uint32_t (secp256r1) */
+#define SDM_PUBKEY_HASH_SIZE_SHA384	48U	/* 12 × uint32_t (secp384r1) */
+
+/*
+ * PTA_CMD_SDM_EFUSE_RELOAD_CACHE - Reload the SDM eFuse cache
+ *
+ * Calls ATF SiP async service:
+ *   ALTERA_SIP_SMC_ASYNC_SDM_EFUSE_RELOAD_CACHE (0x4200016C)
+ *
+ * The SDM re-reads the physical eFuse contents into its internal cache so
+ * that subsequent fuse / provisioning reads reflect any values that were
+ * burned (or modified) since the previous reload.  This is a side-effect-
+ * only operation: no payload is sent and no data is returned beyond the
+ * SDM accept/reject status.
+ *
+ * Submit-poll flow:
+ *   x0 = ALTERA_SIP_SMC_ASYNC_SDM_EFUSE_RELOAD_CACHE
+ *   x1 = 0 (trans_id)
+ *   (no payload — x2..x7 unused)
+ *
+ *   poll a1 = SDM mailbox status (0 = success, non-zero = SDM error)
+ *
+ * No PTA parameters are required.  param[0..3] must all be TEE_PARAM_TYPE_NONE.
+ *
+ * Result:
+ *   TEE_SUCCESS	       - cache reload accepted by the SDM
+ *   TEE_ERROR_BAD_PARAMETERS - any param type is not NONE
+ *   TEE_ERROR_GENERIC	       - ATF rejected the SMC, or SDM mailbox error
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ */
+#define PTA_CMD_SDM_EFUSE_RELOAD_CACHE	0xA
+
+/*
+ * PTA_CMD_SDM_SECURITY_OP - Apply EFUSE user security options to the SDM
+ *
+ * Calls ATF SiP async service:
+ *   ALTERA_SIP_SMC_ASYNC_FCS_EFUSE_USER_SECURITY_OPTION (0x42000170)
+ *
+ * The caller supplies a 32-bit "user security option" word in
+ * param[0].value.a together with a host control-flags word in
+ * param[1].value.a.  The PTA owns bit[31] (SDM_SECOPT_TEST_MODE) — it
+ * strips the caller's bit[31] and re-sets it based on the host_flags
+ * field, mirroring how cmd_sdm_prog_pubkey handles its T bit:
+ *
+ *   host_flags = 0 (default)		      T=1 → SDM updates virtual/
+ *					       cached state only.
+ *					       Reversible.
+ *   host_flags = SDM_SECOPT_HOST_FLAG_NON_VOLATILE
+ *					      T=0 → SDM permanently burns
+ *					       the physical eFuse fields
+ *					       requested by the option
+ *					       word.  IRREVERSIBLE.
+ *
+ * The PTA emits an EMSG when the non-volatile flag is supplied so the
+ * audit log records every irreversible programming attempt.
+ *
+ * SMC ABI:
+ *   x0 = ALTERA_SIP_SMC_ASYNC_FCS_EFUSE_USER_SECURITY_OPTION
+ *   x1 = 0 (trans_id)
+ *   x2 = security_option_word
+ *	   (PTA-massaged: caller's bit[31] cleared, then re-set per host_flags)
+ *
+ *   poll a1 = SDM mailbox status (0 = success, non-zero = SDM error)
+ *
+ * param[0] (in value)
+ *   .a = 32-bit user security option word (bitmask of SDM_SECOPT_* bits).
+ *	    The TEST_MODE bit is IGNORED here — test mode is controlled
+ *	    exclusively by param[1].value.a / SDM_SECOPT_HOST_FLAG_NON_VOLATILE.
+ *   .b = reserved, must be 0
+ * param[1] (in value)
+ *   .a = host control flags (currently only SDM_SECOPT_HOST_FLAG_NON_VOLATILE).
+ *	   Any unknown bit causes TEE_ERROR_BAD_PARAMETERS.
+ *   .b = reserved, must be 0
+ * param[2..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SDM accepted the security option word
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types, non-zero .b, or unknown
+ *				 bits set in param[1].value.a
+ *   TEE_ERROR_GENERIC	       - ATF rejected the SMC, or SDM mailbox error
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ */
+#define PTA_CMD_SDM_SECURITY_OP		0xB
+
+/*
+ * SDM user-security-option bit definitions (param[0].value.a for
+ * PTA_CMD_SDM_SECURITY_OP).
+ *
+ * Bit layout per the Agilex5 SDM EFUSE_USER_SECURITY_OPTION mailbox payload.
+ * Bits 13..15 and 18..30 are RESERVED and must be written as zero; the SDM
+ * is the final arbiter and may reject any reserved-bit write.
+ *
+ * NOTE: SDM_SECOPT_TEST_MODE (bit 31) is OWNED BY THE PTA.  The PTA strips
+ * it from caller input and re-sets it according to the host_flags word
+ * (param[1].value.a / SDM_SECOPT_HOST_FLAG_NON_VOLATILE).  Setting or
+ * clearing TEST_MODE in the option word has no effect.
+ */
+#define SDM_SECOPT_FIRMWARE_JOINT_SIGNING	(1U << 0)
+#define SDM_SECOPT_AES_KEY_UPDATE_MODE		(1U << 1)
+#define SDM_SECOPT_JTAG_DISABLE		(1U << 2)
+#define SDM_SECOPT_HPS_DEBUG_DISABLE		(1U << 3)
+#define SDM_SECOPT_VIRTUAL_EFUSE_DISABLE	(1U << 4)
+#define SDM_SECOPT_HPS_ZEROIZATION		(1U << 5)
+#define SDM_SECOPT_FPGA_ZEROIZATION		(1U << 6)
+#define SDM_SECOPT_PUF_AES_KEY_DISABLE		(1U << 7)
+#define SDM_SECOPT_BBRAM_AES_KEY_DISABLE	(1U << 8)
+#define SDM_SECOPT_EFUSE_AES_KEY_DISABLE	(1U << 9)
+#define SDM_SECOPT_PUF_ENROLLMENT_DISABLE	(1U << 10)
+#define SDM_SECOPT_SECURE_CLOCK_ONLY		(1U << 11)
+#define SDM_SECOPT_CRC_ENABLE			(1U << 12)
+#define SDM_SECOPT_ALIASL1_DISABLE		(1U << 16)
+#define SDM_SECOPT_DISABLE_BETA_MODE		(1U << 17)
+#define SDM_SECOPT_TEST_MODE			(1U << 31)
+
+/*
+ * SDM_SECOPT_VALID_MASK - union of all defined option bits.
+ * Any bit OUTSIDE this mask falls in a reserved field; the PTA does not
+ * filter on it (the SDM is authoritative) but CAs may use it to sanity-
+ * check user input before invoking PTA_CMD_SDM_SECURITY_OP.
+ */
+#define SDM_SECOPT_VALID_MASK ( \
+	SDM_SECOPT_FIRMWARE_JOINT_SIGNING	| \
+	SDM_SECOPT_AES_KEY_UPDATE_MODE		| \
+	SDM_SECOPT_JTAG_DISABLE			| \
+	SDM_SECOPT_HPS_DEBUG_DISABLE		| \
+	SDM_SECOPT_VIRTUAL_EFUSE_DISABLE	| \
+	SDM_SECOPT_HPS_ZEROIZATION		| \
+	SDM_SECOPT_FPGA_ZEROIZATION		| \
+	SDM_SECOPT_PUF_AES_KEY_DISABLE		| \
+	SDM_SECOPT_BBRAM_AES_KEY_DISABLE	| \
+	SDM_SECOPT_EFUSE_AES_KEY_DISABLE	| \
+	SDM_SECOPT_PUF_ENROLLMENT_DISABLE	| \
+	SDM_SECOPT_SECURE_CLOCK_ONLY		| \
+	SDM_SECOPT_CRC_ENABLE			| \
+	SDM_SECOPT_ALIASL1_DISABLE		| \
+	SDM_SECOPT_DISABLE_BETA_MODE		| \
+	SDM_SECOPT_TEST_MODE)
+
+/*
+ * Host-controllable flag bits passed in PTA_CMD_SDM_SECURITY_OP
+ * param[1].value.a.
+ *
+ * SDM_SECOPT_HOST_FLAG_NON_VOLATILE — instruct the PTA to clear bit[31]
+ * (TEST_MODE) of the SMC payload so the SDM permanently burns the
+ * requested option bits into the physical eFuse.  IRREVERSIBLE.  When
+ * clear (default) the PTA forces bit[31]=1 and only virtual/cached
+ * state is updated.
+ */
+#define SDM_SECOPT_HOST_FLAG_NON_VOLATILE	(1U << 0)
+#define SDM_SECOPT_HOST_FLAGS_VALID_MASK	SDM_SECOPT_HOST_FLAG_NON_VOLATILE
+
+/*
+ * PTA_CMD_SDM_DISABLE_OWNED_ENTRY - Permanently disable transition to the
+ *				       OWNED life-cycle state
+ *
+ * Calls ATF SiP async service:
+ *   ALTERA_SIP_SMC_ASYNC_SECURE_DISABLE_ENTRY_TO_OWNED (0x42000179)
+ *
+ * Once permanently programmed, the SDM refuses any future owner-public-key
+ * root-hash fuse-programming attempt and the device stays in PRODUCTION (or
+ * the equivalent pre-OWNED) state for the rest of its life.  IRREVERSIBLE.
+ *
+ * The SMC takes a single fusing-mode selector in x2:
+ *   x2 = 0	 → physical fusing  (permanent eFuse burn, IRREVERSIBLE)
+ *   x2 != 0	 → virtual fusing   (cache-only, reversible across reset)
+ *
+ * The trusted PTA owns the x2 selector — it is computed solely from the
+ * host_flags word (SDM_DEO_HOST_FLAG_NON_VOLATILE) so that a buggy or
+ * malicious CA cannot bypass the policy.  This mirrors how
+ * cmd_sdm_prog_pubkey and cmd_sdm_security_op handle their "T" / TEST_MODE
+ * bits.
+ *
+ *   host_flags = 0 (default)		  x2 = 1 → virtual / cache-only
+ *   host_flags = SDM_DEO_HOST_FLAG_NON_VOLATILE
+ *					  x2 = 0 → physical eFuse burn
+ *						   (IRREVERSIBLE)
+ *
+ * The PTA emits an EMSG on every non-volatile request so the audit log
+ * records each irreversible programming attempt.
+ *
+ * SMC ABI:
+ *   x0 = ALTERA_SIP_SMC_ASYNC_SECURE_DISABLE_ENTRY_TO_OWNED
+ *   x1 = 0 (request header / trans_id)
+ *   x2 = fusing-mode selector (see above)
+ *
+ *   poll a1 = SDM mailbox status (0 = success, non-zero = SDM error)
+ *
+ * Phase-2 finalization
+ * --------------------
+ * Once the SDM accepts the disable-owned-entry request, the PTA waits 1
+ * second and then issues the ATF SiP service
+ *   ALTERA_SIP_SMC_ASYNC_SECURE_EFUSE_PUBKEY_PROGRAM_PHASE2 (0x42000178)
+ * to finalize the operation.	For SDM_DEO_HOST_FLAG_NON_VOLATILE (physical
+ * fusing) the SDM triggers a Soft POR after phase-2; for the default
+ * (virtual / cache-only) it returns without resetting.  The outcome is
+ * surfaced through the new VALUE_OUTPUT param[1] (see SDM_PHASE2_STATUS_*).
+ * If the SDM rejects the prior request, the PTA leaves phase-2 unattempted
+ * and reports SDM_PHASE2_STATUS_SKIPPED.
+ *
+ * param[0] (in value)
+ *   .a = host control flags (currently only SDM_DEO_HOST_FLAG_NON_VOLATILE)
+ *   .b = reserved, must be 0
+ * param[1] (out value)
+ *   .a = SDM_PHASE2_STATUS_{SUCCESS,NOP,SKIPPED,FAILED}
+ *   .b = reserved, always 0
+ * param[2..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SDM accepted the disable request; check
+ *				 param[1].a for phase-2 finalization status
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types, non-zero .b, or unknown
+ *				 bits set in param[0].value.a
+ *   TEE_ERROR_GENERIC	       - ATF rejected the SMC, or SDM mailbox error
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ */
+#define PTA_CMD_SDM_DISABLE_OWNED_ENTRY	0xC
+
+/*
+ * Host-controllable flag bits passed in PTA_CMD_SDM_DISABLE_OWNED_ENTRY
+ * param[0].value.a.
+ *
+ * SDM_DEO_HOST_FLAG_NON_VOLATILE — instruct the PTA to use physical
+ * fusing (SMC x2 = 0) so the SDM permanently disables owner-pubkey
+ * programming and locks the device out of the OWNED life-cycle state.
+ * IRREVERSIBLE.  When clear (default) the PTA uses virtual fusing
+ * (SMC x2 != 0) and only cached/volatile state is updated.
+ *
+ * DEO = "Disable Entry to Owned".
+ */
+#define SDM_DEO_HOST_FLAG_NON_VOLATILE	(1U << 0)
+#define SDM_DEO_HOST_FLAGS_VALID_MASK	SDM_DEO_HOST_FLAG_NON_VOLATILE
+
+/*
+ * PTA_CMD_SDM_EFUSE_WRITE_DISABLE - Disable further eFuse write operations
+ *
+ * Calls ATF SiP async service:
+ *   ALTERA_SIP_SMC_ASYNC_SECURE_EFUSE_WRITE_DISABLE (0x42000177)
+ *
+ * Instructs the SDM to disable subsequent eFuse-write commands.  No SDM
+ * mailbox payload is required and no data is returned beyond the SDM
+ * accept status; all four PTA params must be TEE_PARAM_TYPE_NONE.
+ *
+ * SMC ABI:
+ *   x0 = ALTERA_SIP_SMC_ASYNC_SECURE_EFUSE_WRITE_DISABLE
+ *   x1 = 0 (request header / trans_id)
+ *   x2 = 0
+ *
+ *   poll a1 = SDM mailbox status (0 = success, non-zero = SDM error)
+ *
+ * param[0..3] NONE
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SDM accepted the write-disable request
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types
+ *   TEE_ERROR_GENERIC	       - ATF rejected the SMC, or SDM mailbox error
+ *   TEE_ERROR_BUSY	       - SDM poll timed out
+ */
+#define PTA_CMD_SDM_EFUSE_WRITE_DISABLE	0xD
+
+/*
+ * PTA_CMD_SDM_NS_ALLOWED_LIST_DEACTIVATE - Deactivate the SDM Non-Secure
+ *					     allowed-command list (whitelist
+ *					     enforcement) at runtime.
+ *
+ * Calls the synchronous ATF SiP service:
+ *   ALTERA_SIP_SMC_NS_ALLOWED_LIST_DEACTIVATE (0x42000181)
+ *
+ * Status semantics are identical to ALTERA_SIP_SMC_NS_ALLOWED_LIST_{CLEAR,ADD}:
+ *   x0 = 0  → Operation accepted and processed
+ *   x0 = 2  → Operation busy / command only allowed from the Secure World
+ *
+ * The list itself is installed at OP-TEE boot by the file-local
+ * boot_final() hook sdm_ns_allowed_list_boot_init() (see sdm_svc.c).	This
+ * PTA command lets a CA disable that whitelist enforcement later if the
+ * platform policy permits it.
+ *
+ * SMC ABI:
+ *   x0 = ALTERA_SIP_SMC_NS_ALLOWED_LIST_DEACTIVATE  (request header / function ID)
+ *
+ * param[0..3] NONE
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SDM/ATF accepted the deactivate
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types
+ *   TEE_ERROR_BUSY	       - SiP reported status 2 (busy / secure-only)
+ *   TEE_ERROR_GENERIC	       - unexpected status from ATF
+ */
+#define PTA_CMD_SDM_NS_ALLOWED_LIST_DEACTIVATE	0xE
+
+/*
+ * PTA_CMD_SDM_NS_ALLOWED_LIST_REMOVE - Remove a single SiP SMC function ID
+ *					 from the SDM Non-Secure-world
+ *					 allowed list at runtime.
+ *
+ * Calls the synchronous ATF SiP service:
+ *   ALTERA_SIP_SMC_NS_ALLOWED_LIST_REMOVE (0x4200017F)
+ *
+ * Status semantics match ALTERA_SIP_SMC_NS_ALLOWED_LIST_{CLEAR,ADD,DEACTIVATE}:
+ *   x0 = 0  → Operation accepted and processed
+ *   x0 = 2  → Operation busy / command only allowed from the Secure World
+ *
+ * The list itself is installed at OP-TEE boot by the file-local
+ * boot_final() hook sdm_ns_allowed_list_boot_init() (see sdm_svc.c).	This
+ * PTA command lets a CA revoke individual FIDs from that whitelist at
+ * runtime — e.g. once a one-shot provisioning step is complete.
+ *
+ * Each entry passed in param[0].value.a is a complete 32-bit SiP SMC FID
+ * (the FID Linux would issue via smc/hvc), NOT a raw SDM mailbox opcode.
+ *
+ * SMC ABI:
+ *   x0 = ALTERA_SIP_SMC_NS_ALLOWED_LIST_REMOVE (request header / function ID)
+ *   x1 = SiP SMC FID to revoke
+ *
+ * param[0] (in value)
+ *   .a = 32-bit SiP SMC FID to remove (e.g. 0x420000D3 GET_IDCODE)
+ *   .b = reserved, must be 0
+ * param[1..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS	       - SDM/ATF accepted the remove
+ *   TEE_ERROR_BAD_PARAMETERS - wrong param types or non-zero .b
+ *   TEE_ERROR_BUSY	       - SiP reported status 2 (busy / secure-only)
+ *   TEE_ERROR_GENERIC	       - unexpected status from ATF
+ */
+#define PTA_CMD_SDM_NS_ALLOWED_LIST_REMOVE	0xF
+
+/*
+ * SDM mailbox payload sizes for PROGRAM_OWNER_PUBKEY.
+ * Layout: 2 header words + N hash words (40 bytes for secp256r1, 56 for
+ * secp384r1).	 hash_type in the SMC x2 flags word is derived from input size.
+ */
+#define SDM_PUBKEY_PAYLOAD_SIZE_SECP256R1	40U	/* 10 words: 2 hdr + 8 hash */
+#define SDM_PUBKEY_PAYLOAD_SIZE_SECP384R1	56U	/* 14 words: 2 hdr + 12 hash */
+
+/* SDM mailbox word size; ATF expects the x4 length in words, not bytes. */
+#define SDM_PUBKEY_WORD_BYTES			4U
+
+/* Byte offset where the hash data begins inside the payload buffer (word 2) */
+#define SDM_PUBKEY_HASH_OFFSET		8U
+
+/*
+ * Maximum number of SECP384R1 hashes that can be packed contiguously into
+ * one PTA_CMD_SDM_PROG_PUBKEY call (memref.size up to this many *
+ * SDM_PUBKEY_HASH_SIZE_SHA384 bytes).  Matches this board's 5 owner-root
+ * key slots (root0..root4.qky) and the ATF EFUSE_PUBKEY_PROGRAM batch
+ * limit (MBOX_EFUSE_PUBKEY_MAX_KEY_SETS).
+ */
+#define SDM_PUBKEY_MAX_HASHES_PER_CALL	5U
+
+/* hash_type field values (flags word bits [1:0]) */
+#define SDM_PUBKEY_HASH_TYPE_SECP256R1	1U
+#define SDM_PUBKEY_HASH_TYPE_SECP384R1	2U
+
+/* Flags word bit definitions (passed in x2 of the SMC) */
+#define SDM_PUBKEY_FLAG_TEST		(1U << 31)	/* T: cache-only, no fuse burn */
+#define SDM_PUBKEY_FLAG_SKIP_CANCEL	(1U << 30)	/* S: skip cancel (dev only) */
+
+/*
+ * Key-set count field, flags word bits [15:8], encoded as (k - 1):
+ *
+ *   k=1 -> 0x00	k=2 -> 0x01	k=3 -> 0x02
+ *   k=4 -> 0x03	k=5 -> 0x04
+ *
+ * So 3 secp384r1 hashes yield a flags word of 0x80000202 with T=1.
+ *
+ * The ATF EFUSE_PUBKEY_PROGRAM handler documents bits [29:2] as reserved and
+ * copies x2 verbatim into payload word[1], so these bits reach the SDM
+ * untouched.  The SDM does consume them: it derives the expected payload
+ * length from this count, and leaving it at 0 while sending a k-set payload
+ * makes the SDM reject the command with err_code 0x4.  The count must
+ * therefore always match the number of hashes in the payload.
+ *
+ * k=1 encodes to 0, leaving the single-key flags word bit-identical to before.
+ */
+#define SDM_PUBKEY_FLAG_KEY_COUNT_SHIFT	8U
+#define SDM_PUBKEY_FLAG_KEY_COUNT_MASK	(0xFFU << SDM_PUBKEY_FLAG_KEY_COUNT_SHIFT)
+#define SDM_PUBKEY_FLAG_KEY_COUNT(k)					\
+	((((uint32_t)(k) - 1U) << SDM_PUBKEY_FLAG_KEY_COUNT_SHIFT) &	\
+	 SDM_PUBKEY_FLAG_KEY_COUNT_MASK)
+
+/*
+ * Host-controllable flag bits passed in PTA_CMD_SDM_PROG_PUBKEY param[1].value.a.
+ *
+ * SDM_PUBKEY_HOST_FLAG_NON_VOLATILE — instruct the PTA to clear the SDM test
+ * bit so the SDM permanently burns the owner-root key hash into the physical
+ * eFuse.  This is IRREVERSIBLE.  When clear (default) the PTA forces test
+ * mode and only virtual/cached state is updated.
+ */
+#define SDM_PUBKEY_HOST_FLAG_NON_VOLATILE	(1U << 0)
+#define SDM_PUBKEY_HOST_FLAGS_VALID_MASK	SDM_PUBKEY_HOST_FLAG_NON_VOLATILE
+
+/*
+ * Program control word (payload word 1) for PTA_CMD_SDM_PROG_USER_FUSES.
+ *
+ * Bit layout:
+ *   [31]    = test flag  (1 = virtual / cache-only, 0 = burn physical eFuse)
+ *   [15:8]  = num_words  (0x10 = 16 words)
+ *   [7:0]   = start_word (0)
+ *
+ * The PTA picks SDM_EFUSE_PROG_CTRL_WORD by default and
+ * SDM_EFUSE_PROG_CTRL_WORD_BURN when the caller passes
+ * SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE in PTA_CMD_SDM_PROG_USER_FUSES
+ * param[1].value.a.
+ */
+#define SDM_EFUSE_PROG_CTRL_WORD	0x80001000U	/* test=1 (virtual)  */
+#define SDM_EFUSE_PROG_CTRL_WORD_BURN	0x00001000U	/* test=0 (eFuse burn) */
+
+/*
+ * Host-controllable flag bits passed in PTA_CMD_SDM_PROG_USER_FUSES
+ * param[1].value.a.
+ *
+ * SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE — instruct the PTA to clear the SDM
+ * test bit so the SDM permanently burns the 16 user-fuse words into the
+ * physical eFuse.  This is IRREVERSIBLE.  When clear (default) the PTA
+ * forces test mode and only virtual/cached state is updated.	The PTA reads
+ * only this bit; any other bits in param[1].value.a are ignored.
+ */
+#define SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE	(1U << 0)
+
+/* Crypto direction for PTA_CMD_SDM_SDOS_CRYPT param[0].value.a */
+#define PTA_SDM_SVC_CRYPT_DECRYPT	0
+#define PTA_SDM_SVC_CRYPT_ENCRYPT	1
+
+/*
+ * SDOS buffer layout constants and header structure.
+ *
+ * Callers of PTA_CMD_SDM_SDOS_CRYPT must construct the SDOS input buffer
+ * using this structure.  The magic field selects encrypt vs. decrypt input.
+ *
+ * Encrypt input buffer layout (param[1]):
+ *   offset 0:		   struct sdos_hdr   (SDOS_HDR_SIZE = 40 bytes)
+ *   offset SDOS_HDR_SIZE: plaintext bytes
+ *   offset SDOS_HDR_SIZE+plaintext_len: zero-fill padding (SDOS_PAD_LEN bytes)
+ *
+ * sdos_hdr fields to set for encrypt:
+ *   magic	= SDOS_ENCRYPT_IN_MAGIC	 (0xACBDBDED)
+ *   data_len	= plaintext_len + SDOS_PAD_LEN(plaintext_len)
+ *   flags	= SDOS_FLAGS(1, srk_index, SDOS_PAD_LEN(plaintext_len))
+ *   owner_id	= caller's 8-byte owner identifier (little-endian uint32[2])
+ *   hdr_pad	= SDOS_HDR_PAD_MAGIC  (0x01020304, required per Table 49 Security Methodology UG)
+ *   iv	= {0} (SDM fills this in the output)
+ *
+ * Decrypt input buffer layout (param[1]):
+ *   The complete SDOS blob produced by a previous encrypt operation.
+ */
+#define SDOS_HDR_SIZE			40
+#define SDOS_HMAC_SIZE			48	/* empirical: SDM adds 48 bytes of auth/IV overhead */
+#define SDOS_ENCRYPT_IN_MAGIC		0xACBDBDEDU
+#define SDOS_ENCRYPT_OUT_MAGIC		0x53424212U
+/* Required constant in sdos_hdr.hdr_pad (Table 49, Security Methodology UG) */
+#define SDOS_HDR_PAD_MAGIC		0x01020304U
+
+/*
+ * SDOS_PAD_LEN - padding bytes to add to plaintext_len so that
+ * data_len (plaintext + padding) is a multiple of 32.
+ * Returns 0 when plaintext_len is already a multiple of 32, otherwise
+ * returns the number of zero bytes needed to reach the next multiple.
+ * Range: [0..31].  (Security Methodology UG, Table 49)
+ */
+#define SDOS_PAD_LEN(n)			(((n) % 32) ? (32 - ((n) % 32)) : 0)
+
+/* SDOS data_len (padded plaintext) must be in this range (Table 49) */
+#define SDOS_MIN_DATA_LEN		32U
+#define SDOS_MAX_DATA_LEN		(32U * 1024U - 96U)	/* 32,672 bytes */
+
+/*
+ * SDOS_FLAGS - encode the flags word from its three fields.
+ *   asoi:	 Application-Specific Owner Identifier bit (1 = ASOI present)
+ *   srk_index: Secure Root Key index (0 for default)
+ *   pad_len:	 SDOS_PAD_LEN(plaintext_len)
+ */
+#define SDOS_FLAGS(asoi, srk_index, pad_len) \
+	(((uint32_t)(asoi) << 16) | ((uint32_t)(srk_index) << 8) | (uint32_t)(pad_len))
+
+#ifndef __ASSEMBLER__
+#include <stdint.h>
+
+/*
+ * SDOS 40-byte header — placed at offset 0 of the encrypt/decrypt input buffer.
+ * Fields are little-endian 32-bit words; total size is exactly SDOS_HDR_SIZE bytes.
+ */
+struct sdos_hdr {
+	uint32_t magic;		  /* SDOS_ENCRYPT_IN_MAGIC or SDOS_ENCRYPT_OUT_MAGIC */
+	uint32_t data_len;	  /* plaintext_len + pad_len */
+	uint32_t flags;		  /* SDOS_FLAGS(asoi, srk_index, pad_len) */
+	uint32_t owner_id[2]; /* 8-byte owner ID, little-endian */
+	uint32_t hdr_pad;	  /* must be SDOS_HDR_PAD_MAGIC (0x01020304) per Table 49 */
+	uint32_t iv[4];		  /* 16-byte IV: {0} on input, filled by SDM on output */
+};
+#endif /* __ASSEMBLER__ */
+
+#endif /* __PTA_SDM_SVC_H */
