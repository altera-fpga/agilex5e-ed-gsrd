# Quartus version assignments
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "19:25:59  JANUARY 19, 2025"
set_global_assignment -name LAST_QUARTUS_VERSION "26.3.0 Pro Edition"


# Device properties
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5ED013BM16AE4SCS


# Toplevel and toplevel RTL
set_global_assignment -name TOP_LEVEL_ENTITY tsn_rgmii_hvio


# Flow assignments
# Put all reports into the output_files directory
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# Set the default parallelization to 4
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# Define the board as default
set_global_assignment -name BOARD default
# Convert timing failures to errors
set_global_assignment -name PROMOTE_WARNING_TO_ERROR 332148
# Include custom IP in IP search path
set_global_assignment -name IP_SEARCH_PATHS custom_ip/**/*
# Disable assembler during "play button" flow
set_global_assignment -name FLOW_DISABLE_ASSEMBLER ON
# Disable spawning the Timing Analyzer GUI during the "play button" flow
set_global_assignment -name FLOW_ENABLE_INTERACTIVE_TIMING_ANALYZER OFF
# Promote pins without location assignments to errors
set_global_assignment -name PROMOTE_WARNING_TO_ERROR 12677
# workaround to regenerate HPS EMIF IP and prevent synthesis error
set_global_assignment -name PROJECT_IP_REGENERATION_POLICY ALWAYS_REGENERATE_IP


# Configuration Assignments
set_global_assignment -name HPS_DAP_NO_CERTIFICATE on
set_global_assignment -name QSPI_OWNERSHIP HPS
set_global_assignment -name ENABLE_INTERMEDIATE_SNAPSHOTS ON
set_global_assignment -name USE_HPS_COLD_RESET SDM_IO10
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name USE_INIT_DONE SDM_IO0
set_global_assignment -name SDM_DIRECT_TO_FACTORY_IMAGE SDM_IO13
set_global_assignment -name HPS_INITIALIZATION "HPS FIRST"
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_100MHZ
set_global_assignment -name HPS_DAP_SPLIT_MODE "SDM PINS"
set_global_assignment -name USE_CHECKSUM_AS_USERCODE OFF
set_global_assignment -name AUTO_RESTART_CONFIGURATION OFF
# Default value is Flash, but it must be set to other value to avoid conflict the QSPI_OWNERSHIP.
set_global_assignment -name PROGRAMMING_BITSTREAM_ENCRYPTION_KEY_SELECT eFuses


# Pin location and IO standard assignments
# Clocks, resets, GPIO
set_location_assignment PIN_AJ27 -to pll_refclk_100
