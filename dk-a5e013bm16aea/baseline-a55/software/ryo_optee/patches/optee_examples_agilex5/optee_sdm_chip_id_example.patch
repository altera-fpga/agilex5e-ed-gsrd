diff --git a/optee_examples/sdm_chip_id/host/main.c b/optee_examples/sdm_chip_id/host/main.c
new file mode 100644
index 000000000000..b79439ae1606
--- /dev/null
+++ b/optee_examples/sdm_chip_id/host/main.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2024-2026, Intel Corporation
+ *
+ * sdm_chip_id - Linux host application.
+ *
+ * Reads the Intel SDM (Secure Device Manager) Chip ID by opening a
+ * session to the sdm_chip_id Trusted Application, which in turn forwards
+ * the request to the SDM Services Pseudo-TA (PTA_SDM_SVC).
+ *
+ * Boot chain for the underlying SiP call:
+ *     host -> sdm_chip_id TA -> PTA_SDM_SVC -> ATF (INTEL_SIP_SMC_FCS_CHIP_ID)
+ *
+ * Usage:  sdm_chip_id
+ */
+
+#include <err.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <tee_client_api.h>
+
+#include <sdm_chip_id_ta.h>
+
+int main(void)
+{
+	TEEC_Result res;
+	TEEC_Context ctx;
+	TEEC_Session sess;
+	TEEC_Operation op;
+	TEEC_UUID uuid = TA_SDM_CHIP_ID_UUID;
+	uint32_t err_origin;
+	uint64_t chip_id;
+
+	res = TEEC_InitializeContext(NULL, &ctx);
+	if (res != TEEC_SUCCESS)
+		errx(1, "TEEC_InitializeContext failed: 0x%x", res);
+
+	res = TEEC_OpenSession(&ctx, &sess, &uuid,
+			       TEEC_LOGIN_PUBLIC, NULL, NULL, &err_origin);
+	if (res != TEEC_SUCCESS)
+		errx(1, "TEEC_OpenSession failed: 0x%x (origin 0x%x)",
+		     res, err_origin);
+
+	memset(&op, 0, sizeof(op));
+	op.paramTypes = TEEC_PARAM_TYPES(TEEC_VALUE_OUTPUT,
+					 TEEC_NONE, TEEC_NONE, TEEC_NONE);
+
+	res = TEEC_InvokeCommand(&sess, TA_SDM_CHIP_ID_CMD_GET, &op,
+				 &err_origin);
+	if (res != TEEC_SUCCESS)
+		errx(1, "TEEC_InvokeCommand failed: 0x%x (origin 0x%x)",
+		     res, err_origin);
+
+	chip_id = ((uint64_t)op.params[0].value.b << 32) |
+		   (uint64_t)op.params[0].value.a;
+
+	printf("SDM Chip ID: 0x%016" PRIx64 "\n", chip_id);
+
+	TEEC_CloseSession(&sess);
+	TEEC_FinalizeContext(&ctx);
+
+	return 0;
+}
