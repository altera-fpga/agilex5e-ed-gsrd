diff --git a/optee_examples/sdm_chip_id/ta/user_ta_header_defines.h b/optee_examples/sdm_chip_id/ta/user_ta_header_defines.h
new file mode 100644
index 000000000000..0082fa528c5b
--- /dev/null
+++ b/optee_examples/sdm_chip_id/ta/user_ta_header_defines.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * The name of this file must not be modified - it is included by the
+ * TA dev kit to populate the gpd.ta.* property table for this TA.
+ */
+
+#ifndef USER_TA_HEADER_DEFINES_H
+#define USER_TA_HEADER_DEFINES_H
+
+#include <sdm_chip_id_ta.h>
+
+#define TA_UUID			TA_SDM_CHIP_ID_UUID
+
+/*
+ * Single-instance + multi-session so the TA stays loaded between host
+ * invocations and the cached PTA session can be re-used.  Instance is
+ * also kept alive across sessions to avoid re-doing the PTA handshake.
+ */
+#define TA_FLAGS		(TA_FLAG_SINGLE_INSTANCE | \
+				 TA_FLAG_MULTI_SESSION | \
+				 TA_FLAG_INSTANCE_KEEP_ALIVE)
+
+#define TA_STACK_SIZE		(2 * 1024)
+#define TA_DATA_SIZE		(32 * 1024)
+
+#define TA_VERSION		"1.0"
+#define TA_DESCRIPTION		"Intel SDM Chip ID wrapper TA (PTA_SDM_SVC)"
+
+#define TA_CURRENT_TA_EXT_PROPERTIES \
+	{ "com.intel.optee.examples.sdm_chip_id.description", \
+	  USER_TA_PROP_TYPE_STRING, \
+	  "Returns the 64-bit SDM/HPS chip ID via PTA_SDM_SVC" }
+
+#endif /* USER_TA_HEADER_DEFINES_H */
