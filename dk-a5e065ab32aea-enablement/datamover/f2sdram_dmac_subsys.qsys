   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;resetting&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set when mSGDMA is in the middle of a reset cycle.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;6&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;6&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stopped_on_error&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set when the dispatcher is programmed to stop on errors and when an error beat enters the write host sink port.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;7&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;7&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stopped_on_early_termination&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set when the dispatcher is programmed to stop on early termination and when an early termination packet transfer is received by the write host.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;8&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;8&amp;lt;/msb&amp;gt;
