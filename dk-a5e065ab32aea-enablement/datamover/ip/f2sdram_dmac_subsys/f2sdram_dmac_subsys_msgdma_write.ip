  <ipxact:memoryMaps>
    <ipxact:memoryMap>
      <ipxact:name>csr</ipxact:name>
      <ipxact:addressBlock>
        <ipxact:name>msgdma_dispatcher_csr_block</ipxact:name>
        <ipxact:baseAddress>0x0</ipxact:baseAddress>
        <ipxact:range>0x20</ipxact:range>
        <ipxact:width>32</ipxact:width>
        <ipxact:usage>register</ipxact:usage>
        <ipxact:access>read-write</ipxact:access>
        <ipxact:register>
          <ipxact:name>dispatcher_status</ipxact:name>
          <ipxact:displayName>Status Register</ipxact:displayName>
          <ipxact:description>Status Register</ipxact:description>
          <ipxact:addressOffset>0x0</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>reserved</ipxact:name>
            <ipxact:displayName>Reserved</ipxact:displayName>
            <ipxact:description>Reserved</ipxact:description>
            <ipxact:bitOffset>10</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x000000</ipxact:value>
                <ipxact:mask>0x3fffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>22</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>irq</ipxact:name>
            <ipxact:displayName>IRQ</ipxact:displayName>
            <ipxact:description>Set when interrupt condition occurs.</ipxact:description>
            <ipxact:bitOffset>9</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:modifiedWriteValue>oneToClear</ipxact:modifiedWriteValue>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stopped_on_early_termination</ipxact:name>
            <ipxact:displayName>Stopped on Early Termination</ipxact:displayName>
            <ipxact:description>Set when the dispatcher is programmed to stop on early termination and when an early termination packet transfer is received by the write host.</ipxact:description>
            <ipxact:bitOffset>8</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stopped_on_error</ipxact:name>
            <ipxact:displayName>Stopped on Error</ipxact:displayName>
            <ipxact:description>Set when the dispatcher is programmed to stop on errors and when an error beat enters the write host sink port.</ipxact:description>
            <ipxact:bitOffset>7</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>resetting</ipxact:name>
            <ipxact:displayName>Resetting</ipxact:displayName>
            <ipxact:description>Set when mSGDMA is in the middle of a reset cycle.</ipxact:description>
            <ipxact:bitOffset>6</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stopped</ipxact:name>
            <ipxact:displayName>Stopped</ipxact:displayName>
            <ipxact:description>Set when mSGDMA is programmed to stop manually, or when the dispatcher is programmed to stop on errors or early termination.</ipxact:description>
            <ipxact:bitOffset>5</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>response_buffer_full</ipxact:name>
            <ipxact:displayName>Response Buffer Full</ipxact:displayName>
            <ipxact:description>Set when the response buffer is full.</ipxact:description>
            <ipxact:bitOffset>4</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>response_buffer_empty</ipxact:name>
            <ipxact:displayName>Response Buffer Empty</ipxact:displayName>
            <ipxact:description>Set when the response buffer is empty.</ipxact:description>
            <ipxact:bitOffset>3</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x1</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>descriptor_buffer_full</ipxact:name>
            <ipxact:displayName>Descriptor Buffer Full</ipxact:displayName>
            <ipxact:description>Set when either the read or write command buffers are full.</ipxact:description>
            <ipxact:bitOffset>2</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>descriptor_buffer_empty</ipxact:name>
            <ipxact:displayName>Descriptor Buffer Empty</ipxact:displayName>
            <ipxact:description>Set when both the read and write command buffers are empty.</ipxact:description>
            <ipxact:bitOffset>1</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x1</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>busy</ipxact:name>
            <ipxact:displayName>Busy</ipxact:displayName>
            <ipxact:description>Set when the dispatcher still has commands buffered or one of the hosts is still transferring data.</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>dispatcher_control</ipxact:name>
          <ipxact:displayName>Control Register</ipxact:displayName>
          <ipxact:description>Control Register</ipxact:description>
          <ipxact:addressOffset>0x4</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>reserved</ipxact:name>
            <ipxact:displayName>Reserved</ipxact:displayName>
            <ipxact:description>Reserved</ipxact:description>
            <ipxact:bitOffset>6</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000000</ipxact:value>
                <ipxact:mask>0x3ffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>26</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stop_descriptors</ipxact:name>
            <ipxact:displayName>Stop Descriptors</ipxact:displayName>
            <ipxact:description>Set this bit to stop the mSGDMA dispatcher from issuing more descriptors to the read or write hosts.</ipxact:description>
            <ipxact:bitOffset>5</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>global_interrupt_enable_mask</ipxact:name>
            <ipxact:displayName>Global Interrupt Enable Mask</ipxact:displayName>
            <ipxact:description>Set this bit to allow interrupts to propagate to the interrupt sender port.</ipxact:description>
            <ipxact:bitOffset>4</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stop_on_early_termination</ipxact:name>
            <ipxact:displayName>Stop on Early Termination</ipxact:displayName>
            <ipxact:description>Set this bit to stop the mSGDMA from issuing more read/write commands to the host modules if an early termination packet is received by write host.</ipxact:description>
            <ipxact:bitOffset>3</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stop_on_error</ipxact:name>
            <ipxact:displayName>Stop on Error</ipxact:displayName>
            <ipxact:description>Set this bit to stop the mSGDMA from issuing more read/write commands to the host modules if an error enters the write host module sink port.</ipxact:description>
            <ipxact:bitOffset>2</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>reset_dispatcher</ipxact:name>
            <ipxact:displayName>Reset Dispatcher</ipxact:displayName>
            <ipxact:description>Set this bit to reset the registers and FIFOs of the dispatcher and host modules.</ipxact:description>
            <ipxact:bitOffset>1</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>stop_dispatcher</ipxact:name>
            <ipxact:displayName>Stop Dispatcher</ipxact:displayName>
            <ipxact:description>Set this bit to stop the mSGDMA in the middle of a transaction.</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>dispatcher_read_write_fill_level</ipxact:name>
          <ipxact:displayName>Read and Write Fill Level Register</ipxact:displayName>
          <ipxact:description>Read and Write Fill Level Register</ipxact:description>
          <ipxact:addressOffset>0x8</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>write_fill_level</ipxact:name>
            <ipxact:displayName>Write Fill Level</ipxact:displayName>
            <ipxact:description>Indicates the number of valid descriptor entries in the write command fifo that are yet to be executed.</ipxact:description>
            <ipxact:bitOffset>16</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000</ipxact:value>
                <ipxact:mask>0xffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>16</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>read_fill_level</ipxact:name>
            <ipxact:displayName>Read Fill Level</ipxact:displayName>
            <ipxact:description>Indicates the number of valid descriptor entries in the read command fifo that are yet to be executed.</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000</ipxact:value>
                <ipxact:mask>0xffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>16</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>dispatcher_response_fill_level</ipxact:name>
          <ipxact:displayName>Response Fill Level Register</ipxact:displayName>
          <ipxact:description>Response Fill Level Register</ipxact:description>
          <ipxact:addressOffset>0xc</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>reserved</ipxact:name>
            <ipxact:displayName>Reserved</ipxact:displayName>
            <ipxact:description>Reserved</ipxact:description>
            <ipxact:bitOffset>16</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000</ipxact:value>
                <ipxact:mask>0xffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>16</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>response_fill_level</ipxact:name>
            <ipxact:displayName>Response Fill Level</ipxact:displayName>
            <ipxact:description>Indicates number of valid response entries in the response fifo that are yet to be retrieved. If the Response Port is disabled, this field output is 0.</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000</ipxact:value>
                <ipxact:mask>0xffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>16</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>dispatcher_sequence_number</ipxact:name>
          <ipxact:displayName>Sequence Number Register</ipxact:displayName>
          <ipxact:description>Sequence Number Register</ipxact:description>
          <ipxact:addressOffset>0x10</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>write_sequence_number</ipxact:name>
            <ipxact:displayName>Write Sequence Number</ipxact:displayName>
            <ipxact:description>Indicates the sequence number of the next descriptor for the write host to operate on. If the transfer mode is Memory-Mapped to Streaming, this field output is 0. This field is applicable only when Extended Feature Support parameter is enabled.</ipxact:description>
            <ipxact:bitOffset>16</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000</ipxact:value>
                <ipxact:mask>0xffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>16</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>read_sequence_number</ipxact:name>
            <ipxact:displayName>Read Sequence Number</ipxact:displayName>
            <ipxact:description>Indicates the sequence number of the next descriptor for the read host to operate on. If the transfer mode is Streaming to Memory-Mapped, this field output is 0. This field is applicable only when Extended Feature Support parameter is enabled.</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0000</ipxact:value>
                <ipxact:mask>0xffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>16</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>dispatcher_comp_config_1</ipxact:name>
          <ipxact:displayName>Component Configuration 1 Register</ipxact:displayName>
          <ipxact:description>Component Configuration 1 Register</ipxact:description>
          <ipxact:addressOffset>0x14</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>max_byte</ipxact:name>
            <ipxact:displayName>MAX_BYTE</ipxact:displayName>
            <ipxact:description>The build time configured maximum transfer length.</ipxact:description>
            <ipxact:bitOffset>27</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00</ipxact:value>
                <ipxact:mask>0x1f</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>5</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>max_burst_count</ipxact:name>
            <ipxact:displayName>MAX_BURST_COUNT</ipxact:displayName>
            <ipxact:description>The build time configured maximum burst count.</ipxact:description>
            <ipxact:bitOffset>23</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0xf</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>4</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>error_width</ipxact:name>
            <ipxact:displayName>ERROR_WIDTH</ipxact:displayName>
            <ipxact:description>The build time configured number of error lines in data streaming interface.</ipxact:description>
            <ipxact:bitOffset>20</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x7</ipxact:value>
                <ipxact:mask>0x7</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>3</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>error_enable</ipxact:name>
            <ipxact:displayName>ERROR_ENABLE</ipxact:displayName>
            <ipxact:description>The build time configured error support in data streaming interface.</ipxact:description>
            <ipxact:bitOffset>19</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>enhanced_features</ipxact:name>
            <ipxact:displayName>ENHANCED_FEATURES</ipxact:displayName>
            <ipxact:description>The build time configured extended features support.</ipxact:description>
            <ipxact:bitOffset>18</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>dma_mode</ipxact:name>
            <ipxact:displayName>DMA_MODE</ipxact:displayName>
            <ipxact:description>The build time configured dma transfer mode.</ipxact:description>
            <ipxact:bitOffset>16</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x3</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>2</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>descriptor_fifo_depth</ipxact:name>
            <ipxact:displayName>DESCRIPTOR_FIFO_DEPTH</ipxact:displayName>
            <ipxact:description>The build time configured depth of descriptor fifo.</ipxact:description>
            <ipxact:bitOffset>13</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x4</ipxact:value>
                <ipxact:mask>0x7</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>3</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>data_width</ipxact:name>
            <ipxact:displayName>DATA_WIDTH</ipxact:displayName>
            <ipxact:description>The build time configured width of data path.</ipxact:description>
            <ipxact:bitOffset>10</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x2</ipxact:value>
                <ipxact:mask>0x7</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>3</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>data_fifo_depth</ipxact:name>
            <ipxact:displayName>DATA_FIFO_DEPTH</ipxact:displayName>
            <ipxact:description>The build time configured depth of internal data path fifo.</ipxact:description>
            <ipxact:bitOffset>6</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x1</ipxact:value>
                <ipxact:mask>0xf</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>4</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>channel_width</ipxact:name>
            <ipxact:displayName>CHANNEL_WIDTH</ipxact:displayName>
            <ipxact:description>The build time configured number of channel used in data streaming interface.</ipxact:description>
            <ipxact:bitOffset>3</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x7</ipxact:value>
                <ipxact:mask>0x7</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>3</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>channel_enable</ipxact:name>
            <ipxact:displayName>CHANNEL_ENABLE</ipxact:displayName>
            <ipxact:description>The build time configured channel support in data streaming interface.</ipxact:description>
            <ipxact:bitOffset>2</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
