+	@echo 'Note: TA_DEV_KIT_DIR=$(TA_DEV_KIT_DIR)'
+endif
diff --git a/optee_examples/sdm_prog_pubkey/ta/include/sdm_prog_pubkey_ta.h b/optee_examples/sdm_prog_pubkey/ta/include/sdm_prog_pubkey_ta.h
