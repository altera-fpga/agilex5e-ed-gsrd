+#ifndef USER_TA_HEADER_DEFINES_H
+#define USER_TA_HEADER_DEFINES_H
+
+#include <sdm_cert_auth_ta.h>
+
+#define TA_UUID			TA_SDM_CERT_AUTH_UUID
+
+#define TA_FLAGS		(TA_FLAG_SINGLE_INSTANCE | \
+				 TA_FLAG_MULTI_SESSION | \
+				 TA_FLAG_INSTANCE_KEEP_ALIVE)
+
+#define TA_STACK_SIZE		(2 * 1024)
+
+/*
+ * Heap must hold one TA-local copy of the certificate (max 4 KB) plus
+ * the session context and dev-kit overhead.  32 KB leaves comfortable
+ * headroom while staying frugal vs. the OP-TEE TA heap default.
+ */
+#define TA_DATA_SIZE		(32 * 1024)
