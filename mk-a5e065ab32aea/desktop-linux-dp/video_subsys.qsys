          <ipxact:value>bonusData 
{
   element vid_clk
   {
      datum _sortIndex
      {
         value = "0";
         type = "int";
      }
   }
   element vid_cpm
   {
      datum _sortIndex
      {
         value = "3";
         type = "int";
      }
   }
   element vid_frame_reader
   {
      datum _sortIndex
      {
         value = "2";
         type = "int";
      }
   }
   element vid_rst
   {
      datum _sortIndex
      {
         value = "1";
         type = "int";
      }
   }
}
