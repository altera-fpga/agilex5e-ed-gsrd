diff --git a/optee_examples/sdm_cert_auth/ta/include/sdm_cert_auth_ta.h b/optee_examples/sdm_cert_auth/ta/include/sdm_cert_auth_ta.h
new file mode 100644
index 000000000000..8573dc7625e8
--- /dev/null
+++ b/optee_examples/sdm_cert_auth/ta/include/sdm_cert_auth_ta.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_cert_auth TA - public interface shared with the host.
+ *
+ * Wraps PTA_CMD_SDM_SEND_CERT.  Adds defensive validation of the
+ * Vendor Authorization Boot (VAB) certificate before forwarding it to
+ * the SDM:
+ *
+ *   - parameter types
+ *   - size > 0, <= SDM_CERT_MAX_SIZE, 4-byte aligned
+ *   - size >= VAB_CERT_HEADER_SIZE (otherwise it can't even be a header)
+ *   - NW source memref readable for `size` bytes (TEE_CheckMemoryAccessRights)
+ *   - TOC-TOU copy into TA-local memory
+ *   - sdm_cert_hdr.cert_magic_num     == SDM_CERT_MAGIC_NUM
+ *   - sdm_cert_hdr.d.vab_cert_magic_num == SDM_CERT_MAGIC_NUM
+ *   - sdm_cert_hdr.cert_data_sz is non-zero and inside the buffer
+ *
+ * Layout taken from ATF's socfpga_vab.h (Intel SoCFPGA / Altera):
+ *   offset 0x00: cert_magic_num    (SDM_CERT_MAGIC_NUM)
+ *   offset 0x04: cert_data_sz      (size of the "data" portion in bytes)
+ *   offset 0x08: cert_ver
+ *   offset 0x0C: cert_type
+ *   offset 0x10: vab_cert_magic_num (SDM_CERT_MAGIC_NUM again)
+ *   offset 0x14: flags
+ *   offset 0x18: rsvd[8]
+ *   offset 0x20: fcs_sha384[48]
+ *   offset 0x50: keychain (variable length, max SDM_CERT_MAX_SIZE bytes total)
+ */
+
+#ifndef TA_SDM_CERT_AUTH_H
+#define TA_SDM_CERT_AUTH_H
+
+#include <stdint.h>
+
+/*
+ * UUID for the sdm_cert_auth Trusted Application.
+ * The leading "5ec70000" is a mnemonic for "SECT" (sect of certification).
+ */
+#define TA_SDM_CERT_AUTH_UUID \
+	{ 0x5ec70000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_CERT_AUTH_CMD_SEND - validate and submit a VAB certificate.
+ *
+ * param[0] (in memref)  raw VAB certificate binary (size > 0,
+ *                       <= SDM_CERT_MAX_SIZE, 4-byte aligned)
+ * param[1] (out value)  .a = SDM mailbox error code
+ *                            0 = certificate accepted,
+ *                            non-zero = rejected (or TA validation failed
+ *                            before reaching the SDM; in that case the
+ *                            TA returns a TEE_ERROR_* and .a / .b are 0)
+ *                       .b = SDM response detail word (when .a != 0)
+ * param[2..3] unused
+ *
+ * Result:
+ *   TEE_SUCCESS                  - SDM processed cert; inspect param[1].a
+ *   TEE_ERROR_BAD_PARAMETERS     - bad param types / null / unaligned size
+ *   TEE_ERROR_BAD_FORMAT         - magic / cert_data_sz mismatch
+ *   TEE_ERROR_ACCESS_DENIED      - NW source memref not readable
+ *   TEE_ERROR_OUT_OF_MEMORY      - TA-local copy allocation failed
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_CERT_AUTH_CMD_SEND	0
+
+/*
+ * SDM / VAB certificate constants, re-exported from the PTA header
+ * (pta_sdm_svc.h, ATF socfpga_vab.h) so that NW callers do not need to
+ * pull in OP-TEE OS internal headers.  Suppressed when pta_sdm_svc.h is
+ * also visible (TA build) via its include guard.
+ */
+#ifndef __PTA_SDM_SVC_H
+#define SDM_CERT_MAX_SIZE		4096U
+#endif
+
+/* VAB cert layout constants - these are NOT defined in pta_sdm_svc.h */
+#define SDM_CERT_MAGIC_NUM		0x25D04E7FU
+#define VAB_CERT_HEADER_SIZE		0x50U	/* keychain starts at 0x50 */
+#define VAB_CERT_MIN_SIZE		VAB_CERT_HEADER_SIZE
+
+/*
+ * VAB certificate header layout - mirrors
+ *   struct fcs_hps_vab_certificate_header
+ * in ATF's plat/intel/soc/common/include/socfpga_vab.h.
+ * Total size is exactly VAB_CERT_HEADER_SIZE (0x50) bytes; the variable-
+ * length keychain follows immediately after.
+ */
+struct sdm_cert_hdr {
+	uint32_t cert_magic_num;	/* offset 0x00, must == SDM_CERT_MAGIC_NUM */
+	uint32_t cert_data_sz;		/* offset 0x04, size of "data" portion */
+	uint32_t cert_ver;		/* offset 0x08 */
+	uint32_t cert_type;		/* offset 0x0C */
+	/* struct fcs_hps_vab_certificate_data d at offset 0x10: */
+	uint32_t vab_cert_magic_num;	/* offset 0x10, must == SDM_CERT_MAGIC_NUM */
+	uint32_t flags;			/* offset 0x14 */
+	uint8_t  rsvd0_1[8];		/* offset 0x18..0x1F */
+	uint8_t  fcs_sha384[48];	/* offset 0x20..0x4F */
+	/* offset 0x50: keychain (RSA pubkey + signature, variable length) */
+};
+
+#endif /* TA_SDM_CERT_AUTH_H */
diff --git a/optee_examples/sdm_cert_auth/ta/sdm_cert_auth_ta.c b/optee_examples/sdm_cert_auth/ta/sdm_cert_auth_ta.c
new file mode 100644
index 000000000000..070b94d00f36
--- /dev/null
+++ b/optee_examples/sdm_cert_auth/ta/sdm_cert_auth_ta.c
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_cert_auth Trusted Application.
+ *
+ * Wraps PTA_CMD_SDM_SEND_CERT, adding defensive validation that the
+ * PTA itself does not perform:
+ *
+ *   1. Verify the GP-TEE parameter types.
+ *   2. Verify size >  0, <= SDM_CERT_MAX_SIZE, 4-byte aligned, and at
+ *      least VAB_CERT_HEADER_SIZE bytes.
+ *   3. Verify the NW source buffer is genuinely readable for all
+ *      `size` bytes (TEE_CheckMemoryAccessRights).
+ *   4. Copy the NW input into TA-local memory so subsequent validation
+ *      reads cannot race with a malicious NW thread (TOC-TOU).
+ *   5. Inspect the VAB certificate header against the layout in ATF's
+ *      socfpga_vab.h:
+ *        - cert_magic_num     == SDM_CERT_MAGIC_NUM
+ *        - vab_cert_magic_num == SDM_CERT_MAGIC_NUM
+ *        - cert_data_sz       in (0 .. size - VAB_CERT_HEADER_SIZE]
+ *   6. Forward the validated TA-local copy to PTA_CMD_SDM_SEND_CERT,
+ *      via a TEE_PARAM_TYPE_MEMREF_INPUT parameter.
+ *   7. Propagate the SDM mailbox status (param[1].value.{a,b}) back
+ *      to the host.
+ *   8. Wipe the TA-local copy before TEE_Free so the certificate
+ *      bytes do not linger in recycled heap pages.
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_cert_auth_ta.h>
+
+struct cert_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_cert_auth TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_cert_auth TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct cert_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_cert_auth TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct cert_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_cert_auth TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * VAB certificate header validation
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result validate_vab_header(const struct sdm_cert_hdr *hdr,
+				      size_t cert_size)
+{
+	size_t max_data_sz = 0;
+
+	if (hdr->cert_magic_num != SDM_CERT_MAGIC_NUM) {
+		EMSG("cert hdr: bad cert_magic_num 0x%08x (expected 0x%08x)",
+		     hdr->cert_magic_num, SDM_CERT_MAGIC_NUM);
+		return TEE_ERROR_BAD_FORMAT;
+	}
+
+	if (hdr->vab_cert_magic_num != SDM_CERT_MAGIC_NUM) {
+		EMSG("cert hdr: bad vab_cert_magic_num 0x%08x (expected 0x%08x)",
+		     hdr->vab_cert_magic_num, SDM_CERT_MAGIC_NUM);
+		return TEE_ERROR_BAD_FORMAT;
+	}
+
+	/*
+	 * cert_data_sz is the length of the variable keychain that follows
+	 * the 0x50-byte header.  It must fit inside the buffer the caller
+	 * supplied; if it doesn't, either the cert is truncated or the
+	 * caller is trying to direct the SDM to read past the end of the
+	 * registered shared memory.  Reject both.
+	 */
+	if (hdr->cert_data_sz == 0) {
+		EMSG("cert hdr: cert_data_sz is 0");
+		return TEE_ERROR_BAD_FORMAT;
+	}
+
+	max_data_sz = cert_size - (size_t)VAB_CERT_HEADER_SIZE;
+	if ((size_t)hdr->cert_data_sz > max_data_sz) {
+		EMSG("cert hdr: cert_data_sz %u > buffer remaining %zu",
+		     hdr->cert_data_sz, max_data_sz);
+		return TEE_ERROR_BAD_FORMAT;
+	}
+
+	DMSG("cert hdr OK: cert_data_sz=%u cert_ver=%u cert_type=0x%x",
+	     hdr->cert_data_sz, hdr->cert_ver, hdr->cert_type);
+	return TEE_SUCCESS;
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - validate then forward to PTA_CMD_SDM_SEND_CERT
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_send_cert(struct cert_sess_ctx *ctx,
+			       uint32_t param_types, TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_MEMREF_INPUT,
+						TEE_PARAM_TYPE_VALUE_OUTPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	void *ns_cert = NULL;
+	size_t cert_size = 0;
+	void *local_cert = NULL;
+	const struct sdm_cert_hdr *hdr = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	/* Zero the host's output before any return; populated by the PTA */
+	params[1].value.a = 0;
+	params[1].value.b = 0;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	ns_cert   = params[0].memref.buffer;
+	cert_size = params[0].memref.size;
+
+	if (!ns_cert || cert_size == 0 || cert_size > SDM_CERT_MAX_SIZE) {
+		EMSG("bad cert memref: buf=%p size=%zu (max %u)",
+		     ns_cert, cert_size, SDM_CERT_MAX_SIZE);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	if (cert_size & 0x3U) {
+		EMSG("cert size %zu not 4-byte aligned", cert_size);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	if (cert_size < (size_t)VAB_CERT_HEADER_SIZE) {
+		EMSG("cert size %zu < VAB_CERT_HEADER_SIZE (%u)",
+		     cert_size, (unsigned)VAB_CERT_HEADER_SIZE);
+		return TEE_ERROR_BAD_FORMAT;
+	}
+
+	/*
+	 * Verify the NW source memref is genuinely readable for the full
+	 * size before we touch any byte through it.  Converts a hypothetical
+	 * "lying memref size / unmapped page" condition into a clean
+	 * TEE_ERROR_ACCESS_DENIED instead of a secure-world fault during
+	 * the copy below.
+	 */
+	res = TEE_CheckMemoryAccessRights(TEE_MEMORY_ACCESS_READ |
+					  TEE_MEMORY_ACCESS_ANY_OWNER,
+					  ns_cert, cert_size);
+	if (res != TEE_SUCCESS) {
+		EMSG("cert memref not readable: buf=%p size=%zu res=0x%08x",
+		     ns_cert, cert_size, res);
+		return res;
+	}
+
+	/*
+	 * Copy the NW certificate into TA-local memory so the validation
+	 * below operates on bytes that the NW caller cannot mutate after
+	 * the fact (TOC-TOU protection).
+	 */
+	local_cert = TEE_Malloc(cert_size, 0);
+	if (!local_cert) {
+		EMSG("alloc local_cert (%zu) failed", cert_size);
+		return TEE_ERROR_OUT_OF_MEMORY;
+	}
+
+	TEE_MemMove(local_cert, ns_cert, cert_size);
+
+	hdr = (const struct sdm_cert_hdr *)local_cert;
+	res = validate_vab_header(hdr, cert_size);
+	if (res != TEE_SUCCESS) {
+		/* Wipe the rejected cert before returning the heap memory */
+		TEE_MemFill(local_cert, 0, cert_size);
+		TEE_Free(local_cert);
+		return res;
+	}
+
+	DMSG("sdm_cert_auth: validated (%zu bytes), forwarding to PTA",
+	     cert_size);
+
+	/*
+	 * Forward to PTA_CMD_SDM_SEND_CERT.  We pass the TA-local copy as
+	 * a MEMREF_INPUT so the PTA reads from a buffer the NW cannot
+	 * change in flight; the PTA in turn places it into a TZDRAM
+	 * bounce buffer for the SDM mailbox.
+	 */
+	pta_params[0].memref.buffer = local_cert;
+	pta_params[0].memref.size   = cert_size;
+	/* pta_params[1] (VALUE_OUTPUT) is zero-initialised */
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_SEND_CERT, exp_pt,
+				  pta_params, &pta_origin);
+
+	/* Propagate SDM mailbox result to the host even on errors */
+	params[1].value.a = pta_params[1].value.a;
+	params[1].value.b = pta_params[1].value.b;
+
+	/*
+	 * Wipe local_cert before returning it to the heap.  A VAB
+	 * certificate carries an RSA signature and possibly customer
+	 * key material; don't leave it sitting in recycled pages.
+	 */
+	TEE_MemFill(local_cert, 0, cert_size);
+	TEE_Free(local_cert);
+
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_SEND_CERT failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_cert_auth: SDM response mbox_err=0x%08x detail=0x%08x",
+	     params[1].value.a, params[1].value.b);
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct cert_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_CERT_AUTH_CMD_SEND:
+		return do_send_cert(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
