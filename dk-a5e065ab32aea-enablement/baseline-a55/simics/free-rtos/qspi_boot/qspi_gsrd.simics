# Boot images
$fsbl_image_filename = "bl2.bin"
$qspi_image_filename = "qspi_image_jic.rpd"

# Single-core FreeRTOS boot
$hps_boot_core = 0
$hps_core0_1_power_on = TRUE
$hps_core2_power_on = FALSE
$hps_core3_power_on = FALSE

# Disable unused storage / network peripherals
$create_hps_sd_card = FALSE
$create_hps_mmc = FALSE
$create_hps_eth0_network = FALSE
$create_hps_serial0_console = TRUE
$create_hps_serial1_console = FALSE
$stepping = "B0"

run-command-file "targets/agilex5e-universal/agilex5e-universal.simics"
