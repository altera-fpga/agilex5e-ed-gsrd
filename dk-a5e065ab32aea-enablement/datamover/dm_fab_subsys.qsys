                &lt;type&gt;reset&lt;/type&gt;
                &lt;isStart&gt;false&lt;/isStart&gt;
                &lt;ports&gt;
                    &lt;port&gt;
                        &lt;name&gt;aresetn&lt;/name&gt;
                        &lt;role&gt;reset_n&lt;/role&gt;
