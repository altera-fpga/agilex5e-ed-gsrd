::drc::add_waiver \
	-description {The register ready_done in the ace5lite_cache_coherency_translator s_axi_agent exhibits high timing path endpoint tension due to how the Quartus fitter routes its high fanout connections. This is intermittent and does not indicate a functional or timing violation.} \
	-rule_id {TMC-20602} \
	-query_string {"Register Name" =~ '.*ace5lite_cache_coherency_translator_s_axi_agent\|ready_done.*'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2026-06-09*10:00:00} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {VDS: Waive HPS IP SDC false path that has no valid targets in this design configuration.} \
