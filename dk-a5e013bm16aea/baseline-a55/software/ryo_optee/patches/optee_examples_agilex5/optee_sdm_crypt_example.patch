diff --git a/optee_examples/sdm_crypt/ta/include/sdm_crypt_ta.h b/optee_examples/sdm_crypt/ta/include/sdm_crypt_ta.h
new file mode 100644
index 000000000000..464aaf8bbb9b
--- /dev/null
+++ b/optee_examples/sdm_crypt/ta/include/sdm_crypt_ta.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_crypt TA - public interface shared with the host.
+ *
+ * This Trusted Application is a wrapper around the SDM Services
+ * Pseudo-TA's PTA_CMD_SDM_SDOS_CRYPT.  Unlike the chip-id / id-code
+ * wrappers, the SDOS request has a non-trivial input layout, so the TA
+ * defensively validates the SDOS header and the buffer sizes BEFORE
+ * forwarding the request.  The input is copied into TA-local memory
+ * prior to validation to avoid TOC-TOU re-reads from NW shared memory.
+ *
+ * The host is responsible for constructing the encrypt-input SDOS header
+ * (it knows the owner_id / srk_index / plaintext); the TA only verifies
+ * that what arrives matches the SDOS layout specified in the Security
+ * Methodology UG, Table 49.
+ */
+
+#ifndef TA_SDM_CRYPT_H
+#define TA_SDM_CRYPT_H
+
+#include <stdint.h>
+
+/*
+ * UUID for the sdm_crypt Trusted Application.
+ *
+ * The leading "5d05" is a mnemonic for "SDOS".  This UUID is the binary
+ * name of the .ta file.
+ */
+#define TA_SDM_CRYPT_UUID \
+	{ 0x5d050000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * Direction values for param[0].value.a, matching the PTA's encoding so
+ * the TA can pass the value through unchanged.
+ */
+#define TA_SDM_CRYPT_DIR_DECRYPT	0
+#define TA_SDM_CRYPT_DIR_ENCRYPT	1
+
+/*
+ * TA_SDM_CRYPT_CMD_RUN - Run an SDOS encrypt or decrypt operation.
+ *
+ * param[0] (in value)
+ *   .a = direction: TA_SDM_CRYPT_DIR_ENCRYPT (1) or TA_SDM_CRYPT_DIR_DECRYPT (0)
+ *   .b = unused
+ * param[1] (in memref)  Fully-formatted SDOS input buffer (see layouts below)
+ * param[2] (out memref) Output buffer, pre-allocated by caller
+ *                       On success, memref.size is updated to the actual
+ *                       number of bytes written.
+ * param[3] unused
+ *
+ * Encrypt input layout:
+ *   [sdos_hdr (40 bytes)] [plaintext] [zero-padding (SDOS_PAD_LEN bytes)]
+ *   size = SDOS_HDR_SIZE + data_len
+ * Encrypt output size:
+ *   SDOS_HDR_SIZE + data_len + SDOS_HMAC_SIZE
+ *
+ * Decrypt input layout:
+ *   [sdos_hdr (40 bytes)] [ciphertext + padding] [HMAC (48 bytes)]
+ *   size = SDOS_HDR_SIZE + data_len + SDOS_HMAC_SIZE
+ * Decrypt output size:
+ *   SDOS_HDR_SIZE + data_len   (header + plaintext + padding)
+ *
+ * Result:
+ *   TEE_SUCCESS                  - operation completed; out memref.size set
+ *   TEE_ERROR_BAD_PARAMETERS     - param type / size / direction / null check
+ *   TEE_ERROR_BAD_FORMAT         - sdos_hdr magic / hdr_pad / data_len / iv invalid
+ *   TEE_ERROR_SHORT_BUFFER       - output memref too small for the operation
+ *   TEE_ERROR_OUT_OF_MEMORY      - TA-local copy allocation failed
+ *   TEE_ERROR_GENERIC / TEE_ERROR_BUSY
+ *                                - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_CRYPT_CMD_RUN		0
+
+/* ---------------------------------------------------------------------------
+ * SDOS layout constants & sdos_hdr structure
+ *
+ * Re-exported from the SDM PTA (pta_sdm_svc.h) so that NW callers of this
+ * TA do not need to pull in OP-TEE OS internal headers.  When this header
+ * is consumed inside the TA (which also includes pta_sdm_svc.h from the
+ * TA dev kit) the duplicated definitions are suppressed via the PTA
+ * header's include guard.  Keep these values in sync with the PTA.
+ * ---------------------------------------------------------------------------
+ */
+
+#ifndef __PTA_SDM_SVC_H
+
+#define SDOS_HDR_SIZE			40
+#define SDOS_HMAC_SIZE			48
+#define SDOS_ENCRYPT_IN_MAGIC		0xACBDBDEDU
+#define SDOS_ENCRYPT_OUT_MAGIC		0x53424212U
+#define SDOS_HDR_PAD_MAGIC		0x01020304U
+
+/* Zero when n is already a multiple of 32, else (32 - n%32). Range [0..31]. */
+#define SDOS_PAD_LEN(n)			(((n) % 32) ? (32 - ((n) % 32)) : 0)
+
+/* data_len (= plaintext + padding) must lie in this range. */
+#define SDOS_MIN_DATA_LEN		32U
+#define SDOS_MAX_DATA_LEN		(32U * 1024U - 96U)	/* 32,672 bytes */
+
+#define SDOS_FLAGS(asoi, srk_index, pad_len) \
+	(((uint32_t)(asoi) << 16) | \
+	 ((uint32_t)(srk_index) << 8) | \
+	 (uint32_t)(pad_len))
+
+/*
+ * SDOS 40-byte header - placed at offset 0 of the encrypt/decrypt buffer.
+ * Fields are little-endian 32-bit words; total size is exactly SDOS_HDR_SIZE.
+ */
+struct sdos_hdr {
+	uint32_t magic;		/* SDOS_ENCRYPT_IN_MAGIC or SDOS_ENCRYPT_OUT_MAGIC */
+	uint32_t data_len;	/* plaintext_len + pad_len  (multiple of 32) */
+	uint32_t flags;		/* SDOS_FLAGS(asoi, srk_index, pad_len) */
+	uint32_t owner_id[2];	/* 8-byte owner ID, little-endian */
+	uint32_t hdr_pad;	/* must be SDOS_HDR_PAD_MAGIC (0x01020304) */
+	uint32_t iv[4];		/* {0} on encrypt input, filled by SDM on output */
+};
+
+#endif /* __PTA_SDM_SVC_H */
+
+/* Always-available helper - extracts pad_len from sdos_hdr.flags */
+#define SDOS_FLAGS_PAD_LEN(flags)	((uint32_t)(flags) & 0xFFU)
+
+#endif /* TA_SDM_CRYPT_H */
