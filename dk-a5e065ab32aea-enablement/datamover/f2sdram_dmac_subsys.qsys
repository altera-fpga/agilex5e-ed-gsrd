   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stopped&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set when mSGDMA is programmed to stop manually, or when the dispatcher is programmed to stop on errors or early termination.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;5&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;5&amp;lt;/msb&amp;gt;
