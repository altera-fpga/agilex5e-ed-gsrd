diff --git a/optee_examples/sdm_ns_allowed_list_remove/ta/include/sdm_ns_allowed_list_remove_ta.h b/optee_examples/sdm_ns_allowed_list_remove/ta/include/sdm_ns_allowed_list_remove_ta.h
new file mode 100644
index 000000000000..fb84743ae226
--- /dev/null
+++ b/optee_examples/sdm_ns_allowed_list_remove/ta/include/sdm_ns_allowed_list_remove_ta.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_ns_allowed_list_remove TA - public interface shared with the host.
+ *
+ * Side-effect-only wrapper around PTA_CMD_SDM_NS_ALLOWED_LIST_REMOVE.
+ *
+ * The TA accepts a single 32-bit SiP SMC function-ID from the Non-Secure
+ * caller, validates that it looks like a well-formed SiP FID, then asks
+ * the PTA to send ALTERA_SIP_SMC_NS_ALLOWED_LIST_REMOVE (0x4200017F) to
+ * ATF.  After a successful call, that FID is no longer accepted from the
+ * Non-Secure world for the remainder of the current power cycle; the
+ * whitelist is re-installed at the next OP-TEE boot.
+ *
+ * Each FID is a complete 32-bit ARM SMCCC function ID (the FID Linux /
+ * U-Boot would issue via smc/hvc), NOT a raw SDM mailbox opcode.
+ *
+ * Examples:
+ *   ALTERA_SIP_SMC_ASYNC_GET_IDCODE  = 0x420000D3
+ *   ALTERA_SIP_SMC_ASYNC_FCS_CHIP_ID = 0x42000135
+ *   ALTERA_SIP_SMC_NS_ALLOWED_LIST_DEACTIVATE = 0x42000181 (CAUTION)
+ */
+
+#ifndef TA_SDM_NS_ALLOWED_LIST_REMOVE_H
+#define TA_SDM_NS_ALLOWED_LIST_REMOVE_H
+
+/*
+ * TA UUID.  Mnemonic "DE1E" = DELEte (1 FID at a time), suffix 0000 to
+ * keep room for future variants while staying in the SDM TA family
+ * suffix (-7b2a-4e5d-9c1a-100c012ec01d).
+ */
+#define TA_SDM_NS_ALLOWED_LIST_REMOVE_UUID \
+	{ 0xde1e0000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_NS_ALLOWED_LIST_REMOVE_CMD_APPLY - revoke one SiP FID from the
+ *                                           NS allowed list.
+ *
+ * GP-TEE param convention:
+ *   param[0] VALUE_INPUT
+ *     .a = 32-bit SiP SMC function ID to remove
+ *     .b = reserved, must be 0
+ *   param[1..3] NONE
+ *
+ * Result:
+ *   TEE_SUCCESS                  - SDM/ATF accepted the remove
+ *   TEE_ERROR_BAD_PARAMETERS     - wrong param types, non-zero .b,
+ *                                  or FID failed SMCCC sanity check
+ *   TEE_ERROR_BUSY               - SiP reported busy / secure-only
+ *   TEE_ERROR_GENERIC            - forwarded from PTA / ATF
+ */
+#define TA_SDM_NS_ALLOWED_LIST_REMOVE_CMD_APPLY	0
+
+#endif /* TA_SDM_NS_ALLOWED_LIST_REMOVE_H */
diff --git a/optee_examples/sdm_ns_allowed_list_remove/ta/sdm_ns_allowed_list_remove_ta.c b/optee_examples/sdm_ns_allowed_list_remove/ta/sdm_ns_allowed_list_remove_ta.c
new file mode 100644
index 000000000000..68d09e625949
--- /dev/null
+++ b/optee_examples/sdm_ns_allowed_list_remove/ta/sdm_ns_allowed_list_remove_ta.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_ns_allowed_list_remove Trusted Application.
+ *
+ * Wrapper around PTA_CMD_SDM_NS_ALLOWED_LIST_REMOVE.
+ *
+ * The TA accepts a single 32-bit SiP SMC function-ID from the host,
+ * sanity-checks the FID against the ARM SMCCC encoding for SiP calls,
+ * emits a banner-style audit record, and forwards the request to the
+ * PTA - which in turn issues ALTERA_SIP_SMC_NS_ALLOWED_LIST_REMOVE
+ * (0x4200017F) to ATF to revoke that FID for Non-Secure callers.
+ *
+ * Validation performed:
+ *   1. GP-TEE parameter types: VALUE_INPUT, NONE, NONE, NONE.
+ *   2. params[0].value.b == 0 (reserved bits).
+ *   3. params[0].value.a is a well-formed ARM SMCCC SiP FID:
+ *        - OEN (bits 29:24) must be 0x02 (SiP service)
+ *        - Reserved bits (23:16) must be zero (MBZ per SMCCC)
+ *   4. PTA_SDM_SVC session is open (established at TA_OpenSession).
+ *
+ * The TA does NOT block specific FIDs - removing critical ones (e.g.
+ * 0x42000181 NS_ALLOWED_LIST_DEACTIVATE, U-Boot helpers like
+ * 0xC200003D, 0xC2000009) is a legitimate runtime-policy choice for
+ * post-provisioning lockdown.  It does, however, log such removals
+ * loudly so they are never silent.
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_ns_allowed_list_remove_ta.h>
+
+/* ARM SMCCC bit layout (relevant subset) */
+#define SMCCC_OEN_MASK		((uint32_t)0x3F << 24)
+#define SMCCC_OEN_SHIFT		24
+#define SMCCC_OEN_SIP		0x02
+#define SMCCC_RESERVED_MASK	((uint32_t)0xFF << 16)
+
+struct nsalr_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_ns_allowed_list_remove TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_ns_allowed_list_remove TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct nsalr_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_ns_allowed_list_remove TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct nsalr_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_ns_allowed_list_remove TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * FID validation helpers
+ * ---------------------------------------------------------------------------
+ */
+
+/*
+ * is_well_formed_sip_fid - verify the supplied FID encodes a SiP service
+ * per the ARM SMCCC specification.
+ *
+ *   Bit 31      : Fast (1) or Yielding (0) call - both valid.
+ *   Bit 30      : SMC32 (0) or SMC64 (1) - both valid.
+ *   Bits 29:24  : Owning Entity Number - must be 0x02 (SiP).
+ *   Bits 23:16  : Reserved - must be zero (MBZ per SMCCC).
+ *   Bits 15:0   : Function number - any value accepted.
+ *
+ * Returns true for legal SiP FIDs, false otherwise.
+ */
+static bool is_well_formed_sip_fid(uint32_t fid)
+{
+	uint32_t oen = (fid & SMCCC_OEN_MASK) >> SMCCC_OEN_SHIFT;
+
+	if (oen != SMCCC_OEN_SIP)
+		return false;
+	if (fid & SMCCC_RESERVED_MASK)
+		return false;
+
+	return true;
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - validate, audit, forward to PTA
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_ns_allowed_list_remove(struct nsalr_sess_ctx *ctx,
+					    uint32_t param_types,
+					    TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t fid = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x (expected VALUE_INPUT, NONE, NONE, NONE)",
+		     param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	if (params[0].value.b != 0) {
+		EMSG("param[0].value.b must be 0 (got 0x%08x)",
+		     params[0].value.b);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	fid = params[0].value.a;
+
+	if (!is_well_formed_sip_fid(fid)) {
+		EMSG("0x%08" PRIx32 " is not a well-formed SiP FID "
+		     "(need OEN=0x02 and bits[23:16]=0)", fid);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	pta_params[0].value.a = fid;
+	pta_params[0].value.b = 0;
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_NS_ALLOWED_LIST_REMOVE, exp_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_NS_ALLOWED_LIST_REMOVE failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_ns_allowed_list_remove: SDM accepted (FID=0x%08" PRIx32 ")",
+	     fid);
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct nsalr_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_NS_ALLOWED_LIST_REMOVE_CMD_APPLY:
+		return do_ns_allowed_list_remove(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
