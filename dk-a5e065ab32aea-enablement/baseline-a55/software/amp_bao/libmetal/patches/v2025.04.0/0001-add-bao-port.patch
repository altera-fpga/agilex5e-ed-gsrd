+/*
+ * @file	freertos/bao/sys.h
+ * @brief	Bao + FreeRTOS machine-specific libmetal port.
+ *
+ * This header is pulled in by the libmetal-template-generated
+ * lib/system/freertos/sys.h via:
+ *
+ *     #include "./@PROJECT_MACHINE@/sys.h"
+ *
+ * with PROJECT_MACHINE=bao. Keep it minimal -- the machine-specific
+ * hooks (cache flush/invalidate, IRQ save/restore, io_mem_map) live in
+ * sys.c. We only declare what the libmetal headers need to see at
+ * compile time.
+ */
+
+#ifndef __METAL_FREERTOS_SYS__H__
+#error "Include metal/sys.h instead of metal/freertos/bao/sys.h"
+#endif
+
+#ifndef __METAL_FREERTOS_BAO_SYS__H__
+#define __METAL_FREERTOS_BAO_SYS__H__
+
+#include <metal/cpu.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void sys_irq_enable(unsigned int vector);
+void sys_irq_disable(unsigned int vector);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __METAL_FREERTOS_BAO_SYS__H__ */
diff --git a/lib/system/freertos/bao/sys.c b/lib/system/freertos/bao/sys.c
new file mode 100644
index 0000000..bd9e10c
--- /dev/null
+++ b/lib/system/freertos/bao/sys.c
@@ -0,0 +1,143 @@
+/*
+ * Copyright (c) 2026, Bao Project Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * @file	freertos/bao/sys.c
+ * @brief	Bao + FreeRTOS machine-specific libmetal port implementation.
+ *
+ * Hooks libmetal calls into. Kept tiny -- the heavy lifting (HVC kicks,
+ * vIRQ 52 ISR registration, shmem io_region init) lives in the
+ * rpmsg_console sample under libmetal_bao/metal_bao.c. This file only
+ * carries primitives libmetal itself reaches for through the freertos
+ * machine-port abstraction.
+ */
+
+#include <metal/io.h>
+#include <metal/sys.h>
+#include <metal/utilities.h>
+#include <stdint.h>
+
+#include <FreeRTOS.h>
+#include <task.h>
+
+/* AARCH64-port FreeRTOS exposes vPortEnterCritical / vPortExitCritical
+ * in portmacro.h. They track a nesting counter and mask interrupts via
+ * DAIF.I, then un-mask only when the outermost critical-section exit
+ * fires. Use them as libmetal's irq save/restore primitive: the
+ * returned "flags" is just an opaque token we pass back to satisfy
+ * the libmetal contract -- the actual state is held by the nesting
+ * counter inside the port. This FreeRTOS port intentionally
+ * does NOT export uxPortSetInterruptMask / vPortClearInterruptMask
+ * (which would be portCMSIS_BASEPRI-style mask APIs); vPortEnter/Exit
+ * Critical are the documented per-port equivalents on AArch64.
+ */
+extern void vPortEnterCritical(void);
+extern void vPortExitCritical(void);
+
+unsigned int sys_irq_save_disable(void)
+{
+    vPortEnterCritical();
+    return 0U;
+}
+
+void sys_irq_restore_enable(unsigned int flags)
+{
+    (void)flags;
+    vPortExitCritical();
+}
+
+/* libmetal's irq-controller layer can ask to enable / disable a specific
+ * IRQ vector. We don't use that path on Bao: the single kick IRQ
+ * (vIRQ 52 = bao->ipcs[0].interrupts[*]) is registered + enabled once
+ * at libmetal_bao_init() time via the freertos-socfpga interrupt_register_isr +
+ * interrupt_spi_enable. Leave these as no-ops so any future libmetal
+ * code path that pokes the IRQ controller through the generic API
+ * remains harmless. */
+void sys_irq_enable(unsigned int vector)
+{
+    metal_unused(vector);
+}
+
+void sys_irq_disable(unsigned int vector)
+{
+    metal_unused(vector);
+}
+
+/*
+ * Cache management. The Bao IPC shmem at IPA 0xC4000000 is mapped
+ * Normal Cacheable WB outer-shareable in both VMs' stage-1 page tables.
+ * Cache lines must be pushed back to DRAM before the peer reads them
+ * (and invalidated before we read what the peer wrote). The 64-byte
+ * line size matches the ARM Cortex-A55 / A76 L1 D$ on Agilex5 HPS.
+ *
+ * This is the same primitive resource_table.c's cache_clean_range()
+ * uses for the boot-time table publish, just generalised into the
+ * libmetal cache API surface so OpenAMP's virtio code can call it for
+ * descriptor / vring updates.
+ */
+#define CL_BYTES   64U
+#define CL_MASK    ((uintptr_t)(CL_BYTES - 1U))
+
+void metal_machine_cache_flush(void *addr, unsigned int len)
+{
+    if ((addr == NULL) && (len == 0U)) {
+        /* libmetal API: NULL/0 means flush the whole D$. We don't
+         * implement the "whole cache" sweep -- OpenAMP never asks for
+         * it, and a full flush at EL1 would be a `dc cisw` loop over
+         * level/way pairs which is fragile to misuse. */
+        return;
+    }
+    uintptr_t start = (uintptr_t)addr & ~CL_MASK;
+    uintptr_t end   = ((uintptr_t)addr + (uintptr_t)len + CL_BYTES - 1U)
+                      & ~CL_MASK;
+    for (uintptr_t p = start; p < end; p += CL_BYTES) {
+        __asm__ volatile ("dc cvac, %0" : : "r" (p) : "memory");
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void metal_machine_cache_invalidate(void *addr, unsigned int len)
+{
+    if ((addr == NULL) && (len == 0U)) {
+        return;
+    }
+    uintptr_t start = (uintptr_t)addr & ~CL_MASK;
+    uintptr_t end   = ((uintptr_t)addr + (uintptr_t)len + CL_BYTES - 1U)
+                      & ~CL_MASK;
+    for (uintptr_t p = start; p < end; p += CL_BYTES) {
+        __asm__ volatile ("dc ivac, %0" : : "r" (p) : "memory");
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Default poll hook -- libmetal calls this from blocking waits to
+ * yield CPU until an event arrives. Issue `wfe` so a tight rpmsg poll
+ * loop drops to the low-power wait-for-event state instead of burning
+ * CPU; the kick ISR ends in `sev` (delivered by Bao's vIRQ injection)
+ * to wake the core.
+ */
+void metal_generic_default_poll(void)
+{
+    __asm__ volatile ("wfe" ::: "memory");
+}
+
+/*
+ * Identity io_mem_map. The shmem region is already mapped by both Bao
+ * (stage-2) and the FreeRTOS port (stage-1). libmetal's io_region
+ * carries (va, pa) tuples; we just return the va untouched so
+ * subsequent metal_io_read / write land at the right address without
+ * libmetal stepping into a page-table modification path it doesn't
+ * need.
+ */
+void *metal_machine_io_mem_map(void *va, metal_phys_addr_t pa,
+                               size_t size, unsigned int flags)
+{
+    metal_unused(pa);
+    metal_unused(size);
+    metal_unused(flags);
+    return va;
+}
