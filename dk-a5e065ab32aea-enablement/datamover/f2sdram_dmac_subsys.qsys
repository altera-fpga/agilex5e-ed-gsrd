   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;irq&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set when interrupt condition occurs.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;9&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;9&amp;lt;/msb&amp;gt;
