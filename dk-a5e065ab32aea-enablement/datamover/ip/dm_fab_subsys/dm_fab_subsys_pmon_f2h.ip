                  <ipxact:description>Unit State is addressed through000  MSR space001  MMIO space010  PCICFG space</ipxact:description>
                  <ipxact:bitOffset>29</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x1</ipxact:value>
                      <ipxact:mask>0x7</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>3</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UCADR_L</ipxact:name>
                <ipxact:displayName>PMON_UCADR_L</ipxact:displayName>
                <ipxact:description>Unit Control Address Register</ipxact:description>
                <ipxact:addressOffset>0x8</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-only</ipxact:access>
                <ipxact:field>
                  <ipxact:name>UCAddress_L</ipxact:name>
                  <ipxact:displayName>UCAddress_L</ipxact:displayName>
                  <ipxact:description>Base Address[31:0] to Unit Control and Status Register &amp; Counter Control and Counter Data registers PMON_UCTRL, PMON_USTS, PMON_UCCTL, PMON_UCDATAThis an absolute address not on offset and should be set at intialization.</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00000118</ipxact:value>
                      <ipxact:mask>0xffffffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>32</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UCADR_H</ipxact:name>
                <ipxact:displayName>PMON_UCADR_H</ipxact:displayName>
                <ipxact:description>Unit Control Address Register</ipxact:description>
                <ipxact:addressOffset>0xc</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-only</ipxact:access>
                <ipxact:field>
                  <ipxact:name>UCAddress_H</ipxact:name>
                  <ipxact:displayName>UCAddress_H</ipxact:displayName>
                  <ipxact:description>Base Address[63:32] to Unit Control and Status Register &amp; Counter Control and Counter Data registers PMON_UCTRL, PMON_USTS, PMON_UCCTL, PMON_UCDATA</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00000000</ipxact:value>
                      <ipxact:mask>0xffffffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>32</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UIDT_L</ipxact:name>
                <ipxact:displayName>PMON_UIDT_L</ipxact:displayName>
                <ipxact:description>Unit ID Type Register</ipxact:description>
                <ipxact:addressOffset>0x10</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-only</ipxact:access>
                <ipxact:field>
                  <ipxact:name>UnitType</ipxact:name>
                  <ipxact:displayName>UnitType</ipxact:displayName>
                  <ipxact:description>What kind of Unit is this PMON block associated with?Each Unit of a Unit Type will have the same events available or capture and same uArch specific performance monitoring HW available.16h'0 - AXI4</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0000</ipxact:value>
                      <ipxact:mask>0xffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>16</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>UnitID</ipxact:name>
                  <ipxact:displayName>UnitID</ipxact:displayName>
                  <ipxact:description>Which # of Unit TypeFor cases where there are more than 1 instance of a particular Unit, this IDs the specific PMON block for the Unit Type.</ipxact:description>
                  <ipxact:bitOffset>16</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0000</ipxact:value>
                      <ipxact:mask>0xffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>16</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UIDT_H</ipxact:name>
                <ipxact:displayName>PMON_UIDT_H</ipxact:displayName>
                <ipxact:description>Unit ID Type Register</ipxact:description>
                <ipxact:addressOffset>0x14</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-only</ipxact:access>
                <ipxact:field>
                  <ipxact:name>GblStatPosition</ipxact:name>
                  <ipxact:displayName>GblStatPosition</ipxact:displayName>
                  <ipxact:description>16b field to tell SW which bit in the Global Status belongs to this PMON unit block.</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0000</ipxact:value>
                      <ipxact:mask>0xffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>16</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>16</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0000</ipxact:value>
                      <ipxact:mask>0xffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>16</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UCTRL_L</ipxact:name>
                <ipxact:displayName>PMON_UCTRL_L</ipxact:displayName>
                <ipxact:description>Unit Control Register</ipxact:description>
                <ipxact:addressOffset>0x18</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-write</ipxact:access>
                <ipxact:field>
                  <ipxact:name>Freeze</ipxact:name>
                  <ipxact:displayName>Freeze</ipxact:displayName>
                  <ipxact:description>Freeze.If set to 1 the Counter Data registers in this unit block will be frozen.</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>1</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00</ipxact:value>
                      <ipxact:mask>0x7f</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>7</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Rst_Ctrl</ipxact:name>
                  <ipxact:displayName>Rst_Ctrl</ipxact:displayName>
                  <ipxact:description>Reset Counter Control registers.When set to 1, the Counter Control Registers in this unit block will be reset to 0</ipxact:description>
                  <ipxact:bitOffset>8</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Rst_Cntr</ipxact:name>
                  <ipxact:displayName>Rst_Cntr</ipxact:displayName>
                  <ipxact:description>Reset Counter Data registers.When set to 1, the Counter Data Registers in this unit block will be reset to 0.</ipxact:description>
                  <ipxact:bitOffset>9</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd1</ipxact:name>
                  <ipxact:displayName>rsvd1</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>10</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x000000</ipxact:value>
                      <ipxact:mask>0x3fffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>22</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UCTRL_H</ipxact:name>
                <ipxact:displayName>PMON_UCTRL_H</ipxact:displayName>
                <ipxact:description>Unit Control Register</ipxact:description>
                <ipxact:addressOffset>0x1c</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-write</ipxact:access>
                <ipxact:field>
                  <ipxact:name>ID_enable</ipxact:name>
                  <ipxact:displayName>ID_enable</ipxact:displayName>
                  <ipxact:description>Enable ID filterWhen 0 ignore ID filtering regardless of the ID value. 
                               All events will increment ignoring ID.</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>ID_value</ipxact:name>
                  <ipxact:displayName>ID_value</ipxact:displayName>
                  <ipxact:description>Increment on ID MatchWhen ID enable is !0 the counters should only increment if the ID passed to the unit monitor matches the value in this field. 
                               For events that lack correlating IDs they will increment ignoring ID filter.</ipxact:description>
                  <ipxact:bitOffset>1</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00000</ipxact:value>
                      <ipxact:mask>0x3ffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>18</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>19</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0000</ipxact:value>
                      <ipxact:mask>0x1fff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>13</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_USTS_L</ipxact:name>
                <ipxact:displayName>PMON_USTS_L</ipxact:displayName>
                <ipxact:description>Unit Status Register</ipxact:description>
                <ipxact:addressOffset>0x20</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-write</ipxact:access>
                <ipxact:field>
                  <ipxact:name>Cntr_Ov</ipxact:name>
                  <ipxact:displayName>Cntr_Ov</ipxact:displayName>
                  <ipxact:description>Counter OverflowIf an overflow is detected from the corresponding data register, its overflow bit will be set.Note: Write of 1 will clear the bit.</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00</ipxact:value>
                      <ipxact:mask>0xff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>8</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                  <ipxact:modifiedWriteValue>oneToClear</ipxact:modifiedWriteValue>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>8</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x000000</ipxact:value>
                      <ipxact:mask>0xffffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>24</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_USTS_H</ipxact:name>
                <ipxact:displayName>PMON_USTS_H</ipxact:displayName>
                <ipxact:description>Unit Status Register</ipxact:description>
                <ipxact:addressOffset>0x24</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-only</ipxact:access>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00000000</ipxact:value>
                      <ipxact:mask>0xffffffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>32</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UCCTL_L_0</ipxact:name>
                <ipxact:displayName>PMON_UCCTL_L_0</ipxact:displayName>
                <ipxact:description>Unit Counter Control Register</ipxact:description>
                <ipxact:addressOffset>0x28</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-write</ipxact:access>
                <ipxact:field>
                  <ipxact:name>Evnt_Sel</ipxact:name>
                  <ipxact:displayName>Evnt_Sel</ipxact:displayName>
                  <ipxact:description>Event Select for the Counter Data RegisterIf an event has subevents they will be listed in the umask description and marked with *If no subevents are set the counter will increment if any subevent has its conditions met.00: COUNTER_IDLE01: CLOCK_TICKS02: CLOCK_TICKS_AR2AR03: CLOCK_TICKS_R2R04: CLOCK_TICKS_AW2AW05: CLOCK_TICKS_W2W06: CLOCK_TICKS_B2B07: CLOCK_TICKS_AR2R08: CLOCK_TICKS_AWW2B09: CLOCK_TICKS_ARAWW2RB0A - 0F: RESERVED10: READ_OCCUPANCY*11: READ_CMD_LENGTH12: READ_CMD_BYTES13:TOTAL_READ_LATENCY14 - 17 : RESERVED18: WRITE_OCCUPANCY*19: RESPONSE_OCCUPANCY*1A: WRITE_CMD_LENGTH1B: WRITE_CMD_BYTES1C: TOTAL_WRITE_LATENCY1D - EF: RESERVEDF0: CLOCK_TICKS_OVFLF1 - FE: RESERVEDFF: PMON_LAT_DEBUG_EVENT</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00</ipxact:value>
                      <ipxact:mask>0xff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>8</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Umask</ipxact:name>
                  <ipxact:displayName>Umask</ipxact:displayName>
                  <ipxact:description>For additional IP specific encoding space  often used as a subevent mask.Set to 1 the bits listed for the subevents of the event you have configured.If a bit is not listed for a specfic event set the bit to 0.For events with no subevents this field must be set to 0.READ_OCCUPANCY:0: ARVALID=1 &amp; ARREADY=11: ARVALID=02: ARVALID=1 &amp; ARREADY=03: RVALID=1 &amp; RREADY=14: RVALID=05: RVALID=0 &amp; RREADY=1WRITE_OCCUPANCY:0: AWVALID=1 &amp; AWREADY=11: AWVALID=02: AWVALID=1 &amp; AWREADY=03: WVALID=1 &amp; WREADY=14: WVALID=05: WVALID=0 &amp; WREADY=1RESPONSE_OCCUPANCY:0: BVALID=1 &amp; BREADY=11: BVALID=02: BVALID=1 &amp; BREADY=0</ipxact:description>
                  <ipxact:bitOffset>8</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00</ipxact:value>
                      <ipxact:mask>0xff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>8</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>16</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Cntr_Rst</ipxact:name>
                  <ipxact:displayName>Cntr_Rst</ipxact:displayName>
                  <ipxact:description>Counter ResetWhen set to 1, the corresponding counter will be cleared to 0.</ipxact:description>
                  <ipxact:bitOffset>17</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Edge</ipxact:name>
                  <ipxact:displayName>Edge</ipxact:displayName>
                  <ipxact:description>Edge DetectWhen set to 1, rather than measuring the event in each cycle it is active, the corresponding counter will increment when a 0 to 1 transition (i.e. 
                               rising edge) is detected.When 0, the counter will increment in each cycle that the event is asserted.</ipxact:description>
                  <ipxact:bitOffset>18</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd1</ipxact:name>
                  <ipxact:displayName>rsvd1</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>19</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Frz_On_Ov</ipxact:name>
                  <ipxact:displayName>Frz_On_Ov</ipxact:displayName>
                  <ipxact:description>Freeze on OverflowWhen an overflow is detected from this Counter register, a PMON overflow indication is sent to the global status.This bit will tell the global control whether it should assert the global freeze for all counters in the same domain.</ipxact:description>
                  <ipxact:bitOffset>20</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd2</ipxact:name>
                  <ipxact:displayName>rsvd2</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>21</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x3</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>2</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Invert</ipxact:name>
                  <ipxact:displayName>Invert</ipxact:displayName>
                  <ipxact:description>Invert comparison against Threshold.0 - comparison will be is event increment &gt;= threshold?.1 - comparison is inverted - is event increment &lt; threshold?e.g. 
                               for a 64-entry queue, if SW wanted to know how many cycles the queue had fewer than 4 entries, SW should set the threshold to 4 and set the invert bit to 1.</ipxact:description>
                  <ipxact:bitOffset>23</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>Thresh</ipxact:name>
                  <ipxact:displayName>Thresh</ipxact:displayName>
                  <ipxact:description>Threshold on Counter IncrementThreshold is used, along with the invert bit, to compare against the incoming increment value that will be added to the counter.For events that increment by more than 1 per cycle, if the threshold is set to a value greater than 1, the data register will accumulate instances in which the event increment is &gt;= threshold.e.g. 
                               say you have an event to accumulate the occupancy of a 64-entry queue every cycle. 
                               By setting the threshold value to 60, the data register would count the number of cycles the queues occupancy was &gt;= 60.</ipxact:description>
                  <ipxact:bitOffset>24</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00</ipxact:value>
                      <ipxact:mask>0xff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>8</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
              </ipxact:register>
              <ipxact:register>
                <ipxact:name>PMON_UCCTL_H_0</ipxact:name>
                <ipxact:displayName>PMON_UCCTL_H_0</ipxact:displayName>
                <ipxact:description>Unit Counter Control Register</ipxact:description>
                <ipxact:addressOffset>0x2c</ipxact:addressOffset>
                <ipxact:size>32</ipxact:size>
                <ipxact:access>read-write</ipxact:access>
                <ipxact:field>
                  <ipxact:name>Max</ipxact:name>
                  <ipxact:displayName>Max</ipxact:displayName>
                  <ipxact:description>Compare against counter and replaceWhen set to 1 rather than the counter incrementing by the incoming increment value, it will be compared against the value currently stored in counter. 
                               If it is greater than the value currently stored in the counter, then the counter will be replaced by the max.</ipxact:description>
                  <ipxact:bitOffset>0</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>ID_invert</ipxact:name>
                  <ipxact:displayName>ID_invert</ipxact:displayName>
                  <ipxact:description>Increment on ID mismatchWhen ID enable is !0 and ID invert !0 the counter should only increment if the ID passed on the interface does not match the ID value in UCTRL. 
                               For events that lack correlating IDs they will increment ignoring ID filter.If ID enable is !0 this filter has no effect.</ipxact:description>
                  <ipxact:bitOffset>1</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x0</ipxact:value>
                      <ipxact:mask>0x1</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>1</ipxact:bitWidth>
                  <ipxact:access>read-write</ipxact:access>
                </ipxact:field>
                <ipxact:field>
                  <ipxact:name>rsvd0</ipxact:name>
                  <ipxact:displayName>rsvd0</ipxact:displayName>
                  <ipxact:description>Reserved</ipxact:description>
                  <ipxact:bitOffset>2</ipxact:bitOffset>
                  <ipxact:resets>
                    <ipxact:reset>
                      <ipxact:value>0x00000000</ipxact:value>
                      <ipxact:mask>0x3fffffff</ipxact:mask>
                    </ipxact:reset>
                  </ipxact:resets>
                  <ipxact:bitWidth>30</ipxact:bitWidth>
                  <ipxact:access>read-only</ipxact:access>
                </ipxact:field>
              </ipxact:register>
