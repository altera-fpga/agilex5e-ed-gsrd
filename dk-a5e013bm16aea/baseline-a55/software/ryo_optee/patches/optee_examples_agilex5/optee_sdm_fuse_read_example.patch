diff --git a/optee_examples/sdm_fuse_read/ta/include/sdm_fuse_read_ta.h b/optee_examples/sdm_fuse_read/ta/include/sdm_fuse_read_ta.h
new file mode 100644
index 000000000000..0abd28c28934
--- /dev/null
+++ b/optee_examples/sdm_fuse_read/ta/include/sdm_fuse_read_ta.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_fuse_read TA - public interface shared with the host.
+ *
+ * Simple wrapper around PTA_CMD_SDM_READ_USER_FUSES.  Validates the
+ * caller's output memref (param-types, non-NULL buffer, size, writable
+ * NW memory) and forwards the call to the PTA.
+ */
+
+#ifndef TA_SDM_FUSE_READ_H
+#define TA_SDM_FUSE_READ_H
+
+#include <stdint.h>
+
+/*
+ * UUID for the sdm_fuse_read Trusted Application.
+ * The leading "0f05e000" reads as "0-F-0-5-E" ~= "FOSE" / "FUSE".
+ */
+#define TA_SDM_FUSE_READ_UUID \
+	{ 0x0f05e000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_FUSE_READ_CMD_GET - read all 16 user-defined eFuse words.
+ *
+ * param[0] (out memref)  caller buffer, must be >= SDM_USER_FUSE_SIZE
+ *                        (64 bytes).  On success, filled with 16 x uint32_t
+ *                        and memref.size updated to SDM_USER_FUSE_SIZE.
+ * param[1..3] unused.
+ *
+ * Result:
+ *   TEE_SUCCESS                  - fuses read; param[0].memref.size = 64
+ *   TEE_ERROR_BAD_PARAMETERS     - bad param types / null buffer
+ *   TEE_ERROR_SHORT_BUFFER       - caller buffer < SDM_USER_FUSE_SIZE
+ *   TEE_ERROR_ACCESS_DENIED      - caller buffer not writable
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_FUSE_READ_CMD_GET	0
+
+/*
+ * SDM user-fuse sizing, re-exported from the PTA header (pta_sdm_svc.h)
+ * so NW callers don't need OP-TEE OS internals.  Suppressed when
+ * pta_sdm_svc.h is also visible (TA build) via its include guard.
+ */
+#ifndef __PTA_SDM_SVC_H
+#define SDM_USER_FUSE_COUNT		16U
+#define SDM_USER_FUSE_SIZE		(SDM_USER_FUSE_COUNT * 4U)	/* 64 */
+#endif
+
+#endif /* TA_SDM_FUSE_READ_H */
diff --git a/optee_examples/sdm_fuse_read/ta/sdm_fuse_read_ta.c b/optee_examples/sdm_fuse_read/ta/sdm_fuse_read_ta.c
new file mode 100644
index 000000000000..0a34d3a3b28b
--- /dev/null
+++ b/optee_examples/sdm_fuse_read/ta/sdm_fuse_read_ta.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_fuse_read Trusted Application.
+ *
+ * Simple wrapper around PTA_CMD_SDM_READ_USER_FUSES.  Validates that
+ * the caller passed:
+ *   - the right GP-TEE parameter types,
+ *   - a non-NULL output memref of >= SDM_USER_FUSE_SIZE bytes,
+ *   - and that the NW buffer is genuinely writable for that size,
+ * then forwards the request straight to the PTA.  The PTA fills the
+ * caller's buffer with 16 user-fuse uint32_t words and updates
+ * params[0].memref.size to SDM_USER_FUSE_SIZE (64).
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_fuse_read_ta.h>
+
+struct fuse_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_fuse_read TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_fuse_read TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct fuse_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_fuse_read TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct fuse_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_fuse_read TA: session closed");
+}
+
+static TEE_Result do_fuse_read(struct fuse_sess_ctx *ctx,
+			       uint32_t param_types, TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_MEMREF_OUTPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	void *ns_out = NULL;
+	size_t ns_out_size = 0;
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	ns_out      = params[0].memref.buffer;
+	ns_out_size = params[0].memref.size;
+
+	if (!ns_out) {
+		EMSG("output memref buffer is NULL");
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	if (ns_out_size < SDM_USER_FUSE_SIZE) {
+		EMSG("output memref size %zu < SDM_USER_FUSE_SIZE (%u)",
+		     ns_out_size, SDM_USER_FUSE_SIZE);
+		return TEE_ERROR_SHORT_BUFFER;
+	}
+
+	/*
+	 * Confirm the NW destination buffer is genuinely writable for the
+	 * full size before we hand it to the PTA.  Converts a hypothetical
+	 * "lying memref" into a clean TEE_ERROR_ACCESS_DENIED.
+	 */
+	res = TEE_CheckMemoryAccessRights(TEE_MEMORY_ACCESS_WRITE |
+					  TEE_MEMORY_ACCESS_ANY_OWNER,
+					  ns_out, ns_out_size);
+	if (res != TEE_SUCCESS) {
+		EMSG("output memref not writable: buf=%p size=%zu res=0x%08x",
+		     ns_out, ns_out_size, res);
+		return res;
+	}
+
+	/* Forward directly to the PTA - it handles the TZDRAM bounce + SiP */
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_READ_USER_FUSES, exp_pt,
+				  params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_READ_USER_FUSES failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_fuse_read: returned %zu bytes to NW",
+	     (size_t)params[0].memref.size);
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct fuse_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_FUSE_READ_CMD_GET:
+		return do_fuse_read(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
