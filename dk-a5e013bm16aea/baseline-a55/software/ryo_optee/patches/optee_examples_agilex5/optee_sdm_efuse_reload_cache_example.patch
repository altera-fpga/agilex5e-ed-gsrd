diff --git a/optee_examples/sdm_efuse_reload_cache/host/main.c b/optee_examples/sdm_efuse_reload_cache/host/main.c
new file mode 100644
index 000000000000..9a63d07afb87
--- /dev/null
+++ b/optee_examples/sdm_efuse_reload_cache/host/main.c
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_efuse_reload_cache - Linux host that drives the
+ * sdm_efuse_reload_cache TA.
+ *
+ * Flow:
+ *   host -> sdm_efuse_reload_cache TA -> PTA_SDM_SVC -> ATF
+ *           (ALTERA_SIP_SMC_ASYNC_SDM_EFUSE_RELOAD_CACHE 0x4200016C)
+ *
+ * The SDM re-reads physical eFuse contents into its working cache so
+ * that subsequent fuse / provisioning reads reflect any values burned
+ * (or modified) since the previous reload.  No input is taken and no
+ * data is returned beyond the SDM accept status.
+ *
+ * Usage:
+ *   sdm_efuse_reload_cache
+ *
+ * Exit status:
+ *   0 - SDM accepted the eFuse cache reload
+ *   1 - error
+ */
+
+#include <err.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <tee_client_api.h>
+
+#include <sdm_efuse_reload_cache_ta.h>
+
+int main(int argc, char *argv[])
+{
+	TEEC_Result res = 0;
+	TEEC_Context ctx = { };
+	TEEC_Session sess = { };
+	TEEC_Operation op = { };
+	TEEC_UUID uuid = TA_SDM_EFUSE_RELOAD_CACHE_UUID;
+	uint32_t err_origin = 0;
+	int exit_code = 1;
+
+	if (argc != 1) {
+		fprintf(stderr, "Usage: %s\n\n"
+			"Reload the SDM eFuse cache via OP-TEE TA.\n"
+			"No arguments are taken.\n",
+			argv[0]);
+		return 1;
+	}
+
+	res = TEEC_InitializeContext(NULL, &ctx);
+	if (res != TEEC_SUCCESS)
+		errx(1, "TEEC_InitializeContext: 0x%x", res);
+
+	res = TEEC_OpenSession(&ctx, &sess, &uuid,
+			       TEEC_LOGIN_PUBLIC, NULL, NULL, &err_origin);
+	if (res != TEEC_SUCCESS) {
+		fprintf(stderr, "TEEC_OpenSession: 0x%x (origin 0x%x)\n",
+			res, err_origin);
+		goto out_ctx;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.paramTypes = TEEC_PARAM_TYPES(TEEC_NONE, TEEC_NONE,
+					 TEEC_NONE, TEEC_NONE);
+
+	res = TEEC_InvokeCommand(&sess, TA_SDM_EFUSE_RELOAD_CACHE_CMD_RELOAD,
+				 &op, &err_origin);
+	if (res != TEEC_SUCCESS) {
+		fprintf(stderr,
+			"TA_SDM_EFUSE_RELOAD_CACHE_CMD_RELOAD: 0x%x (origin 0x%x)\n",
+			res, err_origin);
+		goto out_sess;
+	}
+
+	printf("SDM eFuse cache reload: PASS\n");
+	exit_code = 0;
+
+out_sess:
+	TEEC_CloseSession(&sess);
+out_ctx:
+	TEEC_FinalizeContext(&ctx);
+	return exit_code;
+}
