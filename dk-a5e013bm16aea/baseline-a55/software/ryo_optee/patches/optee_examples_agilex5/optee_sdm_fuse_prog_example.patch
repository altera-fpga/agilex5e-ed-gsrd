diff --git a/optee_examples/sdm_fuse_prog/ta/include/sdm_fuse_prog_ta.h b/optee_examples/sdm_fuse_prog/ta/include/sdm_fuse_prog_ta.h
new file mode 100644
index 000000000000..13908ea5caa2
--- /dev/null
+++ b/optee_examples/sdm_fuse_prog/ta/include/sdm_fuse_prog_ta.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_fuse_prog TA - public interface shared with the host.
+ *
+ * Wraps PTA_CMD_SDM_PROG_USER_FUSES with input validation:
+ *   - exactly SDM_USER_FUSE_SIZE (64) bytes (stricter than PTA's `>= 64`),
+ *   - NW source memref readable for the full size,
+ *   - TOC-TOU snapshot into TA-local memory before forwarding to the PTA,
+ *   - zeroize the TA-local snapshot before TEE_Free (fuse values may be
+ *     ownership-bound secrets across both virtual and physical modes),
+ *   - host_flags: only SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE is acted on
+ *     (other bits ignored); reserved param[1].value.b must be 0.
+ *
+ * The host controls whether the operation programs the physical eFuse
+ * (irreversible) or only the SDM cached/virtual state (reversible) via
+ * SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE in param[1].value.a:
+ *
+ *   flag CLEAR (default)                  virtual / cache-only fusing
+ *                                         (test bit set; reversible on
+ *                                         cold reset).
+ *   SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE  permanent physical eFuse burn.
+ *                                         *** IRREVERSIBLE - the 16 words
+ *                                         can never be erased or changed. ***
+ *
+ * The TA emits a `*** WARNING ***` banner on every NON_VOLATILE invocation
+ * and a `***** Virtual *****` banner on every default invocation so the
+ * secure-world log carries a symmetric audit record of every call.
+ */
+
+#ifndef TA_SDM_FUSE_PROG_H
+#define TA_SDM_FUSE_PROG_H
+
+#include <stdint.h>
+
+/*
+ * UUID for the sdm_fuse_prog Trusted Application.
+ * Sequential sibling of sdm_fuse_read (`0f05e000`) - the trailing
+ * `0f05e001` denotes the program/write counterpart of the read TA.
+ */
+#define TA_SDM_FUSE_PROG_UUID \
+	{ 0x0f05e001, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_FUSE_PROG_CMD_SET - program all 16 user-defined eFuse words.
+ *
+ * param[0] (in memref)  caller buffer; must be **exactly** SDM_USER_FUSE_SIZE
+ *                       (64 bytes), 16 x uint32_t values for words 0..15.
+ * param[1] (in value)   .a = host_flags
+ *                              (SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE only)
+ *                       .b = reserved (must be 0)
+ * param[2..3] unused.
+ *
+ * Result:
+ *   TEE_SUCCESS                  - fuses programmed (virtual or physical)
+ *   TEE_ERROR_BAD_PARAMETERS     - bad param types / null / size != 64 /
+ *                                  unknown host_flags / reserved field nonzero
+ *   TEE_ERROR_ACCESS_DENIED      - NW buffer not readable for size bytes
+ *   TEE_ERROR_OUT_OF_MEMORY      - TA-local copy allocation failed
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_FUSE_PROG_CMD_SET	0
+
+/*
+ * SDM user-fuse sizing and host-flags, re-exported from the PTA header
+ * (pta_sdm_svc.h) so NW callers don't need OP-TEE OS internals.  Suppressed
+ * when pta_sdm_svc.h is also visible (TA build) via its include guard.
+ *
+ * SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE is just an alias for the PTA-side
+ * SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE so the bit value stays in lock-step
+ * across the host -> TA -> PTA chain.
+ */
+#ifndef __PTA_SDM_SVC_H
+#define SDM_USER_FUSE_COUNT			16U
+#define SDM_USER_FUSE_SIZE			(SDM_USER_FUSE_COUNT * 4U) /* 64 */
+#define SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE	(1U << 0)
+#endif
+
+/* Host-facing alias — keeps the host source readable. */
+#define SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE	\
+	SDM_USER_FUSES_HOST_FLAG_NON_VOLATILE
+
+#endif /* TA_SDM_FUSE_PROG_H */
diff --git a/optee_examples/sdm_fuse_prog/ta/sdm_fuse_prog_ta.c b/optee_examples/sdm_fuse_prog/ta/sdm_fuse_prog_ta.c
new file mode 100644
index 000000000000..9f9844383a26
--- /dev/null
+++ b/optee_examples/sdm_fuse_prog/ta/sdm_fuse_prog_ta.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_fuse_prog Trusted Application.
+ *
+ * Wraps PTA_CMD_SDM_PROG_USER_FUSES with strict input validation:
+ *
+ *   1. GP-TEE parameter types match (MEMREF_INPUT, VALUE_INPUT, NONE, NONE).
+ *   2. memref.buffer != NULL.
+ *   3. memref.size is *exactly* SDM_USER_FUSE_SIZE (64).  Stricter than
+ *      the PTA, which accepts any size >= 64 and silently uses the
+ *      first 64 bytes - a TA caller that passes the wrong count almost
+ *      certainly has a bug, and we'd rather surface it than ignore it.
+ *   4. The NW source buffer is genuinely readable for those 64 bytes
+ *      (TEE_CheckMemoryAccessRights).
+ *   5. param[1].value.b reserved field is zero; only the NON_VOLATILE bit
+ *      of value.a host_flags is acted on (other bits ignored).
+ *   6. Snapshot the 64 bytes into TA-local memory before forwarding,
+ *      so a malicious NW thread cannot mutate the buffer between our
+ *      validation and the PTA's read (TOC-TOU protection).
+ *   7. Forward the TA-local snapshot + host_flags to
+ *      PTA_CMD_SDM_PROG_USER_FUSES.
+ *   8. Zeroize the snapshot before TEE_Free so the bytes don't linger
+ *      in recycled TA heap pages.
+ *
+ * The host controls fusing mode via SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE
+ * in param[1].value.a (mirroring the prog_pubkey / disable_owned_entry /
+ * security_op convention).  The TA emits a `*** WARNING ***` banner on
+ * every NON_VOLATILE call and a `***** Virtual *****` banner on every
+ * default call so the secure-world log carries a symmetric audit record.
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_fuse_prog_ta.h>
+
+struct fuse_prog_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_fuse_prog TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_fuse_prog TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct fuse_prog_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_fuse_prog TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct fuse_prog_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_fuse_prog TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - validate input, snapshot, forward, wipe
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_fuse_prog(struct fuse_prog_sess_ctx *ctx,
+			       uint32_t param_types, TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_MEMREF_INPUT,
+						TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	void *ns_in = NULL;
+	size_t in_size = 0;
+	void *local_fuses = NULL;
+	uint32_t host_flags = 0;
+	bool non_volatile = false;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	ns_in   = params[0].memref.buffer;
+	in_size = params[0].memref.size;
+
+	if (!ns_in) {
+		EMSG("input memref buffer is NULL");
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	/*
+	 * Be stricter than the PTA: require exactly 64 bytes.  A caller
+	 * that sends a wrong-sized buffer is almost certainly bugged,
+	 * and we'd rather fail loudly than silently program 16 garbage
+	 * words because the buffer wasn't fully populated.
+	 */
+	if (in_size != SDM_USER_FUSE_SIZE) {
+		EMSG("input size %zu != SDM_USER_FUSE_SIZE (%u)",
+		     in_size, SDM_USER_FUSE_SIZE);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	/*
+	 * The reserved field (params[1].value.b) must be zero.  Only the
+	 * NON_VOLATILE bit is meaningful: default (clear) programs the
+	 * virtual / cache-only fuse; setting it requests a permanent eFuse
+	 * burn.  Any other host_flags bits are ignored rather than rejected.
+	 */
+	if (params[1].value.b != 0) {
+		EMSG("reserved param[1].b must be 0 (got 0x%08x)",
+		     params[1].value.b);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+	host_flags = params[1].value.a;
+	non_volatile = (host_flags & SDM_FUSE_PROG_HOST_FLAG_NON_VOLATILE) != 0;
+
+	/*
+	 * Confirm the NW source memref is genuinely readable for the full
+	 * size before we touch any byte through it.  Converts a hypothetical
+	 * "lying memref" condition into a clean TEE_ERROR_ACCESS_DENIED
+	 * instead of a secure-world fault during the copy below.
+	 */
+	res = TEE_CheckMemoryAccessRights(TEE_MEMORY_ACCESS_READ |
+					  TEE_MEMORY_ACCESS_ANY_OWNER,
+					  ns_in, in_size);
+	if (res != TEE_SUCCESS) {
+		EMSG("input memref not readable: buf=%p size=%zu res=0x%08x",
+		     ns_in, in_size, res);
+		return res;
+	}
+
+	/*
+	 * Snapshot the 64 bytes into TA-local memory so the PTA reads from
+	 * a buffer the NW caller cannot mutate in flight (TOC-TOU
+	 * protection).  This matters more for a write op than a read,
+	 * because we're going to actually program these values into the
+	 * SDM mailbox payload.
+	 */
+	local_fuses = TEE_Malloc(in_size, 0);
+	if (!local_fuses) {
+		EMSG("alloc local_fuses (%zu) failed", in_size);
+		return TEE_ERROR_OUT_OF_MEMORY;
+	}
+
+	TEE_MemMove(local_fuses, ns_in, in_size);
+
+	pta_params[0].memref.buffer = local_fuses;
+	pta_params[0].memref.size   = in_size;
+	pta_params[1].value.a       = host_flags;
+	pta_params[1].value.b       = 0;
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_PROG_USER_FUSES, exp_pt,
+				  pta_params, &pta_origin);
+
+	/*
+	 * Wipe the snapshot before returning the heap memory.  Fuse
+	 * values may be ownership-bound secrets in both virtual and
+	 * physical modes — don't let them linger in recycled pages.
+	 */
+	TEE_MemFill(local_fuses, 0, in_size);
+	TEE_Free(local_fuses);
+
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_PROG_USER_FUSES failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_fuse_prog: programmed %u %s fuse words",
+	     SDM_USER_FUSE_COUNT,
+	     non_volatile ? "PHYSICAL (eFuse-burned)" : "virtual");
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct fuse_prog_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_FUSE_PROG_CMD_SET:
+		return do_fuse_prog(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
