+/*
+ * Strict mode blocks any FID that is not on the whitelist.
+ * The whitelist lock is held for the whole check.
+ */
+static bool is_fid_ns_blocked(uint32_t fid)
+{
+	bool blocked = false;
+
+	spin_lock(&g_ns_whitelist_lock);
+
+	if (g_ns_whitelist_active) {
+		blocked = true;
+		for (size_t i = 0U; i < g_ns_whitelist_count; i++) {
+			if (g_ns_whitelist[i] == fid) {
+				blocked = false;
+				break;
+			}
+		}
+	}
+
+	spin_unlock(&g_ns_whitelist_lock);
+	return blocked;
+}
+
+/*
+ * Add a FID to the NS whitelist.
+ * Returns -1 if the FID is not a SiP FID (OEN != 2), table is full, or already present.
+ * Thread-safe.
+ */
+static int sip_ns_whitelist_add(uint32_t fid, size_t *wl_count)
+{
+	int ret = -1;
+	bool sip_fid = (((fid >> 24U) & 0x3FU) == 2U);
+
+	if (!sip_fid) {
+		WARN("NS-FILTER: ADD rejected FID 0x%x - not a SiP FID (OEN=%u, expected 2)\n",
+		     fid, (unsigned int)((fid >> 24U) & 0x3FU));
+	}
+
+	spin_lock(&g_ns_whitelist_lock);
+
+	if (sip_fid && (g_ns_whitelist_count < SIP_NS_WHITELIST_MAX)) {
+		ret = 0;
+		for (size_t i = 0U; i < g_ns_whitelist_count; i++) {
+			if (g_ns_whitelist[i] == fid) {
+				ret = -1;
+				break;
+			}
+		}
+		if (ret == 0)
+			g_ns_whitelist[g_ns_whitelist_count++] = fid;
+	}
+
+	*wl_count = g_ns_whitelist_count;
+	spin_unlock(&g_ns_whitelist_lock);
+	return ret;
+}
+
+/*
+ * Remove a FID from the NS whitelist (block it from NS).
+ * Returns -1 if not found.
+ * Thread-safe.
+ */
+static int sip_ns_whitelist_remove(uint32_t fid, size_t *wl_count)
+{
+	int ret = -1;
+
+	spin_lock(&g_ns_whitelist_lock);
+
+	for (size_t i = 0U; i < g_ns_whitelist_count; i++) {
+		if (g_ns_whitelist[i] == fid) {
+			g_ns_whitelist_count--;
+			for (size_t j = i; j < g_ns_whitelist_count; j++)
+				g_ns_whitelist[j] = g_ns_whitelist[j + 1U];
+			g_ns_whitelist[g_ns_whitelist_count] = 0U;
+			ret = 0;
+			break;
+		}
+	}
+
+	*wl_count = g_ns_whitelist_count;
+	spin_unlock(&g_ns_whitelist_lock);
+	return ret;
+}
+
+/* Empty the whitelist and set strict mode. */
+static void sip_ns_whitelist_reset(bool active)
+{
+	spin_lock(&g_ns_whitelist_lock);
+
+	for (size_t i = 0U; i < g_ns_whitelist_count; i++)
+		g_ns_whitelist[i] = 0U;
+	g_ns_whitelist_count = 0U;
+	g_ns_whitelist_active = active;
+
+	spin_unlock(&g_ns_whitelist_lock);
+}
+
+/* Strict mode, empty list: NS may call only FIDs added afterwards. */
+static void sip_ns_whitelist_clear(void)
+{
+	sip_ns_whitelist_reset(true);
+}
+
+/* Default-permit: NS may call any FID. */
+static void sip_ns_whitelist_deactivate(void)
+{
+	sip_ns_whitelist_reset(false);
+}
