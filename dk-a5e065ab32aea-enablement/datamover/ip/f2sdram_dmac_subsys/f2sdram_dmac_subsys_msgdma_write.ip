   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reset_dispatcher&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to reset the registers and FIFOs of the dispatcher and host modules.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;1&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;1&amp;lt;/msb&amp;gt;
