diff --git a/optee_examples/sdm_disable_owned_entry/ta/include/sdm_disable_owned_entry_ta.h b/optee_examples/sdm_disable_owned_entry/ta/include/sdm_disable_owned_entry_ta.h
new file mode 100644
index 000000000000..554585c91d7c
--- /dev/null
+++ b/optee_examples/sdm_disable_owned_entry/ta/include/sdm_disable_owned_entry_ta.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_disable_owned_entry TA - public interface shared with the host.
+ *
+ * Simple side-effect wrapper around PTA_CMD_SDM_DISABLE_OWNED_ENTRY.
+ *
+ * The SDM receives this command **without any payload**.  Once the
+ * command is accepted in non-volatile mode the device is permanently
+ * locked out of the OWNED life-cycle state - it will refuse every
+ * future owner-root pubkey programming attempt and stay in PRODUCTION
+ * (or the equivalent pre-OWNED state) for the rest of its life.
+ * IRREVERSIBLE.
+ *
+ * Modes:
+ *   default                            virtual / cache-only fusing
+ *                                      (PTA picks SMC x2 = 1; reversible
+ *                                      across reset, useful for SDM
+ *                                      round-trip testing).
+ *   SDM_DEO_HOST_FLAG_NON_VOLATILE     physical eFuse burn
+ *                                      (PTA picks SMC x2 = 0; the
+ *                                      device can NEVER be provisioned
+ *                                      again).
+ */
+
+#ifndef TA_SDM_DISABLE_OWNED_ENTRY_H
+#define TA_SDM_DISABLE_OWNED_ENTRY_H
+
+#include <stdint.h>
+
+/*
+ * TA UUID.  Mnemonic "D0E" = Disable Owned Entry.
+ */
+#define TA_SDM_DISABLE_OWNED_ENTRY_UUID \
+	{ 0xd0e00000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_DISABLE_OWNED_ENTRY_CMD_APPLY - issue the disable-owned-entry
+ * command to the SDM.
+ *
+ * param[0] (in value)
+ *   .a = host control flags (currently only SDM_DEO_HOST_FLAG_NON_VOLATILE).
+ *        Any unknown bit -> TEE_ERROR_BAD_PARAMETERS.
+ *   .b = reserved, must be 0.
+ * param[1..3] unused (must all be TEE_PARAM_TYPE_NONE).
+ *
+ * Result:
+ *   TEE_SUCCESS                  - SDM accepted the request
+ *   TEE_ERROR_BAD_PARAMETERS     - wrong param types, non-zero .b,
+ *                                  or unknown bits in host_flags
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_DISABLE_OWNED_ENTRY_CMD_APPLY	0
+
+/*
+ * Re-exported from pta_sdm_svc.h so NW callers don't need OP-TEE OS
+ * internals.  The guard suppresses redefinition when both headers are
+ * visible to the TA build.
+ */
+#ifndef __PTA_SDM_SVC_H
+#define SDM_DEO_HOST_FLAG_NON_VOLATILE		(1U << 0)
+#define SDM_DEO_HOST_FLAGS_VALID_MASK		SDM_DEO_HOST_FLAG_NON_VOLATILE
+#endif
+
+#endif /* TA_SDM_DISABLE_OWNED_ENTRY_H */
diff --git a/optee_examples/sdm_disable_owned_entry/ta/sdm_disable_owned_entry_ta.c b/optee_examples/sdm_disable_owned_entry/ta/sdm_disable_owned_entry_ta.c
new file mode 100644
index 000000000000..30508cacf627
--- /dev/null
+++ b/optee_examples/sdm_disable_owned_entry/ta/sdm_disable_owned_entry_ta.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_disable_owned_entry Trusted Application.
+ *
+ * Wraps PTA_CMD_SDM_DISABLE_OWNED_ENTRY.  Validation performed:
+ *
+ *   1. Param types match (VALUE_INPUT, NONE, NONE, NONE).
+ *   2. param[0].value.b == 0.
+ *   3. host_flags is within SDM_DEO_HOST_FLAGS_VALID_MASK.
+ *
+ * The SDM does not receive any payload for this command; the PTA owns
+ * the fusing-mode selector (SMC x2) and computes it solely from
+ * host_flags.  This wrapper exists so non-PTA callers can drive the
+ * command via a regular TA UUID (hello_world-style flow) while keeping
+ * the irreversible-burn policy in the trusted layer.
+ *
+ * The TA emits an EMSG audit log for every NON_VOLATILE invocation so
+ * the log captures both the TA and PTA layers separately.
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_disable_owned_entry_ta.h>
+
+struct deo_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_disable_owned_entry TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_disable_owned_entry TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct deo_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_disable_owned_entry TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct deo_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_disable_owned_entry TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - validate then forward
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_disable_owned_entry(struct deo_sess_ctx *ctx,
+					 uint32_t param_types,
+					 TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	/*
+	 * The PTA returns the phase-2 finalize status in params[1], so it
+	 * requires VALUE_OUTPUT there.  This differs from the host-facing
+	 * param types above and must be built separately for the forward.
+	 */
+	const uint32_t pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_VALUE_OUTPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	uint32_t host_flags = 0;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	host_flags = params[0].value.a;
+	if (params[0].value.b != 0) {
+		EMSG("param[0].value.b must be 0 (got 0x%08x)",
+		     params[0].value.b);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+	if (host_flags & ~SDM_DEO_HOST_FLAGS_VALID_MASK) {
+		EMSG("unknown host flag bits 0x%08x", host_flags);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	pta_params[0].value.a = host_flags;
+	pta_params[0].value.b = 0;
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_DISABLE_OWNED_ENTRY, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_DISABLE_OWNED_ENTRY failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_disable_owned_entry: applied (host_flags=0x%08x, phase2_status=0x%08x)",
+	     host_flags, pta_params[1].value.a);
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct deo_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_DISABLE_OWNED_ENTRY_CMD_APPLY:
+		return do_disable_owned_entry(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
