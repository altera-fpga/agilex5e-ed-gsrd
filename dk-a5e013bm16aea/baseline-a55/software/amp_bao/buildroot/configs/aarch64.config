# Buildroot defconfig for Altera Agilex5 userspace (ext4 rootfs).
#
# Produces: output/images/rootfs.ext4
# Does NOT build the kernel — the kernel is built separately by `make linux`.
#
# Usage:
#   make -C <buildroot_dir> defconfig BR2_DEFCONFIG=<path>/aarch64.config
#   make -C <buildroot_dir> -j$(nproc)
#
# To customise interactively:
#   make -C <buildroot_dir> menuconfig
#   make -C <buildroot_dir> savedefconfig BR2_DEFCONFIG=<path>/aarch64.config

# ── Target architecture ───────────────────────────────────────────────────────
BR2_aarch64=y
# Linux runs on Cortex-A76 in linux_freertos; keep Cortex-A55 tuning here as a
# conservative ARMv8.2-A baseline across Agilex5 variants.
BR2_cortex_a55=y

# ── Toolchain ─────────────────────────────────────────────────────────────────
# Use Buildroot's internal glibc toolchain (no external toolchain dependency).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# Kernel headers matching our 6.18 kernel (6.6 series headers are compatible).
BR2_KERNEL_HEADERS_6_6=y

# ── Kernel — do NOT build (we build it with make linux) ───────────────────────
# BR2_LINUX_KERNEL is not set

# ── Root filesystem ───────────────────────────────────────────────────────────
# Produce an ext4 image suitable for dd into SD card partition 2.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# 512 MB gives plenty of room for the Busybox userspace + logs + user data.
# mksdcard.sh will set the SD p2 partition size to match or exceed this.
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"

# Rootfs overlay -- intentionally NOT set here.
#
# Buildroot's Kconfig stores BR2_ROOTFS_OVERLAY as a literal string in
# `.config` and applies only `qstrip` (no `$(VAR)` shell expansion) when
# the rootfs is assembled (see fs/Makefile / system/system.mk in upstream
# Buildroot). So putting `BR2_ROOTFS_OVERLAY="$(HPS_AMP_OVERLAY_DIR)"`
# here results in Buildroot trying to rsync a directory literally named
# `$(HPS_AMP_OVERLAY_DIR)` -- which silently doesn't exist, dropping the
# overlay on the floor.
#
# Instead, the top-level Makefile passes BR2_ROOTFS_OVERLAY=$(ROOTFS_OVERLAY_DIR)
# on Buildroot's build-time make command line, where Make's command-line
# variable precedence overrides the `.config` value. See the `rootfs`
# target in ../../../Makefile for the wiring.

# ── System ────────────────────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="agilex5-bao"
BR2_TARGET_GENERIC_ISSUE="Altera Agilex5 / Bao AMP"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
# Start DHCP on eth0 so the board gets a network address automatically.
BR2_SYSTEM_DHCP="eth0"

# ── Init system ───────────────────────────────────────────────────────────────
BR2_INIT_BUSYBOX=y

# ── Host tools ────────────────────────────────────────────────────────────────
# Explicitly declare host-patchelf so Buildroot builds it before target-finalize
# tries to sanitize RPATH in target ELF binaries.
BR2_PACKAGE_HOST_PATCHELF=y

BR2_PACKAGE_BUSYBOX=y
# Dropbear: lightweight SSH server for remote login / scp.
BR2_PACKAGE_DROPBEAR=y
# iproute2: ip, ss, tc — replaces deprecated net-tools (ifconfig etc.).
BR2_PACKAGE_IPROUTE2=y
# ethtool: read/set Ethernet link parameters.
BR2_PACKAGE_ETHTOOL=y
# usbutils: lsusb — useful for verifying USB passthrough from the Bao guest.
BR2_PACKAGE_USBUTILS=y
# e2fsprogs: fsck.ext4, resize2fs — SD card filesystem maintenance tools.
BR2_PACKAGE_E2FSPROGS=y

# ── ILC interrupt-latency demo / stress tools ─────────────────────────────────
# stress-ng: comprehensive stress tool covering CPU, VM (DRAM), cache,
# hrtimer-interrupt, and I/O scenarios — the primary stress driver for
# the Bao AMP ILC latency customer demonstration.
BR2_PACKAGE_STRESS_NG=y
# iperf3: network bandwidth generator. Running `iperf3 -s` on-board and
# flooding it from an external host exercises all 17 gmac2 GIC SPIs
# (SPI 224-240 / irqid 256-272) — the most direct route to stress the
# GIC distributor that Bao uses to inject the ILC vIRQ into FreeRTOS.
BR2_PACKAGE_IPERF3=y
# memtester: focused DRAM read/write stress; complements stress-ng --vm
# for the memory-bus-contention scenario.
BR2_PACKAGE_MEMTESTER=y
# htop: interactive CPU/IRQ monitor — useful for showing the customer that
# both A76 cores are fully loaded during the stress scenarios.
BR2_PACKAGE_HTOP=y
# rt-tests: provides cyclictest — measures Linux-side wakeup/IRQ latency under
# the noisy neighbor.
BR2_PACKAGE_RT_TESTS=y