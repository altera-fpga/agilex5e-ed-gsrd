+++ b/optee_examples/sdm_security_op/Makefile
@@ -0,0 +1,17 @@
+export V?=0
+
+# If _HOST or _TA specific compilers are not specified, then use CROSS_COMPILE
+HOST_CROSS_COMPILE ?= $(CROSS_COMPILE)
+TA_CROSS_COMPILE   ?= $(CROSS_COMPILE)
+
+.PHONY: all
+all:
+	$(MAKE) -C host CROSS_COMPILE="$(HOST_CROSS_COMPILE)" \
+		TEEC_EXPORT="$(TEEC_EXPORT)" \
+		--no-builtin-variables
+	$(MAKE) -C ta   CROSS_COMPILE="$(TA_CROSS_COMPILE)" LDFLAGS=""
+
+.PHONY: clean
+clean:
+	$(MAKE) -C host clean
+	$(MAKE) -C ta   clean
diff --git a/optee_examples/sdm_security_op/host/Makefile b/optee_examples/sdm_security_op/host/Makefile
new file mode 100644
index 000000000000..407d168fd8ac
--- /dev/null
