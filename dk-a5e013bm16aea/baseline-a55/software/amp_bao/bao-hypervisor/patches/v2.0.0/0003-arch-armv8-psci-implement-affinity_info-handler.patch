From b9300a5c4bee58c842df113dfd783f583d088c85 Mon Sep 17 00:00:00 2001
From: Niravkumar L Rabara <niravkumarlaxmidas.rabara@altera.com>
Date: Fri, 22 May 2026 15:34:26 +0800
Subject: [PATCH] arch/armv8/psci: implement affinity_info handler
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The handler was a TODO stub that always returned 0 (= ON). When a Linux
guest hot-unplugs a secondary CPU it polls PSCI_AFFINITY_INFO for up
to 5 seconds waiting for the target vCPU to report OFF; with the stub
in place the guest always saw ON and printed

    psci: CPU<N> may not have shut down cleanly (AFFINITY_INFO reports 0)
    CPU<N> may not have shut down cleanly: -110

before marking the CPU offline anyway. The bogus warning hides real
bugs and causes confusing user-visible output during hot-unplug.

Implement the handler per ARM DEN 0022D §5.1.4: look up the target
vCPU by MPIDR and return its psci_ctx.state. The numeric values of
Bao's `enum { ON, OFF, ON_PENDING }` already match the PSCI return
values (0/1/2), so the tracked state can be returned directly.

Only affinity level 0 is supported; higher levels would need to
aggregate state across multiple cores in an affinity instance and
none of Bao's current platforms expose multi-core affinity instances
to guests.

Signed-off-by: Niravkumar L Rabara <niravkumarlaxmidas.rabara@altera.com>
---
 src/arch/armv8/psci.c | 41 ++++++++++++++++++++++++++++-------------
 1 file changed, 28 insertions(+), 13 deletions(-)

diff --git a/src/arch/armv8/psci.c b/src/arch/armv8/psci.c
index ea38296..bf41e18 100644
--- a/src/arch/armv8/psci.c
+++ b/src/arch/armv8/psci.c
@@ -138,23 +138,38 @@ static int32_t psci_cpu_on_handler(unsigned long target_cpu, unsigned long entry
 static int32_t psci_affinity_info_handler(unsigned long target_affinity,
     uint32_t lowest_affinity_level)
 {
-    /* return ON, if at least one core in the affinity instance: has been enabled with a call to
-    CPU_ON, and that core has not called CPU_OFF */
-
-    /* return off if all of the cores in the affinity instance have called CPU_OFF and each of
-    these calls has been processed by the PSCI implementation. */
-
-    /*  return ON_PENDING if at least one core in the affinity instance is in the ON_PENDING state
+    /*
+     * Per ARM DEN 0022D (PSCI 1.1) §5.1.4 AFFINITY_INFO:
+     *   0 = ON         (>=1 core in the affinity instance is ON)
+     *   1 = OFF        (all cores have called CPU_OFF, processing complete)
+     *   2 = ON_PENDING (>=1 core is in the ON_PENDING state)
+     *
+     * Bao's psci_state enum happens to use the same numeric values
+     * (ON=0, OFF=1, ON_PENDING=2 in <arch/psci.h>), so we can return the
+     * tracked state directly. Without this, Linux's hot-unplug path waits
+     * up to 5s polling AFFINITY_INFO and logs
+     *   "psci: CPU<N> may not have shut down cleanly (AFFINITY_INFO reports 0)"
+     * before marking the CPU offline.
+     *
+     * We only support affinity level 0 (single core lookup) — higher levels
+     * would need to aggregate state across multiple cores.
      */
+    if (lowest_affinity_level != 0) {
+        return PSCI_E_INVALID_PARAMS;
+    }
 
-    /**
-     * TODO
-     */
+    struct vm* vm = cpu()->vcpu->vm;
+    struct vcpu* target_vcpu = vm_get_vcpu_by_mpidr(vm, target_affinity);
+    if (target_vcpu == NULL) {
+        return PSCI_E_INVALID_PARAMS;
+    }
 
-    UNUSED_ARG(target_affinity);
-    UNUSED_ARG(lowest_affinity_level);
+    int32_t state;
+    spin_lock(&target_vcpu->arch.psci_ctx.lock);
+    state = (int32_t)target_vcpu->arch.psci_ctx.state;
+    spin_unlock(&target_vcpu->arch.psci_ctx.lock);
 
-    return 0;
+    return state;
 }
 
 static int32_t psci_features_handler(uint32_t feature_id)
