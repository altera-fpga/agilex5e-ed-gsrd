          <ipxact:value>bonusData 
{
   element u_clock_bridge
   {
      datum _sortIndex
      {
         value = "0";
         type = "int";
      }
   }
   element u_dmac_config
   {
      datum _sortIndex
      {
         value = "2";
         type = "int";
      }
   }
   element u_msgdma_read
   {
      datum _sortIndex
      {
         value = "4";
         type = "int";
      }
   }
   element u_msgdma_read.csr
   {
      datum baseAddress
      {
         value = "32";
         type = "String";
      }
   }
   element u_msgdma_read.descriptor_slave
   {
      datum baseAddress
      {
         value = "80";
         type = "String";
      }
   }
   element u_msgdma_to_f2sdram
   {
      datum _sortIndex
      {
         value = "3";
         type = "int";
      }
   }
   element u_msgdma_to_ocm
   {
      datum _sortIndex
      {
         value = "6";
         type = "int";
      }
   }
   element u_msgdma_write
   {
      datum _sortIndex
      {
         value = "5";
         type = "int";
      }
   }
   element u_msgdma_write.descriptor_slave
   {
      datum baseAddress
      {
         value = "64";
         type = "String";
      }
   }
   element u_reset_bridge
   {
      datum _sortIndex
      {
         value = "1";
         type = "int";
      }
   }
}
</ipxact:value>
