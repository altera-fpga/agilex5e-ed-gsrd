diff --git a/optee_examples/sdm_ns_allowed_list_deactivate/ta/include/sdm_ns_allowed_list_deactivate_ta.h b/optee_examples/sdm_ns_allowed_list_deactivate/ta/include/sdm_ns_allowed_list_deactivate_ta.h
new file mode 100644
index 000000000000..0c0624f9339b
--- /dev/null
+++ b/optee_examples/sdm_ns_allowed_list_deactivate/ta/include/sdm_ns_allowed_list_deactivate_ta.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_ns_allowed_list_deactivate TA - public interface shared with the host.
+ *
+ * Side-effect-only wrapper around PTA_CMD_SDM_NS_ALLOWED_LIST_DEACTIVATE.
+ *
+ * After a successful call the SDM disables the Non-Secure-world allowed
+ * SiP command whitelist:
+ *   - the NS-FILTER no longer rejects any FID,
+ *   - all SiP SMC FIDs supported by ATF become callable from the
+ *     Non-Secure world (U-Boot, Linux, applications).
+ *
+ * No input is consumed and no data is returned beyond the SDM/ATF accept /
+ * reject status (surfaced as the GP-TEE result code).
+ */
+
+#ifndef TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_H
+#define TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_H
+
+/*
+ * TA UUID.  Mnemonic "DEAC" = DEACtivate (NS allowed list), suffix 0000 to
+ * keep room for future variants while staying in the SDM TA family
+ * suffix (-7b2a-4e5d-9c1a-100c012ec01d).
+ */
+#define TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_UUID \
+	{ 0xdeac0000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_CMD_APPLY - deactivate the NS allowed
+ *                                               SiP command whitelist.
+ *
+ * All four GP-TEE parameters must be TEE_PARAM_TYPE_NONE.
+ *
+ * Result:
+ *   TEE_SUCCESS                  - SDM/ATF accepted; whitelist now off
+ *   TEE_ERROR_BAD_PARAMETERS     - non-NONE parameter types supplied
+ *   TEE_ERROR_BUSY               - SiP reported busy / secure-only
+ *   TEE_ERROR_GENERIC            - forwarded from PTA / ATF
+ */
+#define TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_CMD_APPLY	0
+
+#endif /* TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_H */
diff --git a/optee_examples/sdm_ns_allowed_list_deactivate/ta/sdm_ns_allowed_list_deactivate_ta.c b/optee_examples/sdm_ns_allowed_list_deactivate/ta/sdm_ns_allowed_list_deactivate_ta.c
new file mode 100644
index 000000000000..7a1ffd05ecb0
--- /dev/null
+++ b/optee_examples/sdm_ns_allowed_list_deactivate/ta/sdm_ns_allowed_list_deactivate_ta.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_ns_allowed_list_deactivate Trusted Application.
+ *
+ * Side-effect-only wrapper around PTA_CMD_SDM_NS_ALLOWED_LIST_DEACTIVATE.
+ *
+ * Behaviour:
+ *   After a successful call the SDM disables the Non-Secure-world allowed
+ *   SiP command whitelist (NS-FILTER):
+ *     - the filter no longer rejects any FID,
+ *     - all SiP SMC FIDs supported by ATF become callable from U-Boot,
+ *       Linux, and userspace applications.
+ *
+ *   The state persists for the remainder of the current power cycle; the
+ *   whitelist is re-installed at the next OP-TEE boot by the boot_final()
+ *   hook in optee_os/core/pta/sdm_svc.c.
+ *
+ * Validation performed:
+ *   1. GP-TEE parameter types are all TEE_PARAM_TYPE_NONE.
+ *   2. PTA_SDM_SVC session is open (established at TA_OpenSession).
+ *
+ * No other input is consumed - ATF only needs the function-ID itself.
+ * Forward the call to the PTA verbatim and return its status to the host.
+ */
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_ns_allowed_list_deactivate_ta.h>
+
+struct nsald_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_ns_allowed_list_deactivate TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_ns_allowed_list_deactivate TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct nsald_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_ns_allowed_list_deactivate TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct nsald_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_ns_allowed_list_deactivate TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - forward verbatim to PTA, with audit banner
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_ns_allowed_list_deactivate(struct nsald_sess_ctx *ctx,
+						uint32_t param_types,
+						TEE_Param __unused params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x (expected all NONE)", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_NS_ALLOWED_LIST_DEACTIVATE,
+				  exp_pt, pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_NS_ALLOWED_LIST_DEACTIVATE failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_ns_allowed_list_deactivate: SDM accepted (NS-FILTER off)");
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct nsald_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_NS_ALLOWED_LIST_DEACTIVATE_CMD_APPLY:
+		return do_ns_allowed_list_deactivate(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
