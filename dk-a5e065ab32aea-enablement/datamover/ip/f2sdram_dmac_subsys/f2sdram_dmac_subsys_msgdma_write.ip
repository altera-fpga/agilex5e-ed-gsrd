   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;response_buffer_empty&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set when the response buffer is empty.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;3&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;3&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
