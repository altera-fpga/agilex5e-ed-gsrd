diff --git a/optee_examples/sdm_efuse_reload_cache/ta/include/sdm_efuse_reload_cache_ta.h b/optee_examples/sdm_efuse_reload_cache/ta/include/sdm_efuse_reload_cache_ta.h
new file mode 100644
index 000000000000..32028e38bb08
--- /dev/null
+++ b/optee_examples/sdm_efuse_reload_cache/ta/include/sdm_efuse_reload_cache_ta.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_efuse_reload_cache TA - public interface shared with the host.
+ *
+ * Side-effect-only wrapper around PTA_CMD_SDM_EFUSE_RELOAD_CACHE.
+ * The SDM re-reads physical eFuse contents into its working cache
+ * so that subsequent fuse / provisioning reads reflect any values
+ * burned (or modified) since the previous reload.
+ *
+ * No input is consumed and no data is returned beyond the SDM
+ * accept / reject status (surfaced as the GP-TEE result code).
+ */
+
+#ifndef TA_SDM_EFUSE_RELOAD_CACHE_H
+#define TA_SDM_EFUSE_RELOAD_CACHE_H
+
+/*
+ * TA UUID.  Mnemonic "EFC0" = eFuse Cache, suffix 0000 to keep room
+ * for future cache-related commands while staying in the SDM TA family
+ * suffix (-7b2a-4e5d-9c1a-100c012ec01d).
+ */
+#define TA_SDM_EFUSE_RELOAD_CACHE_UUID \
+	{ 0xefc00000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_EFUSE_RELOAD_CACHE_CMD_RELOAD - reload SDM eFuse cache.
+ *
+ * All four GP-TEE parameters must be TEE_PARAM_TYPE_NONE.
+ *
+ * Result:
+ *   TEE_SUCCESS                  - SDM accepted and reloaded the cache
+ *   TEE_ERROR_BAD_PARAMETERS     - non-NONE parameter types supplied
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_EFUSE_RELOAD_CACHE_CMD_RELOAD	0
+
+#endif /* TA_SDM_EFUSE_RELOAD_CACHE_H */
diff --git a/optee_examples/sdm_efuse_reload_cache/ta/sdm_efuse_reload_cache_ta.c b/optee_examples/sdm_efuse_reload_cache/ta/sdm_efuse_reload_cache_ta.c
new file mode 100644
index 000000000000..e0942fa16418
--- /dev/null
+++ b/optee_examples/sdm_efuse_reload_cache/ta/sdm_efuse_reload_cache_ta.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_efuse_reload_cache Trusted Application.
+ *
+ * Side-effect-only wrapper around PTA_CMD_SDM_EFUSE_RELOAD_CACHE.
+ *
+ * Validation performed:
+ *   1. GP-TEE parameter types are all TEE_PARAM_TYPE_NONE.
+ *   2. PTA_SDM_SVC session is open (established at TA_OpenSession).
+ *
+ * There is no other input to validate - the SDM just receives the
+ * "reload" command, refreshes its working cache from physical eFuse
+ * contents, and returns an accept / reject status.  Forward the call
+ * to the PTA verbatim and return its status to the host.
+ */
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_efuse_reload_cache_ta.h>
+
+struct efuse_reload_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_efuse_reload_cache TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_efuse_reload_cache TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct efuse_reload_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_efuse_reload_cache TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct efuse_reload_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_efuse_reload_cache TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - forward verbatim to PTA
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_reload_cache(struct efuse_reload_sess_ctx *ctx,
+				  uint32_t param_types,
+				  TEE_Param __unused params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x (expected all NONE)", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_EFUSE_RELOAD_CACHE, exp_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_EFUSE_RELOAD_CACHE failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_efuse_reload_cache: SDM cache reloaded");
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct efuse_reload_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_EFUSE_RELOAD_CACHE_CMD_RELOAD:
+		return do_reload_cache(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
