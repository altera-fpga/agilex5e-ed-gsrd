index 000000000000..9fc7feace6cf
--- /dev/null
+++ b/optee_examples/sdm_prog_pubkey/ta/include/sdm_prog_pubkey_ta.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_prog_pubkey TA - public interface shared with the host.
+ *
+ * Wraps PTA_CMD_SDM_PROG_PUBKEY with strict input validation:
+ *
+ *   - hash file is exactly 48 bytes (SHA-384 / secp384r1) **or**
+ *     exactly 32 bytes (SHA-256 / secp256r1) - any other size rejected
+ *     with TEE_ERROR_BAD_PARAMETERS,
+ *   - source buffer is genuinely readable for `size` bytes
+ *     (TEE_CheckMemoryAccessRights),
+ *   - sanity check: all-zero or all-0xFF inputs are rejected (a real
+ *     SHA hash is statistically never these; treat as caller bug),
+ *   - host flag bits are validated against SDM_PUBKEY_HOST_FLAGS_VALID_MASK
+ *     so unknown flags never reach the PTA / SDM,
+ *   - TOC-TOU: snapshot the hash into TA-local memory before forwarding
+ *     to the PTA,
+ *   - zeroize the TA-local snapshot before TEE_Free (hygiene; the hash
+ *     of a public key is not secret but treating it as such defends
+ *     against future code changes).
+ *
+ * hash_type dispatch
+ * ------------------
+ * `PTA_CMD_SDM_PROG_PUBKEY` (in optee_os/core/pta/sdm_svc.c) selects
+ * the SMC `flags` word's hash_type field from the input size:
+ *   - memref.size = SDM_PUBKEY_HASH_SIZE_SHA256 (32) → SECP256R1
+ *   - memref.size = SDM_PUBKEY_HASH_SIZE_SHA384 (48) → SECP384R1
+ * Both paths are now routed end-to-end.
+ *
+ * Default mode is test/cache-only (SDM T bit = 1).  The host opts in
+ * to the irreversible physical eFuse burn by setting
+ * SDM_PUBKEY_HOST_FLAG_NON_VOLATILE in param[1].value.a; the PTA then
+ * clears T (T=0) before submitting the SMC.
+ */
+
+#ifndef TA_SDM_PROG_PUBKEY_H
+#define TA_SDM_PROG_PUBKEY_H
+
+#include <stdint.h>
+
+/*
+ * TA UUID.  Mnemonic "EC384" = elliptic curve / SHA-384 owner-root key
+ * (the only hash currently routed by the PTA).
+ */
+#define TA_SDM_PROG_PUBKEY_UUID \
+	{ 0xec384000, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_PROG_PUBKEY_CMD_SET - program owner-root key hash(es).
+ *
+ * param[0] (in memref)  raw hash bytes.  Either exactly 32 (single
+ *                       SHA-256) or a multiple of 48 (SHA-384) up to
+ *                       SDM_PUBKEY_MAX_HASHES_PER_CALL (5) contiguous
+ *                       hashes, for batched multi-key programming.
+ *                       All-zero / all-0xFF chunks are rejected.
+ * param[1] (in value)
+ *   .a = host control flags
+ *        (currently only SDM_PUBKEY_HOST_FLAG_NON_VOLATILE).
+ *        Any unknown bit -> TEE_ERROR_BAD_PARAMETERS.
+ *   .b = unused (must be 0).
+ * param[2] (out value)  forwarded from PTA:
+ *   .a = SDM response status (0 = accepted, non-zero = SDM error)
+ *   .b = SMC response header word.
+ * param[3] (out value)  forwarded from PTA:
+ *   .a = SDM_PHASE2_STATUS_*
+ *   .b = number of hashes actually submitted to the SDM.
+ *
+ * Result:
+ *   TEE_SUCCESS                  - PTA path completed; inspect param[2]/[3]
+ *   TEE_ERROR_BAD_PARAMETERS     - wrong param types / null / bad size /
+ *                                  unknown flag bit / sentinel buffer
+ *                                  (all-zero or all-0xFF)
+ *   TEE_ERROR_ACCESS_DENIED      - NW source buffer not readable
+ *   TEE_ERROR_OUT_OF_MEMORY      - TA-local snapshot alloc failed
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_PROG_PUBKEY_CMD_SET	0
+
+/*
+ * Valid hash sizes.  Re-exported from pta_sdm_svc.h so NW callers don't
+ * need OP-TEE OS internals; the `__PTA_SDM_SVC_H` guard prevents
+ * redefinition when both headers are visible to the TA.
+ */
+#ifndef __PTA_SDM_SVC_H
+#define SDM_PUBKEY_HASH_SIZE_SHA384	48U
+#define SDM_PUBKEY_HASH_SIZE_SHA256	32U
+#define SDM_PUBKEY_HOST_FLAG_NON_VOLATILE	(1U << 0)
+#define SDM_PUBKEY_HOST_FLAGS_VALID_MASK	SDM_PUBKEY_HOST_FLAG_NON_VOLATILE
+#define SDM_PUBKEY_MAX_HASHES_PER_CALL	5U
+/* param[3].a values, so NW callers can tell a finalized burn from a stuck one */
+#define SDM_PHASE2_STATUS_SUCCESS	0U
+#define SDM_PHASE2_STATUS_NOP		1U
+#define SDM_PHASE2_STATUS_SKIPPED	2U
+#define SDM_PHASE2_STATUS_FAILED	3U
+#else
+/*
+ * pta_sdm_svc.h does not currently expose SDM_PUBKEY_HASH_SIZE_SHA256;
+ * the PTA hardcodes SECP384R1 today.  Define it here so the TA can
+ * validate the 32-byte input case symmetrically.
+ */
+#ifndef SDM_PUBKEY_HASH_SIZE_SHA256
+#define SDM_PUBKEY_HASH_SIZE_SHA256	32U
+#endif
+#ifndef SDM_PUBKEY_MAX_HASHES_PER_CALL
+#define SDM_PUBKEY_MAX_HASHES_PER_CALL	5U
+#endif
+#endif
+
+#endif /* TA_SDM_PROG_PUBKEY_H */
diff --git a/optee_examples/sdm_prog_pubkey/ta/sdm_prog_pubkey_ta.c b/optee_examples/sdm_prog_pubkey/ta/sdm_prog_pubkey_ta.c
new file mode 100644
index 000000000000..eae5148b8533
--- /dev/null
+++ b/optee_examples/sdm_prog_pubkey/ta/sdm_prog_pubkey_ta.c
@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_prog_pubkey Trusted Application.
+ *
+ * Wraps PTA_CMD_SDM_PROG_PUBKEY with strict input validation:
+ *
+ *   1. GP-TEE parameter types match
+ *      (MEMREF_INPUT, VALUE_INPUT, VALUE_OUTPUT, VALUE_OUTPUT).
+ *   2. memref.buffer != NULL.
+ *   3. memref.size is **exactly** 32 (single SHA-256 / secp256r1), OR a
+ *      multiple of 48 (SHA-384 / secp384r1) up to
+ *      SDM_PUBKEY_MAX_HASHES_PER_CALL (5) contiguous hashes, for batched
+ *      multi-key programming.  Any other size is rejected.
+ *   4. NW source memref is genuinely readable for `size` bytes
+ *      (TEE_CheckMemoryAccessRights).
+ *   5. host_flags (param[1].value.a) has only bits within
+ *      SDM_PUBKEY_HOST_FLAGS_VALID_MASK set.  param[1].value.b must be 0.
+ *   6. Sentinel-buffer check: hash is neither all-0x00 nor all-0xFF.
+ *      A real SHA-256/SHA-384 hash is statistically never these patterns
+ *      (~2^-256 / 2^-384), so an all-zero/all-FF input almost certainly
+ *      means the caller passed an uninitialized buffer or wrong file -
+ *      reject loudly rather than program garbage.
+ *   7. Snapshot the hash into TA-local memory before forwarding so a
+ *      malicious NW thread cannot mutate it between our checks and the
+ *      PTA's read (TOC-TOU protection).
+ *   8. Forward to PTA_CMD_SDM_PROG_PUBKEY.  The PTA derives hash_type
+ *      from the input size (32 → SECP256R1, 48 → SECP384R1), so both
+ *      paths are routed without TA-side branching.
+ *   9. Zeroize the snapshot before TEE_Free.  The hash of a public key
+ *      is not secret, but treating it as such defends against future
+ *      code changes (e.g. storing the buffer pointer somewhere else).
+ *
+ * NON_VOLATILE escalation
+ * -----------------------
+ * The host flag SDM_PUBKEY_HOST_FLAG_NON_VOLATILE makes the SDM
+ * permanently burn the owner-root key hash into the physical eFuse -
+ * this is **irreversible**.  The PTA already emits an EMSG audit log;
+ * the TA emits an additional warning so audit trails capture both
+ * layers.
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_prog_pubkey_ta.h>
+
+struct pubkey_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_prog_pubkey TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_prog_pubkey TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct pubkey_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_prog_pubkey TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct pubkey_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_prog_pubkey TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * Helpers
+ * ---------------------------------------------------------------------------
+ */
+
+/* Reject the two cheapest "uninitialized buffer" sentinels: all-0x00,
+ * all-0xFF.  A real SHA-256/384 hash hits one of these only by
+ * astronomical accident (~2^-256 / 2^-384), so they almost certainly
+ * mean a caller bug (forgot to read the file, wrong file, zero-init'd
+ * but never populated).
+ */
+static bool hash_is_sentinel(const uint8_t *buf, size_t size)
+{
+	uint8_t and_all = 0xFF;
+	uint8_t or_all  = 0x00;
+	size_t i = 0;
+
+	for (i = 0; i < size; i++) {
+		and_all &= buf[i];
+		or_all  |= buf[i];
+	}
+	/* all-0x00 -> or_all == 0; all-0xFF -> and_all == 0xFF */
+	return (or_all == 0x00) || (and_all == 0xFF);
+}
+
+/*
+ * validate_multi_hash_size - classify an input buffer as either a single
+ * SHA-256 hash, or a batch of 1..SDM_PUBKEY_MAX_HASHES_PER_CALL contiguous
+ * SHA-384 hashes (as produced by the host when multiple -i files are
+ * concatenated for a single batched PROG_PUBKEY call).
+ *
+ * On success, *unit_size is the size of one hash chunk (32 or 48) and
+ * *hash_count is the number of hashes packed into in_size.
+ */
+static bool validate_multi_hash_size(size_t in_size, size_t *unit_size,
+				     size_t *hash_count)
+{
+	if (in_size == SDM_PUBKEY_HASH_SIZE_SHA256) {
+		*unit_size  = SDM_PUBKEY_HASH_SIZE_SHA256;
+		*hash_count = 1;
+		return true;
+	}
+
+	if (in_size != 0 &&
+	    (in_size % SDM_PUBKEY_HASH_SIZE_SHA384) == 0 &&
+	    (in_size / SDM_PUBKEY_HASH_SIZE_SHA384) <=
+		    SDM_PUBKEY_MAX_HASHES_PER_CALL) {
+		*unit_size  = SDM_PUBKEY_HASH_SIZE_SHA384;
+		*hash_count = in_size / SDM_PUBKEY_HASH_SIZE_SHA384;
+		return true;
+	}
+
+	return false;
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - validate input, snapshot, forward, wipe
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_prog_pubkey(struct pubkey_sess_ctx *ctx,
+				 uint32_t param_types, TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_MEMREF_INPUT,
+						TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_VALUE_OUTPUT,
+						TEE_PARAM_TYPE_VALUE_OUTPUT);
+	void *ns_in = NULL;
+	size_t in_size = 0;
+	size_t unit_size = 0;
+	size_t hash_count = 0;
+	size_t k = 0;
+	uint32_t host_flags = 0;
+	uint8_t *local_hash = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	ns_in   = params[0].memref.buffer;
+	in_size = params[0].memref.size;
+
+	if (!ns_in) {
+		EMSG("input memref buffer is NULL");
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	/*
+	 * Accept either a single SHA-256 hash, or a batch of
+	 * 1..SDM_PUBKEY_MAX_HASHES_PER_CALL contiguous SHA-384 hashes (the
+	 * host concatenates multiple -i files into one buffer for a
+	 * single batched PROG_PUBKEY call).
+	 */
+	if (!validate_multi_hash_size(in_size, &unit_size, &hash_count)) {
+		EMSG("invalid hash size %zu (expected %u=SHA-256, or a "
+		     "multiple of %u=SHA-384 up to %ux)",
+		     in_size, SDM_PUBKEY_HASH_SIZE_SHA256,
+		     SDM_PUBKEY_HASH_SIZE_SHA384,
+		     SDM_PUBKEY_MAX_HASHES_PER_CALL);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	host_flags = params[1].value.a;
+	if (params[1].value.b != 0) {
+		EMSG("param[1].value.b must be 0 (got 0x%08x)",
+		     params[1].value.b);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+	if (host_flags & ~SDM_PUBKEY_HOST_FLAGS_VALID_MASK) {
+		EMSG("unknown host flag bits 0x%08x", host_flags);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	res = TEE_CheckMemoryAccessRights(TEE_MEMORY_ACCESS_READ |
+					  TEE_MEMORY_ACCESS_ANY_OWNER,
+					  ns_in, in_size);
+	if (res != TEE_SUCCESS) {
+		EMSG("input memref not readable: buf=%p size=%zu res=0x%08x",
+		     ns_in, in_size, res);
+		return res;
+	}
+
+	/* Snapshot first, then sanity-check the snapshot (not the NW
+	 * buffer) so the sentinel test cannot be raced. */
+	local_hash = TEE_Malloc(in_size, 0);
+	if (!local_hash) {
+		EMSG("alloc local_hash (%zu) failed", in_size);
+		return TEE_ERROR_OUT_OF_MEMORY;
+	}
+	TEE_MemMove(local_hash, ns_in, in_size);
+
+	/* Every hash chunk in the batch must independently pass the
+	 * sentinel check - one all-0x00/all-0xFF chunk means at least one
+	 * of the host's -i files is bogus, even if the others are fine. */
+	for (k = 0; k < hash_count; k++) {
+		if (hash_is_sentinel(local_hash + k * unit_size, unit_size)) {
+			EMSG("hash #%zu of %zu is all-0x00 or all-0xFF - rejecting",
+			     k + 1, hash_count);
+			res = TEE_ERROR_BAD_PARAMETERS;
+			goto wipe_and_free;
+		}
+	}
+
+	if (host_flags & SDM_PUBKEY_HOST_FLAG_NON_VOLATILE)
+		EMSG("sdm_prog_pubkey TA: NON_VOLATILE requested "
+		     "(hash=%s, count=%zu) - PTA will permanently burn "
+		     "the owner-root key eFuse(s)",
+		     unit_size == SDM_PUBKEY_HASH_SIZE_SHA256 ? "secp256r1"
+							      : "secp384r1",
+		     hash_count);
+	else
+		IMSG("sdm_prog_pubkey TA: ***** Virtual ***** "
+		     "(hash=%s, count=%zu, T=1, cache-only)",
+		     unit_size == SDM_PUBKEY_HASH_SIZE_SHA256 ? "secp256r1"
+							      : "secp384r1",
+		     hash_count);
+
+	pta_params[0].memref.buffer = local_hash;
+	pta_params[0].memref.size   = in_size;
+	pta_params[1].value.a       = host_flags;
+	pta_params[1].value.b       = 0;
+	/* params[2]/[3] populated by PTA */
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_PROG_PUBKEY, exp_pt,
+				  pta_params, &pta_origin);
+
+	/* Always propagate the PTA's response values back to the host -
+	 * even on PTA failure the SDM may have left meaningful status in
+	 * param[2]/[3] (e.g. SDM rejected the hash). */
+	params[2].value.a = pta_params[2].value.a;
+	params[2].value.b = pta_params[2].value.b;
+	params[3].value.a = pta_params[3].value.a;
+	params[3].value.b = pta_params[3].value.b;
+
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_PROG_PUBKEY failed: 0x%08x (origin 0x%x), "
+		     "sdm_resp=0x%08x phase2=0x%08x",
+		     res, pta_origin,
+		     params[2].value.a, params[3].value.a);
+		goto wipe_and_free;
+	}
+
+	DMSG("sdm_prog_pubkey: PTA returned ok (sdm_resp=0x%08x phase2=0x%08x "
+	     "submitted=%u)",
+	     params[2].value.a, params[3].value.a, params[3].value.b);
+
+wipe_and_free:
+	TEE_MemFill(local_hash, 0, in_size);
+	TEE_Free(local_hash);
+	return res;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct pubkey_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_PROG_PUBKEY_CMD_SET:
+		return do_prog_pubkey(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
