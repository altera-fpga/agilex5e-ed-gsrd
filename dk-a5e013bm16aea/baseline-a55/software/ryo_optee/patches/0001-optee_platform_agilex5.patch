diff --git a/core/arch/arm/plat-agilex5/conf.mk b/core/arch/arm/plat-agilex5/conf.mk
new file mode 100644
index 000000000..b0d302271
--- /dev/null
+++ b/core/arch/arm/plat-agilex5/conf.mk
@@ -0,0 +1,45 @@
+PLATFORM_FLAVOR ?= agilex5
+
+# ARM Cortex-A55/A76 cores (4 cores total)
+$(call force,CFG_ARM64_core,y)
+$(call force,CFG_TEE_CORE_NB_CORE,4)
+
+# Memory layout
+# Valid DRAM: 0x80000000-0xEFFFFFFF (1792MB with inline ECC)
+# Service Layer: 0x80000000-0x81FFFFFF (32MB, SDM/mailbox)
+# Linux kernel loads: 0x80080000-0x825FFFFF (~37MB)
+# Place OP-TEE after kernel to avoid overlap: 0x83000000-0x84FFFFFF (32MB)
+CFG_TZDRAM_START ?= 0x83000000
+CFG_TZDRAM_SIZE ?= 0x02000000
+
+# Core heap: default 64KB is too small for max-size SDOS bounce buffers.
+# Max SDOS operation needs ~65KB (32712 src + 32760 dst) plus session overhead.
+CFG_CORE_HEAP_SIZE ?= 0x100000
+
+# Use dynamic shared memory from normal world DRAM
+$(call force,CFG_CORE_RESERVED_SHM,n)
+$(call force,CFG_CORE_DYN_SHM,y)
+
+# Console - 8250 UART
+$(call force,CFG_8250_UART,y)
+CFG_8250_UART_BASE ?= 0x10C02000
+CFG_CONSOLE_UART ?= 0
+
+# GIC
+$(call force,CFG_GIC,y)
+$(call force,CFG_ARM_GICV3,y)
+
+# ATF integration
+$(call force,CFG_WITH_ARM_TRUSTED_FW,y)
+
+# Standard features
+$(call force,CFG_HWSUPP_MEM_PERM_PXN,y)
+$(call force,CFG_SECURE_TIME_SOURCE_CNTPCT,y)
+$(call force,CFG_WITH_STATS,y)
+
+# Disable features we don't have
+CFG_CRYPTO_WITH_CE ?= y
+CFG_WITH_SOFTWARE_PRNG ?= y
+
+# Debug levels: 1=errors only, 2=+info, 3=+debug, 4=+flow.  Use 1 for production.
+CFG_TEE_CORE_LOG_LEVEL ?= 2
diff --git a/core/arch/arm/plat-agilex5/main.c b/core/arch/arm/plat-agilex5/main.c
new file mode 100644
index 000000000..09cb42362
--- /dev/null
+++ b/core/arch/arm/plat-agilex5/main.c
@@ -0,0 +1,231 @@
+#include <console.h>
+#include <crypto/crypto.h>
+#include <drivers/serial8250_uart.h>
+#include <kernel/boot.h>
+#include <kernel/thread_arch.h>
+#include <mm/core_memprot.h>
+#include <platform_config.h>
+#include <string.h>
+#include <tee_api_types.h>
+
+static struct serial8250_uart_data console_data;
+
+register_phys_mem_pgdir(MEM_AREA_IO_NSEC, CONSOLE_UART_BASE,
+			SERIAL8250_UART_REG_SIZE);
+
+/* System Manager — sdm_svc PTA writes SDM stream control and remapper regs */
+register_phys_mem_pgdir(MEM_AREA_IO_NSEC, SYSMGR_BASE, SYSMGR_SIZE);
+
+/* Register non-secure DDR for dynamic shared memory */
+register_ddr(DRAM0_BASE, DRAM0_SIZE);
+
+void plat_console_init(void)
+{
+	serial8250_uart_init(&console_data, CONSOLE_UART_BASE,
+			     CONSOLE_UART_CLK_IN_HZ, CONSOLE_BAUDRATE);
+	register_serial_console(&console_data.chip);
+}
+
+/* ---------------------------------------------------------------------------
+ * SDM Hardware RNG Seeding
+ *
+ * OP-TEE uses a Fortuna software PRNG (CFG_WITH_SOFTWARE_PRNG=y on Agilex5).
+ * Seeding it from the SDM hardware TRNG at startup improves the quality of
+ * all cryptographic operations performed by OP-TEE and its TAs.
+ *
+ * Two seeding points are provided:
+ *   1. plat_get_aslr_seed() — called from assembly (entry_a64.S) before
+ *      core_init_mmu_map() and before plat_console_init().  At this point
+ *      ATF's identity mapping for TZDRAM is in effect (VA == PA), so the
+ *      bounce buffer physical address is computed as (paddr_t)(uintptr_t)buf
+ *      rather than via virt_to_phys().  Using virt_to_phys() here would
+ *      panic: arch_va2pa_helper() (AT S1E1R) succeeds but core_va2pa_helper()
+ *      fails because static_memory_map[] is not populated until
+ *      core_init_mmu_map() runs, causing check_pa_matches_va to abort.
+ *      IMSG is also not available at this stage (console not yet initialised).
+ *   2. sdm_seed_prng_pool() — a driver_init callback that seeds the Fortuna
+ *      entropy pool after the crypto subsystem has been initialized.
+ *
+ * Both functions use direct ATF SiP SMC calls.  The PTA layer is not
+ * available this early in OP-TEE's init sequence.
+ *
+ * If the device has not been provisioned for security the SDM crypto session
+ * open will fail.  In that case an IMSG is emitted and the function returns
+ * gracefully; OP-TEE boots normally using internal entropy only.
+ * ---------------------------------------------------------------------------
+ */
+
+/* ATF SiP SMC function IDs for the async FCS random number service.
+ * These values are defined in the Intel ATF SiP layer and are stable. */
+#define SDM_SEED_SMC_OPEN_CS    UINT32_C(0x4200013A)
+#define SDM_SEED_SMC_CLOSE_CS   UINT32_C(0x4200013B)
+#define SDM_SEED_SMC_RANDOM_EXT UINT32_C(0x4200012D)
+#define SDM_SEED_SMC_RESP_POLL  UINT32_C(0x420000C8)
+#define SDM_SEED_SMC_STATUS_OK  UINT32_C(0)
+#define SDM_SEED_POLL_MAX       10000
+#define SDM_SEED_HDR_BYTES      12U  /* 3-word ATF response header prepended to output */
+#define SDM_SEED_MAX_BYTES      32U  /* hardware entropy bytes to request per call */
+#define SDM_SEED_BOUNCE_SIZE    (SDM_SEED_HDR_BYTES + SDM_SEED_MAX_BYTES)
+
+/* Spin-poll the ATF async response mailbox until the SDM operation completes. */
+static TEE_Result sdm_seed_poll(struct thread_smc_args *out)
+{
+	struct thread_smc_args args = { };
+	int i = 0;
+
+	for (i = 0; i < SDM_SEED_POLL_MAX; i++) {
+		memset(&args, 0, sizeof(args));
+		args.a0 = SDM_SEED_SMC_RESP_POLL;
+		thread_smccc(&args);
+		if ((uint32_t)args.a0 == SDM_SEED_SMC_STATUS_OK)
+			break;
+	}
+
+	if (i == SDM_SEED_POLL_MAX || args.a1 != 0)
+		return TEE_ERROR_GENERIC;
+
+	if (out)
+		*out = args;
+
+	return TEE_SUCCESS;
+}
+
+/*
+ * sdm_get_rng_bytes - request hardware entropy from the SDM TRNG.
+ *
+ * @len:    byte count; must be 4-aligned, at most SDM_SEED_MAX_BYTES
+ * @bounce: caller-supplied buffer of SDM_SEED_HDR_BYTES + len bytes,
+ *          4-byte aligned, located in TZDRAM (stack or heap both work)
+ * @phys:   physical address of @bounce; caller computes this appropriately
+ *          for its execution context (see plat_get_aslr_seed comment above)
+ * @out:    destination for the len random bytes
+ *
+ * Returns TEE_SUCCESS on success.
+ * Returns TEE_ERROR_NOT_SUPPORTED when the crypto session cannot be opened
+ * (device not provisioned for security — caller should log and continue).
+ * Returns TEE_ERROR_GENERIC for other SDM or mailbox errors.
+ */
+static TEE_Result sdm_get_rng_bytes(size_t len, uint8_t *bounce,
+				    paddr_t phys, void *out)
+{
+	struct thread_smc_args args = { };
+	struct thread_smc_args poll_res = { };
+	TEE_Result res = TEE_SUCCESS;
+	uint32_t session_id = 0;
+
+	memset(bounce, 0, SDM_SEED_HDR_BYTES + len);
+	cache_op_inner(DCACHE_AREA_CLEAN, bounce, SDM_SEED_HDR_BYTES + len);
+
+	/* Step 1: open crypto session */
+	memset(&args, 0, sizeof(args));
+	args.a0 = SDM_SEED_SMC_OPEN_CS;
+	thread_smccc(&args);
+	if ((uint32_t)args.a0 != SDM_SEED_SMC_STATUS_OK)
+		return TEE_ERROR_NOT_SUPPORTED;
+
+	res = sdm_seed_poll(&poll_res);
+	if (res != TEE_SUCCESS)
+		goto close;
+
+	session_id = (uint32_t)poll_res.a2;
+
+	/* Step 2: request random bytes; ATF writes them to the bounce buffer */
+	memset(&args, 0, sizeof(args));
+	args.a0 = SDM_SEED_SMC_RANDOM_EXT;
+	args.a2 = session_id;
+	args.a4 = (uint64_t)phys;
+	args.a5 = (uint64_t)len;
+	thread_smccc(&args);
+	if ((uint32_t)args.a0 != SDM_SEED_SMC_STATUS_OK) {
+		res = TEE_ERROR_GENERIC;
+		goto close;
+	}
+
+	res = sdm_seed_poll(NULL);
+	if (res != TEE_SUCCESS)
+		goto close;
+
+	/* Invalidate before reading — ATF wrote via EL3 CPU stores */
+	cache_op_inner(DCACHE_AREA_INVALIDATE, bounce, SDM_SEED_HDR_BYTES + len);
+	memcpy(out, bounce + SDM_SEED_HDR_BYTES, len);
+
+close:
+	{
+		struct thread_smc_args close_args = { };
+
+		close_args.a0 = SDM_SEED_SMC_CLOSE_CS;
+		close_args.a2 = session_id;
+		thread_smccc(&close_args);
+		if ((uint32_t)close_args.a0 == SDM_SEED_SMC_STATUS_OK)
+			sdm_seed_poll(NULL);
+	}
+
+	return res;
+}
+
+/*
+ * plat_get_aslr_seed - provide hardware entropy for OP-TEE core ASLR.
+ *
+ * Called from entry_a64.S assembly before core_init_mmu_map() and before
+ * plat_console_init().  Two constraints apply here that do not apply to the
+ * driver_init path:
+ *
+ *   1. virt_to_phys() must NOT be used.  The OP-TEE software memory map
+ *      (static_memory_map[]) is not populated until core_init_mmu_map()
+ *      returns; calling virt_to_phys() triggers check_pa_matches_va which
+ *      panics when core_va2pa_helper() finds no mapping entry.
+ *      Instead, (paddr_t)(uintptr_t)bounce is used directly: ATF's initial
+ *      TZDRAM identity mapping guarantees VA == PA for the stack.
+ *
+ *   2. IMSG/EMSG must NOT be used.  The serial console driver is not
+ *      initialised until plat_console_init() which runs in a later phase.
+ *      Errors here are silent; the seed simply returns as zero and OP-TEE
+ *      uses its internal entropy for ASLR offset computation.
+ */
+unsigned long plat_get_aslr_seed(void)
+{
+	uint8_t bounce[SDM_SEED_BOUNCE_SIZE] __aligned(4);
+	unsigned long seed = 0;
+	/*
+	 * Use direct cast instead of virt_to_phys(): ATF's initial TZDRAM
+	 * identity mapping guarantees VA == PA for the stack at this point.
+	 * virt_to_phys() would panic because static_memory_map[] is not
+	 * populated yet (core_init_mmu_map() hasn't run).
+	 */
+	paddr_t phys = (paddr_t)(uintptr_t)bounce;
+
+	/* Silent on error — console not available yet; seed remains zero */
+	sdm_get_rng_bytes(sizeof(seed), bounce, phys, &seed);
+	return seed;
+}
+
+/*
+ * sdm_seed_prng_pool - seed the Fortuna software PRNG from the SDM hardware RNG.
+ *
+ * Registered as a driver_init callback so it runs after service_init_crypto
+ * has initialized the Fortuna PRNG.  Entropy seeding is best-effort: this
+ * function always returns TEE_SUCCESS so a failure never halts boot.
+ */
+static TEE_Result sdm_seed_prng_pool(void)
+{
+	uint8_t bounce[SDM_SEED_BOUNCE_SIZE] __aligned(4);
+	uint8_t entropy[SDM_SEED_MAX_BYTES] = { };
+	static unsigned int pnum;
+	TEE_Result res = TEE_SUCCESS;
+
+	res = sdm_get_rng_bytes(SDM_SEED_MAX_BYTES, bounce,
+				virt_to_phys(bounce), entropy);
+	if (res == TEE_SUCCESS) {
+		crypto_rng_add_event(CRYPTO_RNG_SRC_NONSECURE, &pnum,
+				     entropy, sizeof(entropy));
+		memset(entropy, 0, sizeof(entropy));
+		IMSG("SDM hardware RNG: software PRNG seeded with %u bytes of hardware entropy",
+		     SDM_SEED_MAX_BYTES);
+	} else {
+		IMSG("SDM hardware RNG: unavailable, software PRNG uses internal entropy only");
+	}
+
+	return TEE_SUCCESS;
+}
+driver_init(sdm_seed_prng_pool);
+
diff --git a/core/arch/arm/plat-agilex5/platform_config.h b/core/arch/arm/plat-agilex5/platform_config.h
new file mode 100644
index 000000000..b48f3c7d3
--- /dev/null
+++ b/core/arch/arm/plat-agilex5/platform_config.h
@@ -0,0 +1,25 @@
+#ifndef PLATFORM_CONFIG_H
+#define PLATFORM_CONFIG_H
+
+#include <mm/generic_ram_layout.h>
+
+/* UART */
+#define CONSOLE_UART_BASE	0x10C02000
+#define CONSOLE_BAUDRATE	115200
+#define CONSOLE_UART_CLK_IN_HZ	100000000
+
+/* GIC */
+#define GIC_BASE		0x1D000000
+#define GICD_OFFSET		0x0
+#define GICC_OFFSET		0x100000
+
+/* DDR - Non-secure DRAM for dynamic shared memory */
+#define DRAM0_BASE		0x80000000
+#define DRAM0_SIZE		0x70000000  /* 1792MB total DRAM */
+
+/* System Manager (SYSMGR) — needed by sdm_svc PTA for SDM DMA control */
+#define SYSMGR_BASE		0x10D12000
+#define SYSMGR_SIZE		0x1000
+
+#endif /* PLATFORM_CONFIG_H */
+
