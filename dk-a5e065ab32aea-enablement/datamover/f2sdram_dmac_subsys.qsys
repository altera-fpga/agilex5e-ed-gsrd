   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stop_dispatcher&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to stop the mSGDMA in the middle of a transaction.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;0&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reset_dispatcher&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to reset the registers and FIFOs of the dispatcher and host modules.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;1&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;1&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stop_on_error&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to stop the mSGDMA from issuing more read/write commands to the host modules if an error enters the write host module sink port.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;2&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;2&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stop_on_early_termination&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to stop the mSGDMA from issuing more read/write commands to the host modules if an early termination packet is received by write host.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;3&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;3&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;global_interrupt_enable_mask&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to allow interrupts to propagate to the interrupt sender port.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;4&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;4&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;stop_descriptors&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to stop the mSGDMA dispatcher from issuing more descriptors to the read or write hosts.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;5&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;5&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reserved&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Reserved&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;6&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   				&amp;lt;/fields&amp;gt;
   			&amp;lt;/register&amp;gt;
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;dispatcher_read_write_fill_level&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Read and Write Fill Level Register&amp;lt;/displayName&amp;gt;
   				&amp;lt;description&amp;gt;Read and Write Fill Level Register&amp;lt;/description&amp;gt;
   				&amp;lt;addressOffset&amp;gt;0x8&amp;lt;/addressOffset&amp;gt;
   				&amp;lt;size&amp;gt;32&amp;lt;/size&amp;gt;
   				&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   				&amp;lt;resetValue&amp;gt;0x00000000&amp;lt;/resetValue&amp;gt;
   				&amp;lt;resetMask&amp;gt;0xffffffff&amp;lt;/resetMask&amp;gt;
   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;read_fill_level&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Indicates the number of valid descriptor entries in the read command fifo that are yet to be executed.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;15&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;write_fill_level&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Indicates the number of valid descriptor entries in the write command fifo that are yet to be executed.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;16&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   				&amp;lt;/fields&amp;gt;
   			&amp;lt;/register&amp;gt;
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;dispatcher_response_fill_level&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Response Fill Level Register&amp;lt;/displayName&amp;gt;
   				&amp;lt;description&amp;gt;Response Fill Level Register&amp;lt;/description&amp;gt;
   				&amp;lt;addressOffset&amp;gt;0xc&amp;lt;/addressOffset&amp;gt;
   				&amp;lt;size&amp;gt;32&amp;lt;/size&amp;gt;
   				&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   				&amp;lt;resetValue&amp;gt;0x00000000&amp;lt;/resetValue&amp;gt;
   				&amp;lt;resetMask&amp;gt;0xffffffff&amp;lt;/resetMask&amp;gt;
   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;response_fill_level&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Indicates number of valid response entries in the response fifo that are yet to be retrieved. If the Response Port is disabled, this field output is 0.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;15&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reserved&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Reserved&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;16&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   				&amp;lt;/fields&amp;gt;
   			&amp;lt;/register&amp;gt;
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;dispatcher_sequence_number&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Sequence Number Register&amp;lt;/displayName&amp;gt;
   				&amp;lt;description&amp;gt;Sequence Number Register&amp;lt;/description&amp;gt;
   				&amp;lt;addressOffset&amp;gt;0x10&amp;lt;/addressOffset&amp;gt;
   				&amp;lt;size&amp;gt;32&amp;lt;/size&amp;gt;
   				&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   				&amp;lt;resetValue&amp;gt;0x00000000&amp;lt;/resetValue&amp;gt;
   				&amp;lt;resetMask&amp;gt;0xffffffff&amp;lt;/resetMask&amp;gt;
   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;read_sequence_number&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Indicates the sequence number of the next descriptor for the read host to operate on. If the transfer mode is Streaming to Memory-Mapped, this field output is 0. This field is applicable only when Extended Feature Support parameter is enabled.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;15&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;write_sequence_number&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Indicates the sequence number of the next descriptor for the write host to operate on. If the transfer mode is Memory-Mapped to Streaming, this field output is 0. This field is applicable only when Extended Feature Support parameter is enabled.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;16&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
