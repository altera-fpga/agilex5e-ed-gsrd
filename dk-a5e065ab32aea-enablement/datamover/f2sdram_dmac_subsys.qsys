   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reserved&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Reserved&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;10&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
