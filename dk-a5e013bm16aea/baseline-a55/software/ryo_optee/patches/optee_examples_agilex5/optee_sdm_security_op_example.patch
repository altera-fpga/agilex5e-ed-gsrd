diff --git a/optee_examples/sdm_security_op/ta/include/sdm_security_op_ta.h b/optee_examples/sdm_security_op/ta/include/sdm_security_op_ta.h
new file mode 100644
index 000000000000..601bee5b6b6f
--- /dev/null
+++ b/optee_examples/sdm_security_op/ta/include/sdm_security_op_ta.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_security_op TA - public interface shared with the host.
+ *
+ * Wraps PTA_CMD_SDM_SECURITY_OP with strict input validation:
+ *
+ *   1. Param types match exactly
+ *      (VALUE_INPUT, VALUE_INPUT, NONE, NONE).
+ *   2. param[0].value.b and param[1].value.b must be 0.
+ *   3. host_flags has only bits within SDM_SECOPT_HOST_FLAGS_VALID_MASK.
+ *   4. Bit 31 (TEST_MODE) in the option word is stripped before
+ *      validation - the PTA owns it and re-applies it per host_flags.
+ *   5. No reserved bits are set (13..15, 18..30).
+ *   6. At least one defined SDM_SECOPT_* bit is set (empty word
+ *      indicates a caller bug).
+ *   7. Business rule A:
+ *      If SDM_SECOPT_VIRTUAL_EFUSE_DISABLE (bit 4) is set, it must be
+ *      the **only** SDM_SECOPT_* bit in the cleaned option word.
+ *   8. Business rule B:
+ *      If SDM_SECOPT_JTAG_DISABLE (bit 2) is set, then
+ *      SDM_SECOPT_CRC_ENABLE (bit 12) must also be set.
+ *
+ * Bit layout (Agilex5 SDM EFUSE_USER_SECURITY_OPTION mailbox payload):
+ *
+ *   Bit  0 - Firmware Joint Signing
+ *   Bit  1 - AES Key Update Mode (FM/DM only)
+ *   Bit  2 - JTAG Disable                        (requires CRC Enable)
+ *   Bit  3 - HPS Debug Disable
+ *   Bit  4 - eFuse virtual disable               (must be exclusive)
+ *   Bit  5 - HPS Zeroization
+ *   Bit  6 - FPGA Zeroization
+ *   Bit  7 - PUF AES Key disable
+ *   Bit  8 - BBRAM AES Key disable
+ *   Bit  9 - eFuse AES Key disable
+ *   Bit 10 - PUF Enrollment Disable              (value ignored in SM)
+ *   Bit 11 - Secure Clock Only
+ *   Bit 12 - CRC Enable
+ *   Bit 13..15  reserved (must be 0)
+ *   Bit 16 - AliasL1 Disable (FM/DM only)
+ *   Bit 17 - Disable Beta Mode
+ *   Bit 18..30  reserved (must be 0)
+ *   Bit 31 - Test mode                           (PTA-owned, ignored)
+ */
+
+#ifndef TA_SDM_SECURITY_OP_H
+#define TA_SDM_SECURITY_OP_H
+
+#include <stdint.h>
+
+/*
+ * TA UUID.  Mnemonic "SEC-OO-BIT" (Security Option BIT-word).
+ */
+#define TA_SDM_SECURITY_OP_UUID \
+	{ 0x5ec00b17, 0x7b2a, 0x4e5d, \
+		{ 0x9c, 0x1a, 0x10, 0x0c, 0x01, 0x2e, 0xc0, 0x1d } }
+
+/*
+ * TA_SDM_SECURITY_OP_CMD_APPLY - apply the SDM EFUSE user security
+ * option word.
+ *
+ * param[0] (in value)
+ *   .a = 32-bit option word (bitmask of SDM_SECOPT_* bits).
+ *        Bit 31 is ignored - the PTA controls TEST_MODE.
+ *   .b = reserved, must be 0.
+ * param[1] (in value)
+ *   .a = host control flags (currently only
+ *        SDM_SECOPT_HOST_FLAG_NON_VOLATILE).
+ *   .b = reserved, must be 0.
+ * param[2..3] unused.
+ *
+ * Result:
+ *   TEE_SUCCESS                  - SDM accepted the security option
+ *   TEE_ERROR_BAD_PARAMETERS     - param types, reserved bits, empty
+ *                                  option word, or business-rule
+ *                                  violation (bit 4 not exclusive,
+ *                                  or bit 2 set without bit 12)
+ *   TEE_ERROR_GENERIC / BUSY     - forwarded from PTA / ATF / SDM
+ */
+#define TA_SDM_SECURITY_OP_CMD_APPLY	0
+
+/*
+ * SDM_SECOPT_* re-exported from pta_sdm_svc.h so NW callers don't
+ * need OP-TEE OS internals.  The guard prevents redefinition when
+ * both headers are visible (TA build).
+ */
+#ifndef __PTA_SDM_SVC_H
+#define SDM_SECOPT_FIRMWARE_JOINT_SIGNING	(1U << 0)
+#define SDM_SECOPT_AES_KEY_UPDATE_MODE		(1U << 1)
+#define SDM_SECOPT_JTAG_DISABLE			(1U << 2)
+#define SDM_SECOPT_HPS_DEBUG_DISABLE		(1U << 3)
+#define SDM_SECOPT_VIRTUAL_EFUSE_DISABLE	(1U << 4)
+#define SDM_SECOPT_HPS_ZEROIZATION		(1U << 5)
+#define SDM_SECOPT_FPGA_ZEROIZATION		(1U << 6)
+#define SDM_SECOPT_PUF_AES_KEY_DISABLE		(1U << 7)
+#define SDM_SECOPT_BBRAM_AES_KEY_DISABLE	(1U << 8)
+#define SDM_SECOPT_EFUSE_AES_KEY_DISABLE	(1U << 9)
+#define SDM_SECOPT_PUF_ENROLLMENT_DISABLE	(1U << 10)
+#define SDM_SECOPT_SECURE_CLOCK_ONLY		(1U << 11)
+#define SDM_SECOPT_CRC_ENABLE			(1U << 12)
+#define SDM_SECOPT_ALIASL1_DISABLE		(1U << 16)
+#define SDM_SECOPT_DISABLE_BETA_MODE		(1U << 17)
+#define SDM_SECOPT_TEST_MODE			(1U << 31)
+
+#define SDM_SECOPT_VALID_MASK ( \
+	SDM_SECOPT_FIRMWARE_JOINT_SIGNING | \
+	SDM_SECOPT_AES_KEY_UPDATE_MODE    | \
+	SDM_SECOPT_JTAG_DISABLE           | \
+	SDM_SECOPT_HPS_DEBUG_DISABLE      | \
+	SDM_SECOPT_VIRTUAL_EFUSE_DISABLE  | \
+	SDM_SECOPT_HPS_ZEROIZATION        | \
+	SDM_SECOPT_FPGA_ZEROIZATION       | \
+	SDM_SECOPT_PUF_AES_KEY_DISABLE    | \
+	SDM_SECOPT_BBRAM_AES_KEY_DISABLE  | \
+	SDM_SECOPT_EFUSE_AES_KEY_DISABLE  | \
+	SDM_SECOPT_PUF_ENROLLMENT_DISABLE | \
+	SDM_SECOPT_SECURE_CLOCK_ONLY      | \
+	SDM_SECOPT_CRC_ENABLE             | \
+	SDM_SECOPT_ALIASL1_DISABLE        | \
+	SDM_SECOPT_DISABLE_BETA_MODE      | \
+	SDM_SECOPT_TEST_MODE)
+
+#define SDM_SECOPT_HOST_FLAG_NON_VOLATILE	(1U << 0)
+#define SDM_SECOPT_HOST_FLAGS_VALID_MASK	SDM_SECOPT_HOST_FLAG_NON_VOLATILE
+#endif
+
+/*
+ * Mask of legitimate functional bits (TEST_MODE excluded - PTA-owned).
+ * Used by the TA to detect reserved-bit pollution before forwarding
+ * to the PTA.
+ */
+#define SDM_SECOPT_FUNCTIONAL_MASK \
+	(SDM_SECOPT_VALID_MASK & ~SDM_SECOPT_TEST_MODE)
+
+#endif /* TA_SDM_SECURITY_OP_H */
diff --git a/optee_examples/sdm_security_op/ta/sdm_security_op_ta.c b/optee_examples/sdm_security_op/ta/sdm_security_op_ta.c
new file mode 100644
index 000000000000..17674c5b0535
--- /dev/null
+++ b/optee_examples/sdm_security_op/ta/sdm_security_op_ta.c
@@ -0,0 +1,273 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * sdm_security_op Trusted Application.
+ *
+ * Wraps PTA_CMD_SDM_SECURITY_OP with strict input validation:
+ *
+ *   1. Param types match (VALUE_INPUT, VALUE_INPUT, NONE, NONE).
+ *   2. .b fields are 0.
+ *   3. host_flags within SDM_SECOPT_HOST_FLAGS_VALID_MASK.
+ *   4. Strip bit 31 (TEST_MODE) - the PTA owns it.
+ *   5. No reserved bits (13..15, 18..30) set in the cleaned word.
+ *   6. At least one SDM_SECOPT_* bit must be set.
+ *   7. Business rule A: bit 4 (VIRTUAL_EFUSE_DISABLE) is exclusive.
+ *   8. Business rule B: bit 2 (JTAG_DISABLE) requires bit 12 (CRC_ENABLE).
+ *
+ * Forwards the cleaned option word + host_flags to PTA_CMD_SDM_SECURITY_OP
+ * verbatim.  The PTA re-applies TEST_MODE from host_flags so the policy
+ * remains in the trusted layer.
+ */
+
+#include <inttypes.h>
+
+#include <tee_internal_api.h>
+#include <tee_internal_api_extensions.h>
+
+#include <pta_sdm_svc.h>
+#include <sdm_security_op_ta.h>
+
+struct secop_sess_ctx {
+	TEE_TASessionHandle pta_sess;
+};
+
+/* ---------------------------------------------------------------------------
+ * Session lifecycle
+ * ---------------------------------------------------------------------------
+ */
+
+TEE_Result TA_CreateEntryPoint(void)
+{
+	DMSG("sdm_security_op TA: create");
+	return TEE_SUCCESS;
+}
+
+void TA_DestroyEntryPoint(void)
+{
+	DMSG("sdm_security_op TA: destroy");
+}
+
+TEE_Result TA_OpenSessionEntryPoint(uint32_t param_types,
+				    TEE_Param __unused params[4],
+				    void **sess_ctx)
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	const TEE_UUID pta_uuid = PTA_SDM_SVC_UUID;
+	struct secop_sess_ctx *ctx = NULL;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	uint32_t pta_pt = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	ctx = TEE_Malloc(sizeof(*ctx), TEE_MALLOC_FILL_ZERO);
+	if (!ctx)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	res = TEE_OpenTASession(&pta_uuid, TEE_TIMEOUT_INFINITE,
+				TEE_PARAM_TYPES(TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE),
+				pta_params, &ctx->pta_sess, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("TEE_OpenTASession(PTA_SDM_SVC) failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	pta_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_OUTPUT,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE,
+				 TEE_PARAM_TYPE_NONE);
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_GET_VERSION, pta_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_GET_VERSION failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return res;
+	}
+
+	if (pta_params[0].value.a < PTA_SDM_SVC_API_VERSION) {
+		EMSG("PTA API version %u too old (need %u)",
+		     pta_params[0].value.a, PTA_SDM_SVC_API_VERSION);
+		TEE_CloseTASession(ctx->pta_sess);
+		TEE_Free(ctx);
+		return TEE_ERROR_NOT_SUPPORTED;
+	}
+
+	IMSG("sdm_security_op TA: session opened, PTA API v%u",
+	     pta_params[0].value.a);
+	*sess_ctx = ctx;
+	return TEE_SUCCESS;
+}
+
+void TA_CloseSessionEntryPoint(void *sess_ctx)
+{
+	struct secop_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return;
+
+	TEE_CloseTASession(ctx->pta_sess);
+	TEE_Free(ctx);
+	IMSG("sdm_security_op TA: session closed");
+}
+
+/* ---------------------------------------------------------------------------
+ * Input validation - business rules
+ * ---------------------------------------------------------------------------
+ */
+
+/* Returns TEE_SUCCESS if rules pass, else TEE_ERROR_BAD_PARAMETERS. */
+static TEE_Result validate_option_word(uint32_t opt_clean)
+{
+	uint32_t reserved = 0;
+
+	if (opt_clean == 0) {
+		EMSG("empty option word - at least one SDM_SECOPT_* bit "
+		     "must be set");
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	reserved = opt_clean & ~SDM_SECOPT_FUNCTIONAL_MASK;
+	if (reserved) {
+		EMSG("reserved bits set in option word: 0x%08x "
+		     "(allowed mask 0x%08x)",
+		     reserved, SDM_SECOPT_FUNCTIONAL_MASK);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	/*
+	 * Rule A: VIRTUAL_EFUSE_DISABLE (bit 4) must be exclusive.
+	 * If it's set together with anything else, the request is
+	 * inconsistent - reject.
+	 */
+	if ((opt_clean & SDM_SECOPT_VIRTUAL_EFUSE_DISABLE) &&
+	    (opt_clean != SDM_SECOPT_VIRTUAL_EFUSE_DISABLE)) {
+		EMSG("rule A violation: VIRTUAL_EFUSE_DISABLE (bit 4) "
+		     "must be the only option in the command "
+		     "(got 0x%08x, other bits: 0x%08x)",
+		     opt_clean,
+		     opt_clean & ~SDM_SECOPT_VIRTUAL_EFUSE_DISABLE);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	/*
+	 * Rule B: JTAG_DISABLE (bit 2) requires CRC_ENABLE (bit 12).
+	 * Setting JTAG_DISABLE without CRC_ENABLE leaves the bitstream
+	 * integrity check off; the user-supplied design requires both
+	 * to be applied together.
+	 */
+	if ((opt_clean & SDM_SECOPT_JTAG_DISABLE) &&
+	    !(opt_clean & SDM_SECOPT_CRC_ENABLE)) {
+		EMSG("rule B violation: JTAG_DISABLE (bit 2) requires "
+		     "CRC_ENABLE (bit 12); option_word=0x%08x",
+		     opt_clean);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	return TEE_SUCCESS;
+}
+
+/* ---------------------------------------------------------------------------
+ * Main command - validate then forward
+ * ---------------------------------------------------------------------------
+ */
+
+static TEE_Result do_security_op(struct secop_sess_ctx *ctx,
+				 uint32_t param_types, TEE_Param params[4])
+{
+	const uint32_t exp_pt = TEE_PARAM_TYPES(TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_VALUE_INPUT,
+						TEE_PARAM_TYPE_NONE,
+						TEE_PARAM_TYPE_NONE);
+	uint32_t opt_raw = 0;
+	uint32_t opt_clean = 0;
+	uint32_t host_flags = 0;
+	TEE_Param pta_params[4] = { };
+	uint32_t pta_origin = 0;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	if (param_types != exp_pt) {
+		EMSG("bad param types 0x%08x", param_types);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	opt_raw    = params[0].value.a;
+	host_flags = params[1].value.a;
+
+	if (params[0].value.b != 0) {
+		EMSG("param[0].value.b must be 0 (got 0x%08x)",
+		     params[0].value.b);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+	if (params[1].value.b != 0) {
+		EMSG("param[1].value.b must be 0 (got 0x%08x)",
+		     params[1].value.b);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+	if (host_flags & ~SDM_SECOPT_HOST_FLAGS_VALID_MASK) {
+		EMSG("unknown host flag bits 0x%08x", host_flags);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	/* Strip TEST_MODE - PTA owns it.  The cleaned word is what
+	 * the user actually asked for, and what business rules act on. */
+	opt_clean = opt_raw & ~SDM_SECOPT_TEST_MODE;
+
+	res = validate_option_word(opt_clean);
+	if (res != TEE_SUCCESS)
+		return res;
+
+	if (host_flags & SDM_SECOPT_HOST_FLAG_NON_VOLATILE)
+		EMSG("sdm_security_op TA: NON_VOLATILE requested - "
+		     "PTA will permanently burn eFuse bits for "
+		     "option_word=0x%08x",
+		     opt_clean);
+
+	pta_params[0].value.a = opt_clean;
+	pta_params[0].value.b = 0;
+	pta_params[1].value.a = host_flags;
+	pta_params[1].value.b = 0;
+
+	res = TEE_InvokeTACommand(ctx->pta_sess, TEE_TIMEOUT_INFINITE,
+				  PTA_CMD_SDM_SECURITY_OP, exp_pt,
+				  pta_params, &pta_origin);
+	if (res != TEE_SUCCESS) {
+		EMSG("PTA_CMD_SDM_SECURITY_OP failed: 0x%08x (origin 0x%x)",
+		     res, pta_origin);
+		return res;
+	}
+
+	DMSG("sdm_security_op: applied option_word=0x%08x (host_flags=0x%08x)",
+	     opt_clean, host_flags);
+	return TEE_SUCCESS;
+}
+
+TEE_Result TA_InvokeCommandEntryPoint(void *sess_ctx, uint32_t cmd_id,
+				      uint32_t param_types,
+				      TEE_Param params[4])
+{
+	struct secop_sess_ctx *ctx = sess_ctx;
+
+	if (!ctx)
+		return TEE_ERROR_BAD_STATE;
+
+	switch (cmd_id) {
+	case TA_SDM_SECURITY_OP_CMD_APPLY:
+		return do_security_op(ctx, param_types, params);
+	default:
+		return TEE_ERROR_NOT_IMPLEMENTED;
+	}
+}
