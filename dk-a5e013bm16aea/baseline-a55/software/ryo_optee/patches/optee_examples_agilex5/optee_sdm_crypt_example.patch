+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, Intel Corporation
+ *
+ * The name of this file must not be modified - it is included by the
+ * TA dev kit to populate the gpd.ta.* property table for this TA.
+ */
+
+#ifndef USER_TA_HEADER_DEFINES_H
+#define USER_TA_HEADER_DEFINES_H
+
+#include <sdm_crypt_ta.h>
+
+#define TA_UUID			TA_SDM_CRYPT_UUID
+
+#define TA_FLAGS		(TA_FLAG_SINGLE_INSTANCE | \
+				 TA_FLAG_MULTI_SESSION | \
+				 TA_FLAG_INSTANCE_KEEP_ALIVE)
+
+#define TA_STACK_SIZE		(4 * 1024)
+
+/*
+ * Heap large enough to hold the worst-case TOC-TOU input copy:
+ *   decrypt input = SDOS_HDR_SIZE + SDOS_MAX_DATA_LEN + SDOS_HMAC_SIZE
+ *                 = 40 + 32672 + 48 = 32760 bytes
+ * plus normal TEE_Malloc bookkeeping overhead.  128 KB gives ample margin
+ * and matches what other validating TAs in this tree use.
+ */
+#define TA_DATA_SIZE		(128 * 1024)
+
+#define TA_VERSION		"1.0"
+#define TA_DESCRIPTION		"Intel SDM SDOS encrypt/decrypt wrapper TA (PTA_SDM_SVC)"
+
+#define TA_CURRENT_TA_EXT_PROPERTIES \
+	{ "com.intel.optee.examples.sdm_crypt.description", \
+	  USER_TA_PROP_TYPE_STRING, \
+	  "Validates and forwards SDOS encrypt/decrypt to PTA_SDM_SVC" }
+
+#endif /* USER_TA_HEADER_DEFINES_H */
