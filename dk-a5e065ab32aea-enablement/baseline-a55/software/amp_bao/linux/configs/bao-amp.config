# Linux kernel Kconfig fragment — merged on top of the kernel defconfig.
#
# Enables the kernel-side virtio-rpmsg + remoteproc-attach stack used to
# talk to the FreeRTOS VM on A55 core 0 over the 64 KiB shmem at IPA
# 0xC4000000. The custom bao-rproc driver (linux/patches/6.18/)
# plugs into this stack and exposes /dev/rpmsg0 for FreeRTOS output.
#
# Why these symbols:
#   REMOTEPROC      — framework that owns the virtio_device + lifecycle
#                     plumbing. Used in attach-mode only.
#   VIRTIO          — virtio core (transport-independent layer).
#   RPMSG           — rpmsg framework (channel + endpoint abstraction).
#   RPMSG_VIRTIO    — virtio-backed rpmsg (the bao-rproc transport target).
#   RPMSG_CHAR      — userspace /dev/rpmsg* character-device frontend.
CONFIG_REMOTEPROC=y
# Bao inter-VM remoteproc shim (drivers/remoteproc/bao_rproc.c, added by
# linux/patches/6.18/0001-add-bao-rproc-driver.patch).
# Built-in (=y) so the rproc device is registered at boot, ready to
# attach once the OpenAMP-aware peer firmware is in place.
CONFIG_BAO_REMOTEPROC=y
CONFIG_VIRTIO=y
CONFIG_RPMSG=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_RPMSG_CHAR=y
